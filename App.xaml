<Application x:Class="SkyrimCraftingTool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             >
    <Application.Resources>
        <ResourceDictionary>

            <!-- Order matters, and in this direction:
                   1. a palette, supplying the brushes,
                   2. Controls.xaml, whose styles resolve ~330 {DynamicResource ColorX} against them,
                   3. Converters.xaml, needed by the templates below,
                   4. ConditionTemplates.xaml, which uses both the styles and a converter.
                 ThemeService replaces the palette entry in place, which is why it has to be its own
                 dictionary and why every colour reference is DynamicResource rather than Static.

                 The palette merged here only decides how the very first window is painted; the
                 remembered theme is applied by ThemeService right after startup. That is also why
                 the folder-choice dialog is always dark - it opens before AppPrefs exists. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Themes/Dark.xaml"/>
                <ResourceDictionary Source="Styles/Controls.xaml"/>
                <ResourceDictionary Source="Styles/Converters.xaml"/>
                <ResourceDictionary Source="Styles/ConditionTemplates.xaml"/>
                <ResourceDictionary Source="Styles/PresetRecipeTemplate.xaml"/>
                <ResourceDictionary Source="Styles/LeveledListRowTemplate.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Application.Resources>
</Application>
