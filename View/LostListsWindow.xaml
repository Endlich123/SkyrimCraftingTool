<Window x:Class="SkyrimCraftingTool.View.LostListsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Leveled lists that lost entries"
        Width="820" Height="560"
        Background="{DynamicResource ColorBackgroundBase}"
        TextElement.Foreground="{DynamicResource ColorTextPrimary}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Summary}"
                   Foreground="{DynamicResource ColorTextSecondary}"
                   TextWrapping="Wrap" Margin="0,0,0,10"/>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Rows}">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8" Margin="0,0,0,6" CornerRadius="4"
                            Background="{DynamicResource ColorBackgroundControl}">
                        <DockPanel>
                            <!-- Open, not Restore. Putting an entry back is a decision that needs
                                 the list in front of you - what else is in it, and what the mod
                                 that dropped it put there instead. -->
                            <Button DockPanel.Dock="Right" Content="Open" Width="80"
                                    Click="Open_Click"
                                    Style="{StaticResource StandardButtonStyle}"
                                    ToolTip="Open this list to see what it lost and what it still has."/>

                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}"
                                               Foreground="#D8B84A" FontSize="11"
                                               Margin="10,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Display}" FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>

                                <TextBlock Text="{Binding ListKey}"
                                           Foreground="{DynamicResource ColorTextTertiary}"
                                           FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Width="90" IsCancel="True"
                    Style="{StaticResource StandardButtonStyle}"/>
            <TextBlock Text="Most losses first. This is a report, not a defect list - see the note above."
                       Foreground="{DynamicResource ColorTextTertiary}"
                       FontSize="11" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
