<UserControl x:Class="SkyrimCraftingTool.View.PresetsConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SkyrimCraftingTool.ViewModel"
             xmlns:model="clr-namespace:SkyrimCraftingTool.Model"
             xmlns:views="clr-namespace:SkyrimCraftingTool.View"
             xmlns:services="clr-namespace:SkyrimCraftingTool.Services">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="180" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT: Presets tree -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="+ New Preset"
                        views:Tutorial.Id="presets.new"
                        Command="{Binding AddPresetCommand}"
                        Style="{StaticResource ActionButtonGreenStyle}"
                        Margin="0,0,8,0"/>
                <!-- The preset JSON files themselves, to copy, share or back up. -->
                <views:OpenFolderButton FolderPath="{x:Static services:PresetFileStore.PresetsRoot}"
                                        Margin="0"/>
            </StackPanel>

            <TreeView Grid.Row="1"
                      x:Name="PresetsTreeView"
                      views:Tutorial.Id="presets.tree"
                      ItemsSource="{Binding Presets}"
                      SelectedItemChanged="PresetsTreeView_SelectedItemChanged"
                      Background="{DynamicResource ColorBackgroundBase}">

                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{x:Null}">
                        <Setter Property="Padding" Value="2" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </TreeView.ItemContainerStyle>

                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type local:PresetNodeVM}" ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding PresetName}" FontWeight="Bold" Foreground="{DynamicResource ColorTreeRoot}" IsHitTestVisible="False" />
                    </HierarchicalDataTemplate>

                    <HierarchicalDataTemplate DataType="{x:Type local:PresetBranchNodeVM}" ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource ColorTreeBranch}" IsHitTestVisible="False" />

                        <!-- Container style for this branch's children (the slot/type leaves):
                             clicks get intercepted here directly (Ctrl/Shift multi-select) instead
                             of going through TreeView.SelectedItem - see
                             PresetsConfigVM.HandleSlotNodeClick. Preset-root and branch nodes keep
                             normal single-select behavior. Mirrors MainContentView's item level. -->
                        <HierarchicalDataTemplate.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{x:Null}">
                                <Setter Property="Padding" Value="2" />
                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="SlotNode_PreviewMouseLeftButtonDown"/>
                            </Style>
                        </HierarchicalDataTemplate.ItemContainerStyle>
                    </HierarchicalDataTemplate>

                    <DataTemplate DataType="{x:Type local:PresetSlotNodeVM}">
                        <Border x:Name="SlotHighlight" Background="Transparent" Padding="2,0">
                            <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource ColorTreeLeaf}" IsHitTestVisible="False" />
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="SlotHighlight" Property="Background"
                                        Value="{DynamicResource ColorBackgroundHighlight}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </TreeView.Resources>
            </TreeView>
        </Grid>

        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{DynamicResource ColorDivider}" />

        <!-- RIGHT: Detail -->
        <Grid Grid.Column="2" Margin="10,0,0,0">
            <ContentPresenter Content="{Binding SelectedNode}">
                <ContentPresenter.Resources>

                    <!-- Preset root: rename + delete -->
                    <DataTemplate DataType="{x:Type local:PresetNodeVM}">
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Preset" Style="{StaticResource TitelStyle}"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Name:" Style="{StaticResource ItemLabelStyle}"/>
                                <!-- Commits on LostFocus as before, and now also on Enter and through the
                                     "Save name" button - see PresetNodeVM.SaveNameCommand. -->
                                <TextBox Grid.Column="1" x:Name="PresetNameBox"
                                         Text="{Binding PresetName}" Style="{StaticResource ItemTextBoxStyle}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter"
                                                    Command="{Binding SaveNameCommand}"
                                                    CommandParameter="{Binding Text, ElementName=PresetNameBox}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                <Button Content="Save name"
                                        Command="{Binding SaveNameCommand}"
                                        CommandParameter="{Binding Text, ElementName=PresetNameBox}"
                                        Style="{StaticResource ActionButtonGreenStyle}"
                                        Margin="0,0,8,0"
                                        ToolTip="Renames the preset to what is in the box. Enter does the same."/>
                                <Button Content="delete Preset"
                                        Margin="0,0,8,0"
                                        Command="{Binding DeleteCommand}"
                                        Style="{StaticResource ActionButtonStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>

                    <!-- Armor/Weapon branch: placeholder -->
                    <DataTemplate DataType="{x:Type local:PresetBranchNodeVM}">
                        <TextBlock Text="Choose a Slot or Weapon Type from the list on the left."
                                   Foreground="{DynamicResource ColorTextSecondary}"
                                   Margin="0,10,0,0"/>
                    </DataTemplate>

                    <!-- Slot / WeaponType node: the big editor -->
                    <DataTemplate DataType="{x:Type local:PresetSlotNodeVM}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource TitelStyle}" Margin="0,0,0,10"/>

                                <!-- Base + Armor/Weapon specific values -->
                                <GroupBox Style="{StaticResource DarkGroupBoxStyle}" Margin="0,0,0,15" Padding="10" views:Tutorial.Id="presets.values">
                                    <GroupBox.Header>
                                        <TextBlock Text="Values" Style="{StaticResource TitelStyle}"/>
                                    </GroupBox.Header>
                                    <StackPanel>

                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding WeightEnabled}" Style="{StaticResource ItemCheckBoxStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="Weight:" Style="{StaticResource ItemLabelStyle}"/>
                                            <TextBox Grid.Column="2" Text="{Binding Weight}" IsEnabled="{Binding WeightEnabled}" model:NumericTextBoxBehavior.Mode="Decimal" Style="{StaticResource ItemTextBoxStyle}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding ValueEnabled}" Style="{StaticResource ItemCheckBoxStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="Cost:" Style="{StaticResource ItemLabelStyle}"/>
                                            <TextBox Grid.Column="2" Text="{Binding Value}" IsEnabled="{Binding ValueEnabled}" model:NumericTextBoxBehavior.Mode="Integer" Style="{StaticResource ItemTextBoxStyle}"/>
                                        </Grid>

                                        <!-- ARMOR -->
                                        <StackPanel Visibility="{Binding IsArmor, Converter={StaticResource BoolToVis}}">
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding ArmorRatingEnabled}" Style="{StaticResource ItemCheckBoxStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="1" Text="Armor Rating:" Style="{StaticResource ItemLabelStyle}"/>
                                                <TextBox Grid.Column="2" Text="{Binding ArmorRating}" IsEnabled="{Binding ArmorRatingEnabled}" model:NumericTextBoxBehavior.Mode="Decimal" Style="{StaticResource ItemTextBoxStyle}"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- WEAPON -->
                                        <StackPanel Visibility="{Binding IsWeapon, Converter={StaticResource BoolToVis}}">
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding DamageEnabled}" Style="{StaticResource ItemCheckBoxStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="1" Text="Damage:" Style="{StaticResource ItemLabelStyle}"/>
                                                <TextBox Grid.Column="2" Text="{Binding Damage}" IsEnabled="{Binding DamageEnabled}" model:NumericTextBoxBehavior.Mode="Integer" Style="{StaticResource ItemTextBoxStyle}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding SpeedEnabled}" Style="{StaticResource ItemCheckBoxStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="1" Text="Speed:" Style="{StaticResource ItemLabelStyle}"/>
                                                <TextBox Grid.Column="2" Text="{Binding Speed}" IsEnabled="{Binding SpeedEnabled}" model:NumericTextBoxBehavior.Mode="Decimal" model:NumericTextBoxBehavior.Max="10" Style="{StaticResource ItemTextBoxStyle}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding ReachEnabled}" Style="{StaticResource ItemCheckBoxStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="1" Text="Reach:" Style="{StaticResource ItemLabelStyle}"/>
                                                <TextBox Grid.Column="2" Text="{Binding Reach}" IsEnabled="{Binding ReachEnabled}" model:NumericTextBoxBehavior.Mode="Decimal" model:NumericTextBoxBehavior.Max="10" Style="{StaticResource ItemTextBoxStyle}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding StaggerEnabled}" Style="{StaticResource ItemCheckBoxStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="1" Text="Stagger:" Style="{StaticResource ItemLabelStyle}"/>
                                                <TextBox Grid.Column="2" Text="{Binding Stagger}" IsEnabled="{Binding StaggerEnabled}" model:NumericTextBoxBehavior.Mode="Decimal" model:NumericTextBoxBehavior.Max="10" Style="{StaticResource ItemTextBoxStyle}"/>
                                            </Grid>
                                        </StackPanel>

                                    </StackPanel>
                                </GroupBox>

                                <!-- Keywords -->
                                <Expander Style="{StaticResource DarkExpanderStyle}" Header="Keywords" IsExpanded="False" views:Tutorial.Id="presets.keywords">
                                    <StackPanel>
                                        <CheckBox Content="Include Keywords" IsChecked="{Binding KeywordsEnabled}" Style="{StaticResource ItemCheckBoxStyle}" Margin="0,10,0,5"/>

                                        <Grid Margin="0,0,5,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Search:" Style="{StaticResource ItemLabelStyle}"/>
                                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ItemTextSearchBoxStyle}"/>
                                            <CheckBox Grid.Column="2" Style="{StaticResource ItemCheckBoxStyle}" Content="All Keywords (Expert)" IsChecked="{Binding ShowAllKeywords}" Margin="0,0,0,5"/>
                                        </Grid>

                                        <GroupBox Style="{StaticResource DarkGroupBoxStyle}" Margin="0,10,0,10" Padding="10">
                                            <GroupBox.Header>
                                                <TextBlock Text="Selected Keywords" Style="{StaticResource TitelStyle}"/>
                                            </GroupBox.Header>
                                            <ItemsControl ItemsSource="{Binding SelectedKeywordsView}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="4" Padding="5" Margin="3"
                                                                Background="{Binding IsSelected, Converter={StaticResource BoolToBrushConverter}}">
                                                            <Border.InputBindings>
                                                                <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleSelectedCommand}" />
                                                            </Border.InputBindings>
                                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ColorChipText}" TextTrimming="CharacterEllipsis"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </GroupBox>

                                        <GroupBox Style="{StaticResource DarkGroupBoxStyle}" Padding="10">
                                            <GroupBox.Header>
                                                <TextBlock Text="Keywords" Style="{StaticResource TitelStyle}"/>
                                            </GroupBox.Header>
                                            <!-- Lean, shared keyword chips: Styles/KeywordChips.xaml (docs/Performance-Plan.md, P-P4). -->
                                            <ItemsControl ItemsSource="{Binding FilteredKeywordsView}" Style="{StaticResource KeywordChipListStyle}"/>
                                        </GroupBox>
                                    </StackPanel>
                                </Expander>

                                <!-- Crafting Recipe -->
                                <Expander Style="{StaticResource DarkExpanderStyle}" Header="Crafting Recipe" IsExpanded="False" views:Tutorial.Id="presets.crafting">
                                    <ContentControl Content="{Binding CraftRecipe}"/>
                                </Expander>

                                <!-- Temper Recipe -->
                                <Expander Style="{StaticResource DarkExpanderStyle}" Header="Temper Recipe" IsExpanded="False">
                                    <ContentControl Content="{Binding TemperRecipe}"/>
                                </Expander>

                                <!-- Breakdown Recipe: the same editor, read the other way round -
                                     the material list is what the recipe PRODUCES, capped at one
                                     entry, and the workbench picker offers only the two breakdown
                                     benches. -->
                                <Expander Style="{StaticResource DarkExpanderStyle}" Header="Breakdown Recipe" IsExpanded="False">
                                    <ContentControl Content="{Binding BreakdownRecipe}"/>
                                </Expander>

                                <!-- Container -->
                                <Expander Style="{StaticResource DarkExpanderStyle}" Header="Container" IsExpanded="False" views:Tutorial.Id="presets.container">
                                    <StackPanel Margin="0,10,0,0">
                                        <CheckBox Content="Include Container" IsChecked="{Binding ContainerEnabled}" Style="{StaticResource ItemCheckBoxStyle}" Margin="0,0,0,10"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="3*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- LEFT: catalog -->
                                            <StackPanel Grid.Column="0">
                                                <TextBox Text="{Binding ContainerSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource ItemTextSearchBoxStyle}"
                                                         Margin="0,0,0,6"/>

                                                <Button Content="{Binding ShowExpertContainers, Converter={StaticResource BoolToExpertTextConverter}}"
                                                        Command="{Binding ToggleExpertContainersCommand}"
                                                        Style="{StaticResource StandardButtonStyle}"
                                                        Margin="0,0,0,10"/>

                                                <TextBlock Text="Containers" Style="{StaticResource ItemLabelStyle}" Margin="0,0,0,6"/>

                                                <ScrollViewer Height="180" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding FilteredContainers}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Padding="6" Margin="0,0,0,6" Background="{DynamicResource ColorBackgroundControl}" CornerRadius="4">
                                                                    <DockPanel>
                                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ColorTextPrimary}" VerticalAlignment="Center"/>
                                                                        <Button Width="70"
                                                                                HorizontalAlignment="Right"
                                                                                Style="{StaticResource StandardButtonStyle}"
                                                                                Command="{Binding DataContext.ToggleContainerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                CommandParameter="{Binding ContainerKey}"
                                                                                Content="{Binding IsSelected, Converter={StaticResource BoolToSelectTextConverter}}"/>
                                                                    </DockPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>

                                            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="{DynamicResource ColorDivider}"/>

                                            <!-- RIGHT: selected -->
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Selected Containers" Style="{StaticResource ItemLabelStyle}" Margin="0,0,0,6"/>

                                                <!-- Same note as the item editor: the sliders are the switch between the
                                                     two placement kinds, and they behave very differently in game. -->
                                                <TextBlock Text="Leave every slider at 0 and the item is placed in the container itself - permanently, and it will be there. Raise a slider and it goes into that leveled list instead: from that level on it can turn up when the merchant restocks (vanilla: about every 48 h), by chance rather than guaranteed."
                                                           Foreground="{DynamicResource ColorTextTertiary}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,8"/>

                                                <ItemsControl ItemsSource="{Binding ContainerSelection.SelectedContainers}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Padding="8" Margin="0,0,0,8" Background="{DynamicResource ColorBackgroundControl}" CornerRadius="4">
                                                                <StackPanel>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{DynamicResource ColorTextPrimary}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                                        <Button Grid.Column="1" Content="Remove" Style="{StaticResource StandardButtonStyle}" Command="{Binding ToggleSelectedCommand}" Margin="8,0,0,0"/>
                                                                    </Grid>

                                                                    <!-- Rows come from Styles/LeveledListRowTemplate.xaml - shared by all four views that
                                                                         show a container's leveled lists, so a change to the row cannot reach only one. -->
                                                                    <ItemsControl ItemsSource="{Binding LVLiEntries}"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Button Content="Clear Selection" Width="120" HorizontalAlignment="Right"
                                                        Style="{StaticResource StandardButtonStyle}"
                                                        Command="{Binding ClearContainerSelectionCommand}"
                                                        Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Expander>

                                <!-- Enchantment. Here and not in the bulk editor: ten patched items
                                     rarely want the same enchantment, but a preset for legendary
                                     end-game items is exactly where that sameness is the point. -->
                                <Expander Style="{StaticResource DarkExpanderStyle}" Header="Enchantment" IsExpanded="False" views:Tutorial.Id="presets.enchantment">
                                    <StackPanel Margin="0,10,0,0">
                                        <CheckBox Content="Include Enchantment" IsChecked="{Binding EnchantmentEnabled}" Style="{StaticResource ItemCheckBoxStyle}" Margin="0,0,0,10"/>

                                        <TextBlock Text="Enchantment" Style="{StaticResource ItemLabelStyle}" Margin="0,0,0,6"/>

                                        <!-- Editable and filtering as you type, same box as the item
                                             detail view: 632 entries are not a list anyone scrolls.
                                             IsTextSearchEnabled off, because the Text here is the
                                             SEARCH string - WPF's own type-ahead would fight it. -->
                                        <ComboBox ItemsSource="{Binding FilteredEnchantments}"
                                                  SelectedItem="{Binding SelectedEnchantment, Mode=TwoWay}"
                                                  Text="{Binding EnchantmentSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True"
                                                  IsTextSearchEnabled="False"
                                                  IsSynchronizedWithCurrentItem="False"
                                                  StaysOpenOnEdit="True"
                                                  TextSearch.TextPath="Name"
                                                  DisplayMemberPath="Name"
                                                  Style="{StaticResource ItemComboBoxStyle}"
                                                  ToolTip="Which enchantment matching items get. Pick &quot;(no enchantment)&quot; with the box ticked to strip one instead."/>

                                        <!-- The item's own charge pool (EAMT), right under the
                                             picker because the two are one thing in use: the box
                                             above says WHICH effect, this says how much charge the
                                             item can hold. With an effect and no charge there is no
                                             maximum and the item cannot be recharged. Its own
                                             include switch, so a preset can raise the charge of
                                             items that keep their own enchantment. -->
                                        <CheckBox Content="Include Charge" IsChecked="{Binding EnchantmentAmountEnabled}" Style="{StaticResource ItemCheckBoxStyle}" Margin="0,10,0,10"/>

                                        <TextBlock Text="Charge:" Style="{StaticResource ItemLabelStyle}" Margin="0,0,0,6"/>

                                        <TextBox Text="{Binding EnchantmentAmount}"
                                                 IsEnabled="{Binding EnchantmentAmountEnabled}"
                                                 model:NumericTextBoxBehavior.Mode="Integer"
                                                 Style="{StaticResource ItemTextBoxStyle}"
                                                 ToolTip="How much enchantment charge matching items can hold. The item's own field, not the enchantment's - 0 is what every unenchanted item carries."/>
                                    </StackPanel>
                                </Expander>

                            </StackPanel>
                        </ScrollViewer>
                    </DataTemplate>


                </ContentPresenter.Resources>
            </ContentPresenter>

            <!-- Bulk editor for a multi-selection of slot/type nodes. The Border carries the
                 Visibility (bound against PresetsConfigVM); DataContext only switches to
                 MultiSelectVM on the child - otherwise IsMultiSelectActive would resolve against
                 PresetMultiSelectVM. Same pattern as MainContentView's MultiSelectDetailView. -->
            <Border Visibility="{Binding IsMultiSelectActive, Converter={StaticResource BoolToVis}}">
                <views:PresetMultiSelectView DataContext="{Binding MultiSelectVM}"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
