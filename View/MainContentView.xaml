<UserControl x:Class="SkyrimCraftingTool.View.MainContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SkyrimCraftingTool.ViewModel"
             xmlns:model="clr-namespace:SkyrimCraftingTool.Model"
             xmlns:views="clr-namespace:SkyrimCraftingTool.View"
             Loaded="MainContentView_Loaded">

    <DockPanel LastChildFill="True">

        <!-- Top toolbar: global actions -->
        <StackPanel Orientation="Horizontal"
                    DockPanel.Dock="Top"
                    Margin="6,6,6,4">
            <Button Content="Scan/Rescan"
                    Command="{Binding ScanModsCommand}"
                    Style="{StaticResource ActionButtonGreenStyle}"/>
            <Button Content="Export"
                    Command="{Binding ExportAllCommand}"
                    Style="{StaticResource ActionButtonStyle}"/>
            <Button Content="Import"
                    Command="{Binding ImportAllCommand}"
                    Style="{StaticResource ActionButtonWarmStyle}"/>

            <!-- "Generate Patch" and its two options used to sit here. They are app-wide (armor,
                 weapons, recipes, enchantments, form lists), not item-view actions, so they now live
                 in the shell toolbar next to the nav tabs - see MainWindow.xaml. The command itself
                 stays on MainContentVM, which owns the services and the autosave flush. -->

            <Button Content="{Binding OrphanedEditCount, StringFormat=⚠ Orphaned edits ({0})}"
                    Command="{Binding ManageOrphanedEditsCommand}"
                    Style="{StaticResource ActionButtonWarmStyle}"
                    Margin="14,0,0,5"
                    Visibility="{Binding HasOrphanedEdits, Converter={StaticResource BoolToVis}}"
                    ToolTip="Items you edited whose plugin left the load order. Review and delete the stale edits."/>
        </StackPanel>

        <Grid Margin="10,4,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="150" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: Tree + Search -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Tree filters -->
                <!-- WrapPanel: the column is draggable down to 150, where a stack would simply cut
                     off the plugin count. Same row in EnchantmentMenuView wraps for the same reason. -->
                <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                    <!-- Gaps as RIGHT margins on the preceding element, never as left margins on
                         the following one: in a WrapPanel a left margin survives the line break and
                         indents whatever moved down by exactly that much. -->
                    <CheckBox Content="Only edited"
                              IsChecked="{Binding ShowOnlyEditedItems}"
                              Foreground="{DynamicResource ColorTextPrimary}"
                              VerticalAlignment="Center"
                              Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding EditedItemCount, StringFormat=({0} edited)}"
                               Foreground="{DynamicResource ColorTextSecondary}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding FilteredTree.Count, StringFormat=· {0} plugins}"
                               Foreground="{DynamicResource ColorTextTertiary}"
                               VerticalAlignment="Center"/>
                </WrapPanel>

                <!-- Search -->
                <TextBox Grid.Row="1"
                         Text="{Binding TreeSearchText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Search Plugin/Item..."
                         Background="{DynamicResource ColorBackgroundControl}"
                         Foreground="{DynamicResource ColorTextPrimary}"
                         BorderBrush="{DynamicResource ColorBorder}"
                         Padding="5"
                         Margin="0,0,0,5" />

                <!-- Expand / Collapse -->
                <UniformGrid Grid.Row="2"
                             Columns="1"
                             Margin="0,0,0,5">
                    <Button Content="Collapse all [-]"
                            Command="{Binding CollapseAllCommand}"
                            Margin="0,0,2,0"
                            Background="{DynamicResource ColorBackgroundHighlight}"
                            Foreground="{DynamicResource ColorTextPrimary}" />
                </UniformGrid>

                <!-- TreeView -->
                <TreeView Grid.Row="3"
                          x:Name="MainTreeView"
                          ItemsSource="{Binding FilteredTree}"
                          VirtualizingPanel.IsVirtualizing="True"
                          SelectedItemChanged="MainTreeView_SelectedItemChanged"
                          Background="{DynamicResource ColorBackgroundBase}">

                    <!-- Container-Style -->
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{x:Null}">
                            <Setter Property="Padding" Value="2" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />

                        </Style>
                    </TreeView.ItemContainerStyle>

                    <!-- Header-Templates -->
                    <TreeView.Resources>

                        <!-- Plugin -->
                        <HierarchicalDataTemplate DataType="{x:Type local:PluginNodeVM}"
                                                  ItemsSource="{Binding Categories}">
                            <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                <TextBlock Text="{Binding PluginName}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource ColorTreeRoot}" />
                                <!-- Collapsed, the edited items underneath show nothing at all. -->
                                <TextBlock Style="{StaticResource ChangedDotStyle}"
                                           Visibility="{Binding HasEditedItems, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>

                        <!-- Kategorie -->
                        <HierarchicalDataTemplate DataType="{x:Type local:CategoryNodeVM}"
                                                  ItemsSource="{Binding Items}">
                            <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                <TextBlock Text="{Binding CategoryName}"
                                           Foreground="{DynamicResource ColorTreeBranch}" />
                                <TextBlock Style="{StaticResource ChangedDotStyle}"
                                           Visibility="{Binding HasEditedItems, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>

                            <!-- Container style for the item level (this template's children): clicks
                                 get intercepted here directly (Ctrl/Shift multi-select) instead of
                                 going through TreeView.SelectedItem - see MainContentVM.HandleItemNodeClick.
                                 Plugin/category level stays with normal single-select behavior. -->
                            <HierarchicalDataTemplate.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{x:Null}">
                                    <Setter Property="Padding" Value="2" />
                                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ItemNode_PreviewMouseLeftButtonDown"/>
                                </Style>
                            </HierarchicalDataTemplate.ItemContainerStyle>
                        </HierarchicalDataTemplate>

                        <!-- Item -->
                        <DataTemplate DataType="{x:Type local:ItemNodeVM}">
                            <Border x:Name="ItemHighlight" Background="Transparent" Padding="2,0">
                                <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                    <TextBlock x:Name="EditedDot"
                                               Text="&#x25CF;  "
                                               Foreground="{DynamicResource ColorWarning}"
                                               Visibility="Collapsed"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="EditorIdText"
                                               Text="{Binding EditorID}"
                                               Foreground="{DynamicResource ColorTreeLeaf}"/>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="ItemHighlight" Property="Background"
                                            Value="{DynamicResource ColorBackgroundHighlight}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEdited}" Value="True">
                                    <Setter TargetName="EditedDot" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="EditorIdText" Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>

                    </TreeView.Resources>
                </TreeView>
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource ColorDivider}" />

            <!-- RECHTS: Detailansicht -->
            <Grid Grid.Column="2" Margin="10,0,0,0">
            <ContentPresenter Content="{Binding SelectedNode}"
                              Width="Auto">
                <ContentPresenter.Resources>

                    <!-- ITEM-DETAIL -->
                    <DataTemplate DataType="{x:Type local:ItemNodeVM}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <!-- Presets -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- Item Details -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- Armor/Weapon Details -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- Keywords -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- Materials -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- Temper -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- Breakdown -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- Container -->
                                    </Grid.RowDefinitions>

                                    <!-- Preset-Zeile -->
                                    <Border Grid.Row="0"
                                        Background="{DynamicResource ColorBackgroundBase}"
                                        Padding="0"
                                        Margin="0,0,0,0">
                                        <DockPanel LastChildFill="False">
                                            <ComboBox ItemsSource="{Binding ConfigPresets}"
                                              SelectedItem="{Binding SelectedConfigPreset}"
                                              DisplayMemberPath="PresetName"
                                              Width="180"
                                              Style="{StaticResource ItemComboBoxStyle}"/>
                                            <Button Content="Apply"
                                            Command="{Binding ApplyPresetCommand}"
                                            Style="{StaticResource StandardButtonStyle}"/>

                                            <Button Content="Preview"
                                                Command="{Binding PreviewMeshCommand}"
                                                Style="{StaticResource StandardButtonStyle}"
                                                ToolTip="Show this item's model. Shape only — no textures."/>

                                            <Button Content="Export"
                                                Command="{Binding ExportItemCommand}"
                                                Style="{StaticResource ActionButtonStyle}"/>
                                            <Button Content="Import"
                                                Command="{Binding ImportItemCommand}"
                                                Style="{StaticResource ActionButtonWarmStyle}"/>
                                        </DockPanel>
                                    </Border>

                                    <!-- Item Details -->
                                    <GroupBox Grid.Row="1" Margin="0,0,0,15" Padding="10" Style="{StaticResource DarkGroupBoxStyle}">
                                        <GroupBox.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Item Details"
                                                    Style="{StaticResource TitelStyle}"/>

                                                <Button Margin="10,0,0,0" Style="{StaticResource InfoButtonStyle}">
                                                    <Button.ToolTip>
                                                        <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                            <StackPanel>
                                                                <TextBlock Text="Shows the fundamental properties of an item."
                                                                    Style="{StaticResource ToolTipTitelStyle}"/>
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </Button.ToolTip>
                                                </Button>

                                                <Button Content="Reset Changes"
                                                    Margin="15,0,0,0"
                                                    Style="{StaticResource StandardButtonStyle}"
                                                    Command="{Binding ResetChangesCommand}"
                                                    IsEnabled="{Binding HasAnyChanges}">
                                                    <Button.ToolTip>
                                                        <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                            <StackPanel>
                                                                <TextBlock Text="Reverts Name/Cost/Weight/Armor-Weapon-Details/Keywords/Container on this item back to how they looked when it was loaded, undoing any edits made since then."
                                                                    Style="{StaticResource ToolTipTitelStyle}"/>
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </Button.ToolTip>
                                                </Button>

                                                <Button Content="Reset ALL"
                                                    Margin="8,0,0,0"
                                                    Style="{StaticResource StandardButtonStyle}"
                                                    Command="{Binding ResetAllChangesCommand}"
                                                    IsEnabled="{Binding HasAnyItemOrRecipeChanges}">
                                                    <Button.ToolTip>
                                                        <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                            <StackPanel>
                                                                <TextBlock Text="Reverts EVERYTHING on this item - fields, crafting recipe and temper recipe - back to the scanned state. Asks for confirmation first."
                                                                    Style="{StaticResource ToolTipTitelStyle}"/>
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </Button.ToolTip>
                                                </Button>
                                            </StackPanel>
                                        </GroupBox.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>



                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <!-- EditorID -->
                                                <RowDefinition Height="Auto" />
                                                <!-- Key -->
                                                <RowDefinition Height="Auto" />
                                                <!-- Name -->
                                                <RowDefinition Height="Auto" />
                                                <!-- Cost -->
                                                <RowDefinition Height="Auto" />
                                                <!-- Weight -->
                                                <RowDefinition Height="Auto" />
                                                <!-- Enchantment -->
                                                <RowDefinition Height="Auto" />
                                                <!-- Charge (EAMT) -->
                                            </Grid.RowDefinitions>

                                            <!-- EditorID -->
                                            <TextBlock Grid.Row="0"
                                           Text="EditorID:"
                                           Style="{StaticResource ItemLabelStyle}"/>

                                            <TextBox Grid.Row="0"
                                             Grid.Column="1"
                                             Text="{Binding EditorID}"
                                             Style="{StaticResource CopyableIdentifierStyle}"/>

                                            <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource InfoButtonStyle}">
                                                <Button.ToolTip>
                                                    <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                        <StackPanel>
                                                            <TextBlock Text="Internal name used by the Creation Engine. Not relevant for gameplay."
                                                                Style="{StaticResource ToolTipTitelStyle}"/>
                                                        </StackPanel>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                            </Button>


                                            <!-- Key -->
                                            <TextBlock Grid.Row="1"
                                               Text="Key:"
                                               Style="{StaticResource ItemLabelStyle}"/>

                                            <TextBox Grid.Row="1"
                                             Grid.Column="1"
                                             Text="{Binding Key}"
                                             Style="{StaticResource CopyableIdentifierStyle}"/>

                                            <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource InfoButtonStyle}">
                                                <Button.ToolTip>
                                                    <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                        <StackPanel>
                                                            <TextBlock Text="Generated as MasterPluginName|FormID. Similar to the FormKey"
                                                                    Style="{StaticResource ToolTipTitelStyle}"/>
                                                        </StackPanel>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                            </Button>

                                            <!-- Name -->
                                            <TextBlock Grid.Row="2"
                                           Text="Name:"
                                           Style="{StaticResource ItemLabelStyle}"/>

                                            <TextBox Grid.Row="2"
                                                 Grid.Column="1"
                                                 Text="{Binding Name}"
                                                 BorderBrush="{Binding IsNameChanged, Converter={StaticResource BoolToChangedBorderConverter}}"
                                                 Style="{StaticResource ItemTextBoxStyle}"/>

                                            <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource InfoButtonStyle}">
                                                <Button.ToolTip>
                                                    <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                        <StackPanel>
                                                            <TextBlock Text="The in‑game display name of the item."
                                                                Style="{StaticResource ToolTipTitelStyle}"/>
                                                        </StackPanel>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                            </Button>

                                            <!-- Cost -->
                                            <TextBlock Grid.Row="3"
                                               Text="Cost:"
                                               Style="{StaticResource ItemLabelStyle}"/>

                                            <TextBox Grid.Row="3"
                                             Grid.Column="1"
                                             Text="{Binding Value}"
                                             BorderBrush="{Binding IsValueChanged, Converter={StaticResource BoolToChangedBorderConverter}}"
                                             model:NumericTextBoxBehavior.Mode="Integer"
                                             Style="{StaticResource ItemTextBoxStyle}"/>

                                            <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource InfoButtonStyle}">
                                                <Button.ToolTip>
                                                    <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                        <StackPanel>
                                                            <TextBlock Text="The base monetary value. The final price depends on your Speech skill, perks, buffs, and debuffs."
                                                                Style="{StaticResource ToolTipTitelStyle}"/>
                                                        </StackPanel>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                            </Button>

                                            <!-- Weight -->
                                            <TextBlock Grid.Row="4"
                                           Text="Weight:"
                                           Style="{StaticResource ItemLabelStyle}"/>

                                            <TextBox Grid.Row="4"
                                                 Grid.Column="1"
                                                 Text="{Binding Weight}"
                                                 BorderBrush="{Binding IsWeightChanged, Converter={StaticResource BoolToChangedBorderConverter}}"
                                                 model:NumericTextBoxBehavior.Mode="Decimal"
                                                 Style="{StaticResource ItemTextBoxStyle}"/>

                                            <Button Grid.Row="4" Grid.Column="2" Style="{StaticResource InfoButtonStyle}">
                                                <Button.ToolTip>
                                                    <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                        <StackPanel>
                                                            <TextBlock Text="How heavy the item is."
                                                                Style="{StaticResource ToolTipTitelStyle}"/>
                                                        </StackPanel>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                            </Button>

                                            <!-- WHICH enchantment this item wears (Prio 7).
                                                 In the general block, not the armor/weapon one: both
                                                 record types carry one (2,197 of 3,674 vanilla armors,
                                                 3,010 of 3,267 weapons), so it is as fundamental as
                                                 value and weight.
                                                 "(no enchantment)" is a real entry in the list, not a
                                                 blank - taking one off is something the patch can
                                                 express. -->
                                            <TextBlock Grid.Row="5"
                                                       Text="Enchantment:"
                                                       Style="{StaticResource ItemLabelStyle}"/>

                                            <!-- Picker plus jump button in one cell, rather than a
                                                 fourth grid column: every other row in this grid is
                                                 label / control / info, and a column added for one
                                                 button would indent all of them. -->
                                            <DockPanel Grid.Row="5" Grid.Column="1" LastChildFill="True">

                                                <!-- Sprungmarke zum Enchantment-Tab (Prio 9). Sagt als
                                                     Knopf, was bisher nur im Info-Tooltip stand: hier
                                                     wird zugewiesen, bearbeitet wird drüben.

                                                     KEIN eigener Margin. Der erste Anlauf setzte
                                                     "6,0,0,0" und stand damit falsch in beide
                                                     Richtungen: 5px weiter rechts als jede Zeile
                                                     darüber, weil die 5 aus dem Stil der Takt dieser
                                                     Spalte sind und nicht Zierde - und 2,5px zu tief,
                                                     weil der Bodenabstand der ComboBox das DockPanel
                                                     um 5px höher macht und ein zentrierter Knopf ohne
                                                     denselben Bodenabstand darin nach unten rutscht.
                                                     Der Stil bringt 0,0,5,5 und VerticalAlignment
                                                     schon mit, und den Abstand zur Box liefert deren
                                                     eigener Rechtsabstand. -->
                                                <Button DockPanel.Dock="Right"
                                                        Content="Jump to enchantment"
                                                        Command="{Binding JumpToEnchantmentCommand}"
                                                        IsEnabled="{Binding CanJumpToEnchantment}"
                                                        Style="{StaticResource StandardButtonStyle}"
                                                        ToolTip="Opens this enchantment in the Enchantments tab, where its effects and worn restrictions can be edited. Greyed out when the item wears none, or when the enchantment's plugin is not in the scan."/>

                                                <!-- Editable and filtering as you type, like the workbench
                                                     picker: 632 entries are not a list anyone scrolls.
                                                     IsTextSearchEnabled off, because the Text here is the
                                                     SEARCH string - WPF's own type-ahead would fight it. -->
                                                <ComboBox ItemsSource="{Binding FilteredEnchantments}"
                                                          SelectedItem="{Binding SelectedEnchantment, Mode=TwoWay}"
                                                          Text="{Binding EnchantmentSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEditable="True"
                                                          IsTextSearchEnabled="False"
                                                          IsSynchronizedWithCurrentItem="False"
                                                          StaysOpenOnEdit="True"
                                                          TextSearch.TextPath="Name"
                                                          DisplayMemberPath="Name"
                                                          BorderBrush="{Binding IsObjectEffectChanged, Converter={StaticResource BoolToChangedBorderConverter}}"
                                                          Style="{StaticResource ItemComboBoxStyle}"
                                                          ToolTip="{Binding ObjectEffectSummary}"/>
                                            </DockPanel>

                                            <Button Grid.Row="5" Grid.Column="2" Style="{StaticResource InfoButtonStyle}">
                                                <Button.ToolTip>
                                                    <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                        <StackPanel>
                                                            <TextBlock Text="Which enchantment this item carries."
                                                                       Style="{StaticResource ToolTipTitelStyle}"/>
                                                            <TextBlock Text="•  Listed as EditorID | Name: 473 of 632 enchantments share their name with another, so the name alone cannot tell a base effect from its tiers."
                                                                       Style="{StaticResource ToolTipTextStyle}"/>
                                                            <TextBlock Text="•  This assigns an existing enchantment - it does not edit the enchantment itself. That is the Enchantments tab."
                                                                       Style="{StaticResource ToolTipTextStyle}"/>
                                                            <TextBlock Text="•  Choosing (no enchantment) takes it off. The base record loses it, but a copy your save already carries may keep it - judge that on a freshly spawned item."
                                                                       Style="{StaticResource ToolTipTextStyle}"/>
                                                            <TextBlock Text="•  An enchantment on its own is only half of it. The charge below is what lets the item hold and recharge it."
                                                                       Style="{StaticResource ToolTipTextStyle}"/>
                                                        </StackPanel>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                            </Button>

                                            <!-- The item's OWN charge pool (EAMT), directly under the
                                                 enchantment because the two are one thing in use:
                                                 objectEffect says WHICH effect, this says how much
                                                 charge the item can hold. Measured in xEdit - with the
                                                 link and no amount there is no maximum charge and the
                                                 weapon cannot be recharged. A tester arrived with
                                                 exactly that item. -->
                                            <TextBlock Grid.Row="6"
                                                       Text="Charge:"
                                                       Style="{StaticResource ItemLabelStyle}"/>

                                            <TextBox Grid.Row="6"
                                                     Grid.Column="1"
                                                     Text="{Binding EnchantAmount}"
                                                     BorderBrush="{Binding IsEnchantAmountChanged, Converter={StaticResource BoolToChangedBorderConverter}}"
                                                     model:NumericTextBoxBehavior.Mode="Integer"
                                                     Style="{StaticResource ItemTextBoxStyle}"/>

                                            <Button Grid.Row="6" Grid.Column="2" Style="{StaticResource InfoButtonStyle}">
                                                <Button.ToolTip>
                                                    <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                        <StackPanel>
                                                            <TextBlock Text="How much enchantment charge this item can hold."
                                                                       Style="{StaticResource ToolTipTitelStyle}"/>
                                                            <TextBlock Text="•  This is the item's own field, not the enchantment's. An item that carries an enchantment but has no charge here cannot be recharged."
                                                                       Style="{StaticResource ToolTipTextStyle}"/>
                                                            <TextBlock Text="•  How many casts that is depends on the enchantment's cost, which lives in the Enchantments tab."
                                                                       Style="{StaticResource ToolTipTextStyle}"/>
                                                            <TextBlock Text="•  0 on every unenchanted item, and that is what it should stay there."
                                                                       Style="{StaticResource ToolTipTextStyle}"/>
                                                        </StackPanel>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                            </Button>
                                        </Grid>
                                    </GroupBox>

                                    <!-- Armor / Weapon Specific Details -->
                                    <!-- Header carries a dot when something inside changed: the
                                         section is collapsed by default, and the amber borders on
                                         the fields cannot be seen through a shut expander. -->
                                    <Expander Grid.Row="2" Style="{StaticResource DarkExpanderStyle}" IsExpanded="False">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Expand Armor / Weapon Specific Details"/>
                                                <TextBlock Style="{StaticResource ChangedDotStyle}"
                                                           ToolTip="Armor rating, slots, armor type or the weapon stats differ from the scanned values."
                                                           Visibility="{Binding HasSpecificDetailChanges, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </Expander.Header>
                                        <GroupBox
                                        Style="{StaticResource DarkGroupBoxStyle}"
                                        Margin="0,0,0,15"
                                        Padding="10">
                                            <GroupBox.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Armor / Weapon Specific Details"
                                                    Style="{StaticResource TitelStyle}"/>

                                                    <Button Margin="10,0,0,0" Style="{StaticResource InfoButtonStyle}">
                                                        <Button.ToolTip>
                                                            <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                                <StackPanel>
                                                                    <TextBlock Text="This Block shows the Armor / Weapon Specific Details of an item."
                                                                        Style="{StaticResource ToolTipTitelStyle}"/>
                                                                </StackPanel>
                                                            </ToolTip>
                                                        </Button.ToolTip>
                                                    </Button>
                                                </StackPanel>
                                            </GroupBox.Header>

                                            <VirtualizingStackPanel>

                                                <!-- ARMOR -->
                                                <StackPanel Visibility="{Binding IsArmor, Converter={StaticResource BoolToVis}}">

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <!-- ArmorRating -->
                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Armor Rating:" Style="{StaticResource ItemLabelStyle}"/>

                                                        <TextBox Grid.Row="0" Grid.Column="1"
                                                         Text="{Binding ArmorRating}"
                                                         BorderBrush="{Binding IsArmorRatingChanged, Converter={StaticResource BoolToChangedBorderConverter}}"
                                                         model:NumericTextBoxBehavior.Mode="Decimal"
                                                         Style="{StaticResource ItemTextBoxStyle}"/>

                                                        <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource InfoButtonStyle}">
                                                            <Button.ToolTip>
                                                                <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                                    <StackPanel>
                                                                        <TextBlock Text="How much incoming physical damage is reduced."
                                                                        Style="{StaticResource ToolTipTitelStyle}"/>
                                                                    </StackPanel>
                                                                </ToolTip>
                                                            </Button.ToolTip>
                                                        </Button>
                                                    </Grid>

                                                    <!-- ArmorType (BOD2). Deliberately a separate field, not derived from the
                                                         ArmorLight keyword: 27% of vanilla armor carries no class keyword at
                                                         all, and ~40 records diverge on purpose. Picking an armour-class
                                                         keyword does move this automatically (see ItemNodeVM
                                                         .ApplyArmorTypeFromKeyword) - as a normal, resettable edit. -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="Armor Type:" Style="{StaticResource ItemLabelStyle}"/>

                                                        <ComboBox Grid.Column="1"
                                                                  ItemsSource="{Binding ArmorTypeChoices}"
                                                                  SelectedItem="{Binding ArmorType, Mode=TwoWay}"
                                                                  IsSynchronizedWithCurrentItem="False"
                                                                  BorderBrush="{Binding IsArmorTypeChanged, Converter={StaticResource BoolToChangedBorderConverter}}"
                                                                  Style="{StaticResource ItemComboBoxStyle}"/>

                                                        <Button Grid.Column="2" Style="{StaticResource InfoButtonStyle}">
                                                            <Button.ToolTip>
                                                                <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                                    <StackPanel>
                                                                        <TextBlock Text="Whether the game treats this as light armor, heavy armor or clothing."
                                                                                   Style="{StaticResource ToolTipTitelStyle}"/>
                                                                        <TextBlock Text="This is NOT the same as the ArmorLight/ArmorHeavy keyword. Keywords drive perks, material and vendors; this field decides the inventory category, whether an armor rating is shown at all, and whether the item can be tempered. Clothing with armor keywords still shows no armor rating in game."
                                                                                   TextWrapping="Wrap" MaxWidth="420"/>
                                                                    </StackPanel>
                                                                </ToolTip>
                                                            </Button.ToolTip>
                                                        </Button>
                                                    </Grid>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Body Slots:" Style="{StaticResource ItemLabelStyle}"/>

                                                        <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource InfoButtonStyle}">
                                                            <Button.ToolTip>
                                                                <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                                    <StackPanel>
                                                                        <TextBlock Text="Defines where the item is equipped. Items can use multiple slots. If two items share a slot, you cannot equip both at the same time."
                                                                        Style="{StaticResource ToolTipTitelStyle}"/>
                                                                    </StackPanel>
                                                                </ToolTip>
                                                            </Button.ToolTip>
                                                        </Button>

                                                        <Border Grid.Row="1" Grid.ColumnSpan="3"
                                                                BorderBrush="{Binding IsBodySlotMaskChanged, Converter={StaticResource BoolToChangedBorderConverter}}"
                                                                BorderThickness="0,0,0,2" Margin="0,2,0,5"
                                                                ToolTip="A colored line here means the Body Slots differ from how they looked when this item was loaded."/>
                                                    </Grid>

                                                    <ItemsControl ItemsSource="{Binding SlotOptions}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>

                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border CornerRadius="4"
                                                                        Padding="5"
                                                                        Margin="3"
                                                                        Background="{Binding IsSelected, Converter={StaticResource BoolToBrushConverter}}">

                                                                    <Border.InputBindings>
                                                                        <MouseBinding MouseAction="LeftClick"
                                                                          Command="{Binding ToggleSelectedCommand}" />
                                                                    </Border.InputBindings>

                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                   Foreground="{DynamicResource ColorChipText}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                </StackPanel>

                                                <!-- WEAPON -->
                                                <StackPanel Visibility="{Binding IsWeapon, Converter={StaticResource BoolToVis}}">
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <!-- Label -->
                                                            <ColumnDefinition Width="*"/>
                                                            <!-- Value -->
                                                            <ColumnDefinition Width="Auto"/>
                                                            <!-- Info Button -->
                                                        </Grid.ColumnDefinitions>

                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <!-- DAMAGE -->
                                                        <TextBlock Grid.Column="0" Grid.Row="0" Text="Damage:" Style="{StaticResource ItemLabelStyle}"/>
                                                        <TextBox Grid.Column="1"
                                                         Text="{Binding Damage}"
                                                         BorderBrush="{Binding IsDamageChanged, Converter={StaticResource BoolToChangedBorderConverter}}"
                                                         model:NumericTextBoxBehavior.Mode="Integer"
                                                         Style="{StaticResource ItemTextBoxStyle}"/>
                                                        <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource InfoButtonStyle}">
                                                            <Button.ToolTip>
                                                                <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                                    <StackPanel>
                                                                        <TextBlock Text="The weapon’s base damage before modifiers. Temper improvements, skills, perks, and debuffs modify this value."
                                                                        Style="{StaticResource ToolTipTitelStyle}"/>
                                                                    </StackPanel>
                                                                </ToolTip>
                                                            </Button.ToolTip>
                                                        </Button>

                                                        <!-- SPEED -->
                                                        <TextBlock Grid.Column="0" Grid.Row="1" Text="Speed:" Style="{StaticResource ItemLabelStyle}"/>
                                                        <TextBox Grid.Column="1" Grid.Row="1"
                                                         Text="{Binding Speed}"
                                                         BorderBrush="{Binding IsSpeedChanged, Converter={StaticResource BoolToChangedBorderConverter}}"
                                                         model:NumericTextBoxBehavior.Mode="Decimal"
                                                         model:NumericTextBoxBehavior.Max="10"
                                                         Style="{StaticResource ItemTextBoxStyle}"/>
                                                        <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource InfoButtonStyle}">
                                                            <Button.ToolTip>
                                                                <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                                    <StackPanel>
                                                                        <TextBlock Text="How fast the weapon swings."
                                                                        Style="{StaticResource ToolTipTitelStyle}"/>
                                                                    </StackPanel>
                                                                </ToolTip>
                                                            </Button.ToolTip>
                                                        </Button>

                                                        <!-- REACH -->
                                                        <TextBlock Grid.Column="0" Grid.Row="2" Text="Reach:" Style="{StaticResource ItemLabelStyle}"/>
                                                        <TextBox Grid.Column="1" Grid.Row="2"
                                                         Text="{Binding Reach}"
                                                         BorderBrush="{Binding IsReachChanged, Converter={StaticResource BoolToChangedBorderConverter}}"
                                                         model:NumericTextBoxBehavior.Mode="Decimal"
                                                         model:NumericTextBoxBehavior.Max="10"
                                                         Style="{StaticResource ItemTextBoxStyle}"/>
                                                        <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource InfoButtonStyle}">
                                                            <Button.ToolTip>
                                                                <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                                    <StackPanel>
                                                                        <TextBlock Text="How far the weapon can hit. Changing this usually feels unnatural unless you know exactly what you're doing."
                                                                        Style="{StaticResource ToolTipTitelStyle}"/>
                                                                    </StackPanel>
                                                                </ToolTip>
                                                            </Button.ToolTip>
                                                        </Button>

                                                        <!-- STAGGER -->
                                                        <TextBlock Grid.Column="0" Grid.Row="3" Text="Stagger:" Style="{StaticResource ItemLabelStyle}"/>
                                                        <TextBox Grid.Column="1" Grid.Row="3"
                                                     Text="{Binding Stagger}"
                                                     BorderBrush="{Binding IsStaggerChanged, Converter={StaticResource BoolToChangedBorderConverter}}"
                                                     model:NumericTextBoxBehavior.Mode="Decimal"
                                                     model:NumericTextBoxBehavior.Max="10"
                                                     Style="{StaticResource ItemTextBoxStyle}"/>
                                                        <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource InfoButtonStyle}">
                                                            <Button.ToolTip>
                                                                <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                                    <StackPanel>
                                                                        <TextBlock Text="Controls how much stagger the weapon inflicts on hit."
                                                                           Style="{StaticResource ToolTipTitelStyle}"/>
                                                                    </StackPanel>
                                                                </ToolTip>
                                                            </Button.ToolTip>
                                                        </Button>
                                                    </Grid>
                                                </StackPanel>


                                            </VirtualizingStackPanel>
                                        </GroupBox>
                                    </Expander>


                                    <!-- Keywords -->
                                    <!-- Top View -->
                                    <Expander Grid.Row="3" Style="{StaticResource DarkExpanderStyle}" IsExpanded="False">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Keywords"/>
                                                <TextBlock Style="{StaticResource ChangedDotStyle}"
                                                           ToolTip="The keyword set differs from the scanned one."
                                                           Visibility="{Binding IsKeywordsChanged, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel>
                                            <Grid Margin="0,10,5,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Titel -->
                                                <TextBlock Grid.Column="0" Text="Search:"
                                               Style="{StaticResource ItemLabelStyle}"/>

                                                <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ItemTextSearchBoxStyle}"
                                                 />

                                                <CheckBox Grid.Column="2"
                                                  Style="{StaticResource ItemCheckBoxStyle}"
                                                  Content="All Keywords (Expert)"
                                                  IsChecked="{Binding ShowAllKeywords}"
                                                      Margin="0,0,0,5"/>

                                            </Grid>

                                            <GroupBox
                                            Style="{StaticResource DarkGroupBoxStyle}"
                                            BorderBrush="{Binding IsKeywordsChanged, Converter={StaticResource BoolToChangedBorderConverter}}"
                                            BorderThickness="2"
                                            Margin="0,0,0,10"
                                            Padding="10">

                                                <GroupBox.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Selected Keywords"
                                                       Style="{StaticResource TitelStyle}"/>

                                                        <Button Margin="10,0,0,0" Style="{StaticResource InfoButtonStyle}">
                                                            <Button.ToolTip>
                                                                <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                                    <StackPanel>
                                                                        <TextBlock Text="Shows which keywords are currently applied to the item."
                                                                        Style="{StaticResource ToolTipTitelStyle}"/>

                                                                        <StackPanel>
                                                                            <TextBlock Text="Rules:"
                                                                                    Style="{StaticResource ToolTipTextStyle}"/>
                                                                            <TextBlock Text="•  You can only select one of this Keywords: ArmorLight, ArmorHeavy, ArmorClothing"
                                                                                    Style="{StaticResource ToolTipTextStyle}"/>
                                                                            <TextBlock Text="•  ArmorLight, ArmorHeavy: Blocks all Clothing keywords"
                                                                                    Style="{StaticResource ToolTipTextStyle}"/>
                                                                            <TextBlock Text="•  ArmorClothing: Blocks all Armor keywords"
                                                                                    Style="{StaticResource ToolTipTextStyle}"/>
                                                                            <TextBlock Text="•  You can not change WeapType Keywords or select them!"
                                                                                    Style="{StaticResource ToolTipTextStyle}"/>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </ToolTip>
                                                            </Button.ToolTip>
                                                        </Button>
                                                    </StackPanel>
                                                </GroupBox.Header>

                                                <ItemsControl ItemsSource="{Binding SelectedKeywordsView}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>

                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="4"
                                                        Padding="5"
                                                        Margin="3"
                                                        Background="{Binding IsSelected, Converter={StaticResource BoolToBrushConverter}}">

                                                                <Border.InputBindings>
                                                                    <MouseBinding MouseAction="LeftClick"
                                                                Command="{Binding ToggleSelectedCommand}" />
                                                                </Border.InputBindings>

                                                                <TextBlock Text="{Binding Name}"
                                                            Foreground="{DynamicResource ColorChipText}"
                                                            TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                            </GroupBox>
                                            <!-- Bottom View -->

                                            <GroupBox
                                        Style="{StaticResource DarkGroupBoxStyle}"
                                        Margin="0,0,0,15"
                                        Padding="10">

                                                <GroupBox.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Keywords"
                                                        Style="{StaticResource TitelStyle}"/>

                                                        <Button
                                                        Margin="10,0,0,0"
                                                        Style="{StaticResource InfoButtonStyle}">
                                                            <Button.ToolTip>
                                                                <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                                    <StackPanel>
                                                                        <TextBlock Text="Shows all available keywords."
                                                                        Style="{StaticResource ToolTipTitelStyle}"/>

                                                                        <StackPanel>
                                                                            <TextBlock Text="•  Click to select, click again to unselect."
                                                                            Style="{StaticResource ToolTipTextStyle}"/>
                                                                            <TextBlock Text="•  Standard View: Only commonly used keywords for weapons/armor."
                                                                            Style="{StaticResource ToolTipTextStyle}"/>
                                                                            <TextBlock Text="•  Expert View: Loads all keywords from your entire modlist."
                                                                            Style="{StaticResource ToolTipTextStyle}"/>
                                                                            <TextBlock Text="•  Only recommended if you know exactly what each keyword does."
                                                                            Style="{StaticResource ToolTipTextStyle}"/>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </ToolTip>
                                                            </Button.ToolTip>
                                                        </Button>
                                                    </StackPanel>
                                                </GroupBox.Header>

                                                <ItemsControl ItemsSource="{Binding FilteredKeywordsView}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>

                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="4"
                                                                Padding="5"
                                                                Margin="3"
                                                                ToolTip="{Binding Key}">

                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{Binding IsSelected, Converter={StaticResource BoolToBrushConverter}}"/>
                                                                        <Style.Triggers>
                                                                            <!-- Weapon-type keywords: visually highlight and make read-only -->
                                                                            <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                                                                <Setter Property="Background" Value="{DynamicResource ColorSurfaceDanger}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>

                                                                <Border.InputBindings>
                                                                    <MouseBinding MouseAction="LeftClick"
                                                                Command="{Binding ToggleSelectedCommand}" />
                                                                </Border.InputBindings>

                                                                <TextBlock Text="{Binding Name}"
                                                            FontSize="{Binding DataContext.KeywordFontSize,
                                                                               RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            Foreground="{DynamicResource ColorChipText}"
                                                            HorizontalAlignment="Center"
                                                            TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </GroupBox>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Crafting / Recipe -->
                                    <Expander Grid.Row="4" Style="{StaticResource DarkExpanderStyle}" IsExpanded="False">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Crafting Recipe"/>
                                                <!-- Only when there IS something hidden. Measured: 305 of ~8,700 items have
                                                     more than one crafting recipe, so on most items this stays away. -->
                                                <Button Content="other recipes"
                                                        Margin="8,0,0,0"
                                                        Command="{Binding ShowOtherRecipesCommand}"
                                                        CommandParameter="Crafting"
                                                        ToolTip="This item has more than one crafting recipe. Choose which one the editor shows, or take one out."
                                                        Visibility="{Binding HasOtherCraftingRecipes, Converter={StaticResource BoolToVis}}"
                                                        Style="{StaticResource StandardButtonStyle}"/>
                                                <!-- HasCraftingChanges also covers a recipe the user
                                                     created outright, which has no scanned original
                                                     to differ from. -->
                                                <TextBlock Style="{StaticResource ChangedDotStyle}"
                                                           ToolTip="The crafting recipe was changed or newly created."
                                                           Visibility="{Binding HasCraftingChanges, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </Expander.Header>
                                        <GroupBox
                                                Style="{StaticResource DarkGroupBoxStyle}"
                                                Padding="10">
                                            <GroupBox.Header>
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock Text="Crafting Recipe"
                                                    Style="{StaticResource TitelStyle}"/>

                                                    <Button Margin="10,0,0,0" Style="{StaticResource InfoButtonStyle}">
                                                        <Button.ToolTip>
                                                            <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                                <StackPanel>
                                                                    <TextBlock Text="Shows the crafting recipe for creating the item."
                                                                        Style="{StaticResource ToolTipTitelStyle}"/>
                                                                </StackPanel>
                                                            </ToolTip>
                                                        </Button.ToolTip>
                                                    </Button>

                                                    <Button Content="Reset Changes"
                                                        Margin="15,0,0,0"
                                                        Style="{StaticResource StandardButtonStyle}"
                                                        Command="{Binding ResetCraftingRecipeCommand}"
                                                        IsEnabled="{Binding HasCraftingChanges}">
                                                        <Button.ToolTip>
                                                            <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                                <StackPanel>
                                                                    <TextBlock Text="Reverts Workbench, Ingredients, and Conditions back to how they looked when this recipe was loaded, undoing any edits made since then."
                                                                        Style="{StaticResource ToolTipTitelStyle}"/>
                                                                </StackPanel>
                                                            </ToolTip>
                                                        </Button.ToolTip>
                                                    </Button>

                                                </DockPanel>
                                            </GroupBox.Header>
                                            <StackPanel>
                                                <!-- Empty section: the item has no crafting recipe at all yet. Says how one is
                                                     created, because that isn't obvious from an empty section (tester feedback,
                                                     see docs/TODO.md). Hidden again the moment the COBJ exists. -->
                                                <TextBlock Text="No crafting recipe yet - pick a Workbench, or add a material or condition with one of the green + buttons, and one will be created."
                                                           Foreground="{DynamicResource ColorTextTertiary}"
                                                           TextWrapping="Wrap" Margin="0,0,0,4"
                                                           Visibility="{Binding CraftingRecipeAbsent, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="⚠ This recipe has no workbench set - it can't be crafted in-game."
                                                           Foreground="{DynamicResource ColorWarning}"
                                                           TextWrapping="Wrap" Margin="0,0,0,4"
                                                           Visibility="{Binding CraftingRecipeMissingWorkbench, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="⚠ This recipe has no ingredients - it will be free to craft."
                                                           Foreground="{DynamicResource ColorWarning}"
                                                           TextWrapping="Wrap" Margin="0,0,0,4"
                                                           Visibility="{Binding CraftingRecipeMissingIngredients, Converter={StaticResource BoolToVis}}"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <!-- COBJ Origin Key -->
                                                        <RowDefinition Height="Auto" />
                                                        <!-- Workbench -->
                                                        <RowDefinition Height="Auto" />
                                                        <!-- Perk -->
                                                    </Grid.RowDefinitions>

                                                    <!-- COBJ Origin Key -->
                                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                                       Text="COBJ Origin Key: "
                                                       Style="{StaticResource ItemLabelStyle}"/>

                                                    <TextBox Grid.Row="0" Grid.Column="1"
                                                         Text="{Binding CraftingEditorID, Mode=OneWay}"
                                                         Style="{StaticResource CopyableIdentifierStyle}"/>

                                                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource InfoButtonStyle}">
                                                        <Button.ToolTip>
                                                            <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                                <StackPanel>
                                                                    <TextBlock Text="The key of the original recipe: MasterPluginName | FormID."
                                                                    Style="{StaticResource ToolTipTitelStyle}"/>
                                                                </StackPanel>
                                                            </ToolTip>
                                                        </Button.ToolTip>
                                                    </Button>


                                                    <!-- Workbench -->
                                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Text="Workbench:"
                                                   Style="{StaticResource ItemLabelStyle}"/>

                                                    <ComboBox Grid.Row="1" Grid.Column="1"
                                                      ItemsSource="{Binding FilteredCraftingWorkbenches}"
                                                      SelectedItem="{Binding SelectedWorkbench, Mode=TwoWay}"
                                                      Text="{Binding CraftingWorkbenchSearchText}"
                                                      IsEditable="True"
                                                      IsTextSearchEnabled="False"
                                                      IsSynchronizedWithCurrentItem="False"
                                                      StaysOpenOnEdit="True"
                                                      TextSearch.TextPath="Name">
                                                        <ComboBox.Style>
                                                            <!-- Dead-reference red wins over edited-amber -->
                                                            <Style TargetType="ComboBox" BasedOn="{StaticResource ItemComboBoxStyle}">
                                                                <Setter Property="BorderBrush" Value="{Binding IsCraftingWorkbenchChanged, Converter={StaticResource BoolToChangedBorderConverter}}"/>
                                                                <Setter Property="ToolTip" Value="{Binding SelectedValue, RelativeSource={RelativeSource Self}}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCraftingWorkbenchDeadRef}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource ColorDanger}"/>
                                                                        <Setter Property="ToolTip" Value="This workbench keyword is not in the active load order."/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ComboBox.Style>
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Name}" ToolTip="{Binding Key}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>

                                                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource InfoButtonStyle}">
                                                        <Button.ToolTip>
                                                            <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                                <StackPanel>
                                                                    <TextBlock Text="The crafting station where the item can be created. Recommended: SkyrimSmithingForge (the standard forge)."
                                                                    Style="{StaticResource ToolTipTitelStyle}"/>
                                                                </StackPanel>
                                                            </ToolTip>
                                                        </Button.ToolTip>
                                                    </Button>


                                                    <!-- Conditions -->
                                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Width="Auto">
                                                        <TextBlock Text="Conditions:" Style="{StaticResource ItemLabelStyle}" />
                                                        <Border BorderBrush="{Binding IsCraftingConditionsChanged, Converter={StaticResource BoolToChangedBorderConverter}}"
                                                                BorderThickness="0,0,0,2" Margin="0,0,0,5"
                                                                ToolTip="A colored line here means the Conditions differ from how they looked when this recipe was loaded."/>

                                                        <ItemsControl ItemsSource="{Binding CraftingConditions}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,5">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="200" />
                                                                            <!-- Type -->
                                                                            <ColumnDefinition Width="*" />
                                                                            <!-- Target -->
                                                                            <ColumnDefinition Width="*" />
                                                                            <!-- Value -->
                                                                            <ColumnDefinition Width="200" />
                                                                            <!-- RunOn -->
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <!-- Remove -->
                                                                        </Grid.ColumnDefinitions>

                                                                        <!-- Condition Type -->
                                                                        <DockPanel Grid.Column="0" VerticalAlignment="Center">
                                                                            <TextBlock Text="Type:" Style="{StaticResource ItemLabelStyle}" VerticalAlignment="Center" />
                                                                            <ComboBox Grid.Column="0"
                                                                          ItemsSource="{Binding ConditionTypes}"
                                                                          SelectedItem="{Binding Type, Mode=TwoWay}"
                                                                          Style="{StaticResource ItemComboBoxStyle}" />
                                                                        </DockPanel>

                                                                        <!-- Target -->
                                                                        <DockPanel Grid.Column="1" VerticalAlignment="Center">
                                                                            <TextBlock Text="Target:" Style="{StaticResource ItemLabelStyle}" VerticalAlignment="Center" />
                                                                            <ContentControl Content="{Binding}"/>
                                                                        </DockPanel>

                                                                        <!-- Value -->
                                                                        <DockPanel Grid.Column="2" VerticalAlignment="Center">
                                                                            <TextBlock Text="Value:" Style="{StaticResource ItemLabelStyle}" VerticalAlignment="Center" />
                                                                            <TextBox
                                                                             Text="{Binding ComparisonValue}"
                                                                             Style="{StaticResource ItemTextBoxStyle}" />
                                                                        </DockPanel>
                                                                        <!-- RunOn -->
                                                                        <DockPanel Grid.Column="3" VerticalAlignment="Center">
                                                                            <TextBlock Text="Run On:" Style="{StaticResource ItemLabelStyle}" VerticalAlignment="Center" />
                                                                            <ComboBox
                                                                                  ItemsSource="{Binding RunOnOptions}"
                                                                                  SelectedItem="{Binding RunOn}"
                                                                                  Style="{StaticResource ItemComboBoxStyle}" />
                                                                        </DockPanel>

                                                                        <!-- Remove -->
                                                                        <Button Grid.Column="4"
                                                                            Command="{Binding DataContext.RemoveCraftingConditionCommand,
                                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            Style="{StaticResource RemoveButtonStyle}" 
                                                                            ToolTip="Remove Condition"/>

                                                                        <!-- Read-only condition overlay: covers the whole row for a condition type that is preserved
                                                                             but not editable. The overlay itself lives in Styles/ConditionTemplates.xaml as the
                                                                             template for ReadOnlyConditionViewModel.
                                                                             Content is set by a DataTrigger and left null otherwise - NOT a Visibility toggle on a
                                                                             filled element. Null content means the template is never instantiated for an ordinary
                                                                             condition, so its bindings (Explanation, FunctionName, ...) cannot be evaluated against a
                                                                             view model that has none of them. That was 12 binding errors per editable row. -->
                                                                        <ContentControl Grid.Column="0" Grid.ColumnSpan="5" Panel.ZIndex="10">
                                                                            <ContentControl.Style>
                                                                                <Style TargetType="ContentControl">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Type}" Value="ReadOnly">
                                                                                            <Setter Property="Content" Value="{Binding}"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </ContentControl.Style>
                                                                        </ContentControl>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <Button Command="{Binding AddCraftingConditionCommand}"
                                                                Style="{StaticResource AddButtonStyle}"
                                                                ToolTip="Add Condition" />
                                                    </StackPanel>


                                                </Grid>

                                                <Border BorderBrush="{Binding IsCraftingIngredientsChanged, Converter={StaticResource BoolToChangedBorderConverter}}"
                                                        BorderThickness="0,0,0,2" Margin="0,5,0,5"
                                                        ToolTip="A colored line here means the Ingredients list differs from how it looked when this recipe was loaded."/>
                                                <ItemsControl ItemsSource="{Binding CraftingIngredients}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,5">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="60" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <ComboBox Grid.Column="0"
                                                                  ItemsSource="{Binding LocalMaterialsView}"
                                                                  SelectedItem="{Binding SelectedMaterial}" IsSynchronizedWithCurrentItem="False" BorderBrush="{Binding IsDeadReference, Converter={StaticResource BoolToDeadRefBorderConverter}}"
                                                                  Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                                  ToolTip="{Binding Key}"
                                                                  DisplayMemberPath="Name"
                                                                  IsEditable="True"
                                                                  IsTextSearchEnabled="False"
                                                                  StaysOpenOnEdit="True"
                                                                  Style="{StaticResource ItemComboBoxStyle}"/>

                                                                <TextBox Grid.Column="1"
                                                                 TextAlignment="Center"
                                                                 ToolTip="Amount"
                                                                 Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}"
                                                                 model:NumericTextBoxBehavior.Mode="Integer"
                                                                 model:NumericTextBoxBehavior.Min="1"
                                                                 Style="{StaticResource ItemTextBoxStyle}"/>

                                                                <Button Grid.Column="2"
                                                                Command="{Binding DataContext.RemoveIngredientCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="Remove Material"
                                                                Style="{StaticResource RemoveButtonStyle}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button
                                                Command="{Binding AddIngredientCommand}"
                                                ToolTip="Add Material/Recipe"
                                                Style="{StaticResource AddButtonStyle}"/>
                                            </StackPanel>
                                        </GroupBox>
                                    </Expander>

                                    <!-- Temper Recipe -->
                                    <Expander Grid.Row="5" Style="{StaticResource DarkExpanderStyle}" IsExpanded="False">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Temper Recipe"/>
                                                <Button Content="other recipes"
                                                        Margin="8,0,0,0"
                                                        Command="{Binding ShowOtherRecipesCommand}"
                                                        CommandParameter="Temper"
                                                        ToolTip="This item has more than one temper recipe. Choose which one the editor shows, or take one out."
                                                        Visibility="{Binding HasOtherTemperRecipes, Converter={StaticResource BoolToVis}}"
                                                        Style="{StaticResource StandardButtonStyle}"/>
                                                <TextBlock Style="{StaticResource ChangedDotStyle}"
                                                           ToolTip="The temper recipe was changed or newly created."
                                                           Visibility="{Binding HasTemperChanges, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </Expander.Header>
                                        <GroupBox
                                        Style="{StaticResource DarkGroupBoxStyle}"
                                        Margin="0,15,0,0"
                                        Padding="10">
                                            <GroupBox.Header>
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock Text="Temper Recipe"
                                                    Style="{StaticResource TitelStyle}"/>
                                                    <Button Margin="10,0,0,0" Style="{StaticResource InfoButtonStyle}">
                                                        <Button.ToolTip>
                                                            <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                                <StackPanel>
                                                                    <TextBlock Text="Shows the recipe used to improve (temper) the item."
                                                                        Style="{StaticResource ToolTipTitelStyle}"/>
                                                                </StackPanel>
                                                            </ToolTip>
                                                        </Button.ToolTip>
                                                    </Button>

                                                    <Button Content="Reset Changes"
                                                        Margin="15,0,0,0"
                                                        Style="{StaticResource StandardButtonStyle}"
                                                        Command="{Binding ResetTemperRecipeCommand}"
                                                        IsEnabled="{Binding HasTemperChanges}">
                                                        <Button.ToolTip>
                                                            <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                                <StackPanel>
                                                                    <TextBlock Text="Reverts Ingredients and Conditions back to how they looked when this recipe was loaded, undoing any edits made since then."
                                                                        Style="{StaticResource ToolTipTitelStyle}"/>
                                                                </StackPanel>
                                                            </ToolTip>
                                                        </Button.ToolTip>
                                                    </Button>
                                                </DockPanel>
                                            </GroupBox.Header>

                                            <StackPanel>
                                                <!-- See the same hint in the Crafting section above. No Workbench here - the
                                                     temper workbench is auto-derived at COBJ-creation time - so the green +
                                                     buttons are the only way in. -->
                                                <TextBlock Text="No temper recipe yet - add a material or condition with one of the green + buttons, and one will be created."
                                                           Foreground="{DynamicResource ColorTextTertiary}"
                                                           TextWrapping="Wrap" Margin="0,0,0,4"
                                                           Visibility="{Binding TemperRecipeAbsent, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="⚠ This temper recipe has no ingredients - tempering will be free."
                                                           Foreground="{DynamicResource ColorWarning}"
                                                           TextWrapping="Wrap" Margin="0,0,0,4"
                                                           Visibility="{Binding TemperRecipeMissingIngredients, Converter={StaticResource BoolToVis}}"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <!-- COBJ Origin Key -->
                                                        <RowDefinition Height="Auto" />
                                                        <!-- Workbench -->
                                                        <RowDefinition Height="Auto" />
                                                        <!-- Perk -->
                                                    </Grid.RowDefinitions>

                                                    <!-- COBJ Origin Key -->
                                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                                        Text="COBJ Origin Key: "
                                                        Style="{StaticResource ItemLabelStyle}"
                                                        />
                                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TemperEditorID, Mode=OneWay}"
                                                       Style="{StaticResource CopyableIdentifierStyle}"/>
                                                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource InfoButtonStyle}">
                                                        <Button.ToolTip>
                                                            <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                                <StackPanel>
                                                                    <TextBlock Text="The key of the original temper recipe: MasterPluginName | FormID."
                                                                    Style="{StaticResource ToolTipTitelStyle}"/>
                                                                </StackPanel>
                                                            </ToolTip>
                                                        </Button.ToolTip>
                                                    </Button>

                                                    <!-- Workbench -->

                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Workbench: " Style="{StaticResource ItemLabelStyle}"/>

                                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TemperWorkbenchKey, Mode=OneWay}"
                                                     BorderBrush="{Binding IsTemperWorkbenchDeadRef, Converter={StaticResource BoolToDeadRefBorderConverter}}"
                                                   Style="{StaticResource CopyableIdentifierStyle}"/>
                                                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource InfoButtonStyle}">
                                                        <Button.ToolTip>
                                                            <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                                <StackPanel>
                                                                    <TextBlock Text="Tempering uses only two workbenches: Sharpening Wheel (Weapons), Armor Workbench (Armor). This is handled automatically."
                                                                    Style="{StaticResource ToolTipTitelStyle}"/>
                                                                </StackPanel>
                                                            </ToolTip>
                                                        </Button.ToolTip>
                                                    </Button>
                                                    <!-- Conditions -->
                                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Width="Auto">
                                                        <TextBlock Text="Conditions:" Style="{StaticResource ItemLabelStyle}" />
                                                        <Border BorderBrush="{Binding IsTemperConditionsChanged, Converter={StaticResource BoolToChangedBorderConverter}}"
                                                                BorderThickness="0,0,0,2" Margin="0,0,0,5"
                                                                ToolTip="A colored line here means the Conditions differ from how they looked when this recipe was loaded."/>

                                                        <ItemsControl ItemsSource="{Binding TemperConditions}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,5">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="200" />
                                                                            <!-- Type -->
                                                                            <ColumnDefinition Width="*" />
                                                                            <!-- Target -->
                                                                            <ColumnDefinition Width="*" />
                                                                            <!-- Value -->
                                                                            <ColumnDefinition Width="200" />
                                                                            <!-- RunOn -->
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <!-- Remove -->
                                                                        </Grid.ColumnDefinitions>

                                                                        <!-- Condition Type -->
                                                                        <DockPanel Grid.Column="0" VerticalAlignment="Center">
                                                                            <TextBlock Text="Type:" Style="{StaticResource ItemLabelStyle}" VerticalAlignment="Center" />
                                                                            <ComboBox Grid.Column="0"
                                                                                  ItemsSource="{Binding ConditionTypes}"
                                                                                  SelectedItem="{Binding Type, Mode=TwoWay}"
                                                                                  Style="{StaticResource ItemComboBoxStyle}" />
                                                                        </DockPanel>

                                                                        <!-- Target -->
                                                                        <DockPanel Grid.Column="1" VerticalAlignment="Center">
                                                                            <TextBlock Text="Target:" Style="{StaticResource ItemLabelStyle}" VerticalAlignment="Center" />
                                                                            <ContentControl Content="{Binding}"/>
                                                                        </DockPanel>

                                                                        <!-- Value -->
                                                                        <DockPanel Grid.Column="2" VerticalAlignment="Center">
                                                                            <TextBlock Text="Value:" Style="{StaticResource ItemLabelStyle}" VerticalAlignment="Center" />
                                                                            <TextBox
                                                                                 Text="{Binding ComparisonValue}"
                                                                                 Style="{StaticResource ItemTextBoxStyle}" />
                                                                        </DockPanel>
                                                                        <!-- RunOn -->
                                                                        <DockPanel Grid.Column="3" VerticalAlignment="Center">
                                                                            <TextBlock Text="Run On:" Style="{StaticResource ItemLabelStyle}" VerticalAlignment="Center" />
                                                                            <ComboBox
                                                                                  ItemsSource="{Binding RunOnOptions}"
                                                                                  SelectedItem="{Binding RunOn}"
                                                                                  Style="{StaticResource ItemComboBoxStyle}" />
                                                                        </DockPanel>

                                                                        <!-- Remove -->
                                                                        <Button Grid.Column="4"
                                                                            Command="{Binding DataContext.RemoveTemperConditionCommand,
                                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            Style="{StaticResource RemoveButtonStyle}" 
                                                                            ToolTip="Remove Condition"/>

                                                                        <!-- Read-only condition overlay: covers the whole row for a condition type that is preserved
                                                                             but not editable. The overlay itself lives in Styles/ConditionTemplates.xaml as the
                                                                             template for ReadOnlyConditionViewModel.
                                                                             Content is set by a DataTrigger and left null otherwise - NOT a Visibility toggle on a
                                                                             filled element. Null content means the template is never instantiated for an ordinary
                                                                             condition, so its bindings (Explanation, FunctionName, ...) cannot be evaluated against a
                                                                             view model that has none of them. That was 12 binding errors per editable row. -->
                                                                        <ContentControl Grid.Column="0" Grid.ColumnSpan="5" Panel.ZIndex="10">
                                                                            <ContentControl.Style>
                                                                                <Style TargetType="ContentControl">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Type}" Value="ReadOnly">
                                                                                            <Setter Property="Content" Value="{Binding}"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </ContentControl.Style>
                                                                        </ContentControl>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <Button Command="{Binding AddTemperConditionCommand}"
                                                            Style="{StaticResource AddButtonStyle}"
                                                            ToolTip="Add Condition" />
                                                    </StackPanel>
                                                </Grid>
                                                <Border BorderBrush="{Binding IsTemperIngredientsChanged, Converter={StaticResource BoolToChangedBorderConverter}}"
                                                        BorderThickness="0,0,0,2" Margin="0,5,0,5"
                                                        ToolTip="A colored line here means the Ingredients list differs from how it looked when this recipe was loaded."/>
                                                <ItemsControl ItemsSource="{Binding TemperIngredients}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,5">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="60" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <ComboBox Grid.Column="0"
                                                            ItemsSource="{Binding LocalMaterialsView}"
                                                            SelectedItem="{Binding SelectedMaterial}" IsSynchronizedWithCurrentItem="False" BorderBrush="{Binding IsDeadReference, Converter={StaticResource BoolToDeadRefBorderConverter}}"
                                                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                            ToolTip="{Binding Key}"
                                                            DisplayMemberPath="Name"
                                                            IsEditable="True"
                                                            IsTextSearchEnabled="False"
                                                            StaysOpenOnEdit="True"
                                                            Style="{StaticResource ItemComboBoxStyle}"/>

                                                                <TextBox Grid.Column="1"
                                                           TextAlignment="Center"
                                                           Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}"
                                                                 model:NumericTextBoxBehavior.Mode="Integer"
                                                                 model:NumericTextBoxBehavior.Min="1"
                                                           Style="{StaticResource ItemTextBoxStyle}"/>

                                                                <Button Grid.Column="2"
                                                            ToolTip="Remove Material"
                                                            Command="{Binding DataContext.RemoveTemperIngredientCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource RemoveButtonStyle}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button
                                                Command="{Binding AddTemperIngredientCommand}"
                                                ToolTip="Add Material/Recipe"
                                                Style="{StaticResource AddButtonStyle}"/>
                                            </StackPanel>
                                        </GroupBox>
                                    </Expander>
                                    <!-- Breakdown: recipes that CONSUME this item.
                                         Read-only for now; editing and creating comes next. -->
                                    <Expander Grid.Row="6" Style="{StaticResource DarkExpanderStyle}" IsExpanded="False">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Breakdown"/>
                                                <Button Content="other recipes"
                                                        Margin="8,0,0,0"
                                                        Command="{Binding ShowOtherRecipesCommand}"
                                                        CommandParameter="Breakdown"
                                                        ToolTip="This item has more than one breakdown recipe. Choose which one the editor shows, or take one out."
                                                        Visibility="{Binding HasOtherBreakdownRecipes, Converter={StaticResource BoolToVis}}"
                                                        Style="{StaticResource StandardButtonStyle}"/>
                                                <TextBlock Style="{StaticResource ChangedDotStyle}"
                                                           ToolTip="The breakdown recipe was changed or newly created."
                                                           Visibility="{Binding HasBreakdownChanges, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </Expander.Header>
                                        <GroupBox Style="{StaticResource DarkGroupBoxStyle}"
                                                  Margin="0,15,0,0"
                                                  Padding="10">
                                            <GroupBox.Header>
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock Text="Used up by" Style="{StaticResource TitelStyle}"/>
                                                    <!-- Reset sits on the recipe, not on the item: the section edits one
                                                         record, and "Reset ALL" on the item reverts every breakdown
                                                         recipe including the ones not on screen. -->
                                                    <Button DockPanel.Dock="Right"
                                                            Content="Reset Changes"
                                                            Command="{Binding BreakdownRecipe.ResetCommand}"
                                                            IsEnabled="{Binding HasBreakdownChanges}"
                                                            ToolTip="Revert this breakdown recipe to its scanned state (a recipe created here is removed)"
                                                            Style="{StaticResource ActionButtonStyle}"/>
                                                    <Button Margin="10,0,0,0" Style="{StaticResource InfoButtonStyle}">
                                                        <Button.ToolTip>
                                                            <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                                <StackPanel>
                                                                    <TextBlock Text="Recipes that consume this item instead of creating it."
                                                                               Style="{StaticResource ToolTipTitelStyle}"/>
                                                                    <TextBlock Text="•  Breakdown: melting it down at the smelter or the tanning rack."
                                                                               Style="{StaticResource ToolTipTextStyle}"/>
                                                                    <TextBlock Text="•  Other benches mean a recipe that turns this item into another one."
                                                                               Style="{StaticResource ToolTipTextStyle}"/>
                                                                    <TextBlock Text="•  Vanilla has none of these for armour and weapons - they come from mods such as CCOR or Ars Metallica."
                                                                               Style="{StaticResource ToolTipTextStyle}"/>
                                                                    <TextBlock Text="•  Read-only for now."
                                                                               Style="{StaticResource ToolTipTextStyle}"/>
                                                                </StackPanel>
                                                            </ToolTip>
                                                        </Button.ToolTip>
                                                    </Button>
                                                </DockPanel>
                                            </GroupBox.Header>

                                            <StackPanel>
                                                <TextBlock Text="This item cannot be broken down."
                                                           Foreground="{DynamicResource ColorTextTertiary}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding BreakdownRecipeAbsent, Converter={StaticResource BoolToVis}}"/>

                                                <!-- ONE recipe, like Crafting and Temper. Swapping which one is
                                                     shown and deleting the others is the planned multi-recipe
                                                     window, which covers every recipe type at once. -->
                                                <ContentControl Content="{Binding BreakdownRecipe}"
                                                                Visibility="{Binding HasBreakdownRecipe, Converter={StaticResource BoolToVis}}">
                                                    <ContentControl.ContentTemplate>
                                                        <DataTemplate>
                                                            <StackPanel>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="150"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="60"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- NO local Margin on any of these. ItemComboBoxStyle and
                                                                         ItemTextBoxStyle both carry Margin="0,0,5,5", and
                                                                         overriding it per element with "0,0,8,0" dropped the
                                                                         BOTTOM 5px on some but not others - which is exactly
                                                                         what made the row look staggered. Horizontal spacing
                                                                         comes from the column definitions instead. -->
                                                                    <ComboBox Grid.Column="0"
                                                                              VerticalAlignment="Center"
                                                                              ItemsSource="{Binding AvailableBenches}"
                                                                              DisplayMemberPath="Name"
                                                                              SelectedItem="{Binding SelectedBench, Mode=TwoWay}"
                                                                              IsSynchronizedWithCurrentItem="False"
                                                                              Style="{StaticResource ItemComboBoxStyle}"/>

                                                                    <TextBlock Grid.Column="1" Text="gives"
                                                                               Margin="0,0,5,5"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource ColorTextTertiary}"/>

                                                                    <!-- The output: the same material + amount pair the Crafting
                                                                         and Temper sections use for their ingredients, read as
                                                                         the result instead of as a cost - same order, same
                                                                         column widths, same behaviour attributes. Always
                                                                         exactly one: a COBJ creates one KIND of object. -->
                                                                    <ComboBox Grid.Column="2"
                                                                              VerticalAlignment="Center"
                                                                              IsEditable="True"
                                                                              IsTextSearchEnabled="False"
                                                                              StaysOpenOnEdit="True"
                                                                              IsSynchronizedWithCurrentItem="False"
                                                                              ItemsSource="{Binding Output.LocalMaterialsView}"
                                                                              DisplayMemberPath="Name"
                                                                              ToolTip="{Binding Output.Key}"
                                                                              BorderBrush="{Binding Output.IsDeadReference, Converter={StaticResource BoolToDeadRefBorderConverter}}"
                                                                              Text="{Binding Output.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                                              SelectedItem="{Binding Output.SelectedMaterial, Mode=TwoWay}"
                                                                              Style="{StaticResource ItemComboBoxStyle}"/>

                                                                    <TextBox Grid.Column="3"
                                                                             VerticalAlignment="Center"
                                                                             TextAlignment="Center"
                                                                             Text="{Binding Output.Count, UpdateSourceTrigger=PropertyChanged}"
                                                                             model:NumericTextBoxBehavior.Mode="Integer"
                                                                             model:NumericTextBoxBehavior.Min="1"
                                                                             Style="{StaticResource ItemTextBoxStyle}"/>

                                                                    <Button Grid.Column="4"
                                                                            VerticalAlignment="Center"
                                                                            Command="{Binding DeleteCommand}"
                                                                            ToolTip="Remove this recipe (only possible for recipes this tool created)"
                                                                            Visibility="{Binding IsUserCreated, Converter={StaticResource BoolToVis}}"
                                                                            Style="{StaticResource RemoveButtonStyle}"/>
                                                                </Grid>

                                                                <!-- Only when the recipe really has further inputs. Bound via
                                                                     its own flag rather than StringFormat, which renders the
                                                                     " + " separator even for an empty string - that stray
                                                                     plus was visible in the first build. -->
                                                                <TextBlock Text="{Binding OtherIngredients}"
                                                                           Margin="0,4,0,0"
                                                                           TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource ColorTextTertiary}"
                                                                           Visibility="{Binding HasOtherIngredients, Converter={StaticResource BoolToVis}}"/>

                                                                <TextBlock Text="No output picked yet — this recipe is skipped when the patch is generated."
                                                                           Margin="0,4,0,0"
                                                                           TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource ColorTextTertiary}"
                                                                           Visibility="{Binding IsIncomplete, Converter={StaticResource BoolToVis}}"/>

                                                                <!-- Conditions. Vanilla smelter recipes have none; mods hang a
                                                                     HasPerk on theirs, and without this they were invisible on
                                                                     a recipe this section otherwise owns completely. -->
                                                                <StackPanel Margin="0,8,0,0">
                                                                    <TextBlock Text="Conditions:" Style="{StaticResource ItemLabelStyle}"/>
                                                                    <Border BorderBrush="{Binding AreConditionsChanged, Converter={StaticResource BoolToChangedBorderConverter}}"
                                                                            BorderThickness="0,0,0,2" Margin="0,0,0,5"
                                                                            ToolTip="A colored line here means the Conditions differ from how they looked when this recipe was loaded."/>

                                                                    <ItemsControl ItemsSource="{Binding Conditions}"
                                                                                  ItemTemplate="{StaticResource ConditionRowTemplate}"/>

                                                                    <Button Command="{Binding AddConditionCommand}"
                                                                            ToolTip="Add Condition"
                                                                            Style="{StaticResource AddButtonStyle}"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ContentControl.ContentTemplate>
                                                </ContentControl>

                                                <!-- IsEnabled, not CanExecute: this project's RelayCommand never
                                                     raises CanExecuteChanged, so a command-driven state would
                                                     stay at whatever it was when the panel was first drawn. -->
                                                <!-- No HorizontalAlignment, like every other "+" in this view: the
                                                     style sets a fixed Width, and a fixed size under the default
                                                     Stretch centres the element. Setting Left here was what made
                                                     this one sit off to the side. -->
                                                <Button Command="{Binding AddBreakdownRecipeCommand}"
                                                        IsEnabled="{Binding BreakdownRecipeAbsent}"
                                                        ToolTip="Add a breakdown recipe"
                                                        Margin="0,10,0,0"
                                                        Style="{StaticResource AddButtonStyle}"/>
                                            </StackPanel>
                                        </GroupBox>
                                    </Expander>

                                    <!-- Container Section -->
                                    <Expander Grid.Row="7" Style="{StaticResource DarkExpanderStyle}" IsExpanded="False">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Container"/>
                                                <TextBlock Style="{StaticResource ChangedDotStyle}"
                                                           ToolTip="The container / leveled-list placement differs from the scanned one."
                                                           Visibility="{Binding IsContainerChanged, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </Expander.Header>
                                        <GroupBox
                                          Style="{StaticResource DarkGroupBoxStyle}"
                                          Margin="0,15,0,0"
                                          Padding="10">

                                        <GroupBox.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Container"
                                                       Style="{StaticResource TitelStyle}"/>

                                                <Button Margin="10,0,0,0"  Style="{StaticResource InfoButtonStyle}">
                                                    <Button.ToolTip>
                                                        <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                            <StackPanel>
                                                                <TextBlock Text="Shows where the item can appear in containers or merchant inventories."
                                                                    Style="{StaticResource ToolTipTitelStyle}"/>

                                                                <StackPanel>
                                                                    <TextBlock Text="•  Click to select, click again to unselect."
                                                                            Style="{StaticResource ToolTipTextStyle}"/>
                                                                    <TextBlock Text="•  A Container can be a chest, NPC inventory, or merchant."
                                                                            Style="{StaticResource ToolTipTextStyle}"/>
                                                                    <TextBlock Text="•  Standard View: Only merchants are shown."
                                                                            Style="{StaticResource ToolTipTextStyle}"/>
                                                                    <TextBlock Text="•  Expert View: All containers in your modlist are displayed."
                                                                            Style="{StaticResource ToolTipTextStyle}"/>
                                                                    <TextBlock Text="Selecting a container shows its details on the right side."
                                                                            Style="{StaticResource ToolTipTextStyle}"/>
                                                                    <TextBlock Text="If the container uses Leveled Item Lists, you can add the item there as well."
                                                                            Style="{StaticResource ToolTipTextStyle}"/>
                                                                    <TextBlock Text="Use the level slider to define at which player level the item becomes available."
                                                                            Style="{StaticResource ToolTipTextStyle}"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </Button.ToolTip>
                                                </Button>

                                            </StackPanel>
                                        </GroupBox.Header>

                                        <!-- The panel itself now lives in Styles/ContainerPlacementPanel.xaml -
                                             the placement sub-tabs of the Container/LeveledList tab need the
                                             same one, and a second copy is a mistake this project has already
                                             paid for three times (condition templates, preset recipe block,
                                             leveled-list row).

                                             Its DataContext is this VIEW MODEL, not the item. The panel reaches
                                             nine members of MainContentVM plus the item itself, and it used to
                                             do that through RelativeSource AncestorType=UserControl - a route
                                             that silently resolves to whatever view hosts it. Passed in once
                                             here instead; the item is reached through PlacementTarget. -->
                                        <ContentPresenter Content="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          ContentTemplate="{StaticResource ContainerPlacementPanelTemplate}"/>
                                    </GroupBox>
                                    </Expander>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </DataTemplate>


                    <!-- PLUGIN-DETAIL -->
                    <DataTemplate DataType="{x:Type local:PluginNodeVM}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="20">
                                <TextBlock Text="{Binding PluginName}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource ColorHeadingAccent}"
                                           Margin="0,0,0,20" />

                                <!-- Same simple Preset row as the single-item detail view above -
                                     Apply here runs the preset against every item in this plugin. -->
                                <DockPanel LastChildFill="False" Margin="0,0,0,15">
                                    <ComboBox ItemsSource="{Binding ConfigPresets}"
                                              SelectedItem="{Binding SelectedConfigPreset}"
                                              DisplayMemberPath="PresetName"
                                              Width="180"
                                              Style="{StaticResource ItemComboBoxStyle}"/>
                                    <Button Content="Apply"
                                            Command="{Binding ApplyPresetCommand}"
                                            Style="{StaticResource StandardButtonStyle}"/>

                                    <Button Content="Export"
                                        Command="{Binding ExportPluginCommand}"
                                        Style="{StaticResource ActionButtonStyle}"/>
                                    <Button Content="Import"
                                        Command="{Binding ImportPluginCommand}"
                                        Style="{StaticResource ActionButtonWarmStyle}"/>

                                    <!-- The way back from the Apply on the left. Every button in this
                                         row covers the whole plugin, never the filtered view - both
                                         confirmation dialogs spell that out (see PluginNodeVM). -->
                                    <Button Content="Reset edited"
                                        Margin="10,0,5,5"
                                        Command="{Binding ResetPluginCommand}"
                                        Style="{StaticResource StandardButtonStyle}">
                                        <Button.ToolTip>
                                            <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="Reverts EVERYTHING - fields, crafting recipes and temper recipes - on every edited item in this plugin, back to the scanned state. Covers the whole plugin regardless of any active tree filter, and asks for confirmation with the exact item count first."
                                                        Style="{StaticResource ToolTipTitelStyle}"/>
                                                </StackPanel>
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>
                                </DockPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </DataTemplate>

                </ContentPresenter.Resources>
            </ContentPresenter>

            <!-- Border carries the Visibility (still binds against MainContentVM); DataContext only
                 switches over on the child element - otherwise IsMultiSelectActive would resolve
                 against MultiSelectVM instead of MainContentVM and the binding would come up empty. -->
            <Border Visibility="{Binding IsMultiSelectActive, Converter={StaticResource BoolToVis}}">
                <views:MultiSelectDetailView DataContext="{Binding MultiSelectVM}"/>
            </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
