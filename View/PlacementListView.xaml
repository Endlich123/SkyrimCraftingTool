<UserControl x:Class="SkyrimCraftingTool.View.PlacementListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SkyrimCraftingTool.ViewModel">

    <UserControl.Resources>
        <!-- A LEAF of the tree on the left: one placeable record. The tree around it is
             Styles/PluginTreeTemplate.xaml, shared with the containers/lists pane; this is the part
             that differs, so it lives here and is picked by the row's type. -->
        <DataTemplate DataType="{x:Type vm:PlaceableRowVM}">
            <!-- ONE LINE, like the containers/lists tree next door: the key used to sit underneath
                 and doubled the height of every row for an identifier nobody reads while scrolling.
                 It is named on the right once a record is picked.

                 IsHitTestVisible on the content, so the click lands on the TreeViewItem and reaches
                 the Ctrl/Shift behaviour. -->
            <Border x:Name="PickHighlight" Background="Transparent" Padding="2"
                    ToolTip="{Binding Key}">
                <TextBlock Text="{Binding Display}"
                           IsHitTestVisible="False"
                           Foreground="{DynamicResource ColorTreeLeaf}"
                           TextTrimming="CharacterEllipsis"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPicked}" Value="True">
                    <Setter TargetName="PickHighlight" Property="Background"
                            Value="{DynamicResource ColorBackgroundHighlight}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <!-- One placement sub-tab: pick a record on the left, place it on the right.
         The right-hand side is Styles/ContainerPlacementPanel.xaml - the very panel the item editor
         uses, with this view model as its host. -->
    <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <TextBox DockPanel.Dock="Top"
                     Text="{Binding RowSearch, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource ItemTextSearchBoxStyle}"
                     Margin="0,0,0,6"
                     ToolTip="Filter by name or FormID."/>

            <TextBlock DockPanel.Dock="Bottom"
                       Text="{Binding RowCountText}"
                       Foreground="{DynamicResource ColorTextTertiary}"
                       FontSize="10" Margin="2,4,0,0"/>

            <!-- Plugin, and the records under it - the same two levels as the container tree next
                 door, and the same markup: Styles/PluginTreeTemplate.xaml. What stays here is the
                 LEAF, in this view's resources.

                 ARMOR AND WEAPONS SHOW ItemNodeVM INSTANCES THE ITEM TREE ALSO HOLDS, so the leaves
                 must not carry the selection: a TreeViewItem.IsSelected bound to the node would tie
                 this tree's cursor to the item tab's. The pick lives on PlaceableRowVM instead. -->
            <TreeView ItemsSource="{Binding FilteredTree}"
                      Style="{StaticResource PluginTreeStyle}"/>
        </DockPanel>

        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top"
                       Text="Pick a record on the left to place it. Ctrl or Shift picks several."
                       Visibility="{Binding HasNoSelection, Converter={StaticResource BoolToVis}}"
                       Foreground="{DynamicResource ColorTextTertiary}"/>

            <!-- WHICH RECORD THIS IS. The tree used to carry the key under every row; it belongs
                 here, with the name, where it is read once - and the panel below never said what it
                 was placing at all. -->
            <StackPanel DockPanel.Dock="Top"
                        Visibility="{Binding HasNamedTarget, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,0,8">
                <TextBlock Text="{Binding TargetName}"
                           FontSize="16"
                           Foreground="{DynamicResource ColorAccentLight}"
                           TextTrimming="CharacterEllipsis"/>
                <!-- Selectable: a key is read to be copied. See CopyableIdentifierStyle. -->
                <TextBox Text="{Binding TargetKey, Mode=OneWay}"
                         Style="{StaticResource CopyableIdentifierStyle}"
                         Background="Transparent" BorderThickness="0"
                         Padding="0" Margin="0"
                         HorizontalAlignment="Left"
                         FontSize="11"/>
            </StackPanel>

            <!-- Several records picked: the panel below is editing a TEMPLATE, not a record, and
                 nothing is written until Apply. Said here rather than left to be inferred - the
                 panel looks identical either way, which is the point of reusing it, and that is
                 exactly why the difference has to be on screen. -->
            <Border DockPanel.Dock="Top"
                    Visibility="{Binding IsBulk, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource ColorBackgroundControl}"
                    BorderBrush="{DynamicResource ColorAccentLight}"
                    BorderThickness="1"
                    Padding="8,5" Margin="0,0,0,8">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="{Binding PickCountText}"
                                   Foreground="{DynamicResource ColorAccentLight}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <Button DockPanel.Dock="Right"
                                Content="Clear pick"
                                Command="{Binding ClearPickCommand}"
                                Style="{StaticResource StandardButtonStyle}"
                                ToolTip="Drops the selection. Nothing that was already applied is undone."/>

                        <Button DockPanel.Dock="Right"
                                Content="Apply to picked"
                                Command="{Binding ApplyToPickedCommand}"
                                Style="{StaticResource StandardButtonStyle}"
                                ToolTip="Adds the containers below to every picked record. Their levels replace whatever those records had for the same container."/>
                    </DockPanel>

                    <TextBlock Text="Additive: the containers below are ADDED to what each picked record already has. Only the levels of a container named here replace that record's own."
                               Foreground="{DynamicResource ColorTextTertiary}"
                               FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>

                    <TextBlock Text="{Binding BulkStatus}"
                               Foreground="{DynamicResource ColorTextSecondary}"
                               FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <!-- The host is THIS view model, which is why the panel's bindings resolve: it answers
                 the same nine members MainContentVM does. With several records picked it is handed
                 the template instead of a record - see PlacementListVM.PlacementTarget. -->
            <ContentPresenter Content="{Binding}"
                              ContentTemplate="{StaticResource ContainerPlacementPanelTemplate}"
                              Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}"/>
        </DockPanel>
    </Grid>
</UserControl>
