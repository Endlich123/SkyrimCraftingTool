<UserControl x:Class="SkyrimCraftingTool.View.SpellMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SkyrimCraftingTool.ViewModel"
             xmlns:views="clr-namespace:SkyrimCraftingTool.View">

    <Grid Margin="10">
        <!-- The same three columns as the Items and Enchantments tabs: a resizable tree with a
             floor under it, the splitter, the detail panel. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" MinWidth="150"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,8"
                   views:Tutorial.Id="spells.toolbar">
            <!-- Records of the user's own. They appear under the tool's own plugin in the tree and
                 reach the game through the generated ESP. -->
            <Button DockPanel.Dock="Left" Content="New spell"
                    Command="{Binding NewSpellCommand}"
                    Style="{StaticResource ActionButtonGreenStyle}"
                    Margin="0,0,8,0"
                    ToolTip="Creates an empty spell of your own. Give it at least one effect — a spell without any is not written to the ESP."/>

            <Button DockPanel.Dock="Left" Content="Delete spell"
                    Command="{Binding DeleteSpellCommand}"
                    Style="{StaticResource ActionButtonWarmStyle}"
                    Margin="0,0,12,0"
                    Visibility="{Binding CanDeleteSelected, Converter={StaticResource BoolToVis}}"
                    ToolTip="Removes this spell and its effects. Only offered for records you created here — a scanned spell belongs to its plugin."/>

            <Button DockPanel.Dock="Left" Content="Export"
                    Command="{Binding ImportExport.ExportCommand}"
                    Style="{StaticResource ActionButtonStyle}"
                    Margin="0,0,6,0"
                    ToolTip="Write every edited spell and every spell you created to Output\Exports\Spells, one JSON file each."/>
            <Button DockPanel.Dock="Left" Content="Import"
                    Command="{Binding ImportExport.ImportCommand}"
                    Style="{StaticResource ActionButtonWarmStyle}"
                    Margin="0,0,12,0"
                    ToolTip="Read the spell export files from Output\Exports\Spells and apply them (conflicts are resolved per spell). Spells you created are matched by identity, so one never overwrites a different spell of yours."/>

            <TextBlock VerticalAlignment="Center"
                       Foreground="{DynamicResource ColorTextSecondary}"
                       Text="{Binding Summary}"/>
        </DockPanel>

        <!-- LEFT: tree + search -->
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBox Grid.Row="0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                     Tag="Search..."
                     Background="{DynamicResource ColorBackgroundControl}"
                     Foreground="{DynamicResource ColorTextPrimary}"
                     BorderBrush="{DynamicResource ColorBorder}"
                     Padding="5"
                     Margin="0,0,0,5"
                     ToolTip="Matches the editor ID, the display name and the Plugin|FormID key."/>

            <DockPanel Grid.Row="1" Margin="0,0,0,6"
                       views:Tutorial.Id="spells.filters">
                <Button DockPanel.Dock="Right" Content="Collapse"
                        Command="{Binding CollapseAllCommand}"
                        Style="{StaticResource StandardButtonStyle}"
                        Margin="4,0,0,0"/>
                <CheckBox Content="Only edited"
                          IsChecked="{Binding OnlyEdited}"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource ColorTextSecondary}"/>
            </DockPanel>

            <TreeView Grid.Row="2"
                      x:Name="SpellTreeView"
                      views:Tutorial.Id="spells.tree"
                      ItemsSource="{Binding FilteredTree}"
                      VirtualizingPanel.IsVirtualizing="True"
                      SelectedItemChanged="TreeView_SelectedItemChanged"
                      Background="{DynamicResource ColorBackgroundBase}"
                      Foreground="{DynamicResource ColorTextPrimary}">

                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="Padding" Value="2"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                    </Style>
                </TreeView.ItemContainerStyle>

                <!-- One implicit template per node type, picked by DataType. That is what the node
                     split is for: a single class told apart by DataTriggers on a null check gives
                     WPF nothing to dispatch on. -->
                <TreeView.Resources>

                    <HierarchicalDataTemplate DataType="{x:Type vm:SpellPluginNode}"
                                              ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource ColorTreeRoot}"/>
                            <TextBlock Style="{StaticResource ChangedDotStyle}"
                                       Visibility="{Binding HasEditedDescendant, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>

                    <HierarchicalDataTemplate DataType="{x:Type vm:SpellTypeNode}"
                                              ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}"
                                       Foreground="{DynamicResource ColorTreeBranch}"/>
                            <TextBlock Style="{StaticResource ChangedDotStyle}"
                                       Visibility="{Binding HasEditedDescendant, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>

                    <!-- A spell. No ItemsSource - the tree ends here. -->
                    <DataTemplate DataType="{x:Type vm:SpellLeafNode}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="●"
                                       Foreground="{DynamicResource ColorWarning}"
                                       Margin="0,0,4,0"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Spell.IsEdited}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- A record this table cannot hold whole. Marked in the TREE, not only
                                 in the panel, so it is visible without clicking each one. -->
                            <TextBlock Text="⚠"
                                       Foreground="{DynamicResource ColorWarning}"
                                       Margin="0,0,4,0"
                                       VerticalAlignment="Center"
                                       ToolTip="This spell names the same magic effect more than once. Only one of those entries is stored — see the detail panel.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Spell.HasDroppedEffectRows}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Bound to the RECORD, not the node's DisplayName: that is a copy taken
                                 when the tree was built, so a rename would show up only after a
                                 rebuild. -->
                            <TextBlock Text="{Binding Spell.Label}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource ColorTreeLeaf}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Spell.IsEdited}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="{DynamicResource ColorWarning}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>

                </TreeView.Resources>
            </TreeView>
        </Grid>

        <GridSplitter Grid.Row="1" Grid.Column="1"
                      Width="5" HorizontalAlignment="Stretch"
                      Background="{DynamicResource ColorBorder}"/>

        <!-- RIGHT: the selected record -->
        <Border Grid.Row="1" Grid.Column="2"
                Background="{DynamicResource ColorBackgroundPanel}"
                BorderBrush="{DynamicResource ColorBorder}"
                BorderThickness="1" Padding="12">
            <Grid>
                <TextBlock Text="Select a spell on the left."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource ColorTextMuted}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedSpell.Label}"
                                   Style="{StaticResource TitelStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SelectedSpell.Key}" FontSize="11" Margin="0,0,0,10"
                                   Foreground="{DynamicResource ColorTextTertiary}"/>

                        <!-- The honest warning. 938 spells in a real load order are in this state and
                             401 of them lose a genuinely different value, so a panel that showed
                             their effects as complete would be making a claim it cannot support. -->
                        <Border Background="{DynamicResource ColorSurfaceWarn}"
                                BorderBrush="{DynamicResource ColorBorderLight}"
                                BorderThickness="1" CornerRadius="3"
                                Padding="8,5" Margin="0,0,0,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSpell.HasDroppedEffectRows}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock TextWrapping="Wrap" FontSize="11"
                                       Foreground="{DynamicResource ColorTextSecondary}">
                                <Run Text="This spell lists the same magic effect more than once."/>
                                <Run Text="{Binding SelectedSpell.DroppedEffectRows, Mode=OneWay}"/>
                                <Run Text="of its entries are not shown. SkyPatcher addresses an effect by its key and cannot tell two entries of the same effect apart either, so those entries are not patchable — in xEdit the record will look richer than it does here."/>
                            </TextBlock>
                        </Border>


                        <!-- BASIC INFO, as an expander like every other detail panel in the tool.
                             A collapsed section must still admit that something inside it changed -
                             the amber borders on the fields are invisible while it is shut - hence
                             the same dot the tree uses. -->
                        <Expander Style="{StaticResource DarkExpanderStyle}" IsExpanded="True" Margin="0,0,0,10"
                                  views:Tutorial.Id="spells.basic">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Basic Info"/>
                                    <TextBlock Style="{StaticResource ChangedDotStyle}"
                                               ToolTip="This section contains changes — one or more fields differ from the scanned record."
                                               Visibility="{Binding DataContext.SelectedFieldsEdited, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Expander.Header>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="Reset fields"
                                            Command="{Binding ResetFieldsCommand}"
                                            Style="{StaticResource StandardButtonStyle}"
                                            Visibility="{Binding SelectedFieldsEdited, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Puts the record's own fields back to what the scan found. Leaves the effects alone — they have their own Reset."/>
                                </StackPanel>

                                <!-- EDITABLE WHERE SkyPatcher HAS AN OPERATION, read-only where it
                                     has none. The read-only rows are not an oversight:
                                     docs/Spell_Patcher.txt documents no targetType, no spell type,
                                     no range and no cast duration, so a box there would take a
                                     value that could never reach the game. Each ? says which of the
                                     two a row is. -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Key"
                                               Style="{StaticResource ItemLabelStyle}"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedSpell.Key, Mode=OneWay}"
                                             Style="{StaticResource CopyableIdentifierStyle}"/>
                                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource InfoButtonStyle}">
                                        <Button.ToolTip>
                                            <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                <TextBlock Style="{StaticResource ToolTipTitelStyle}" TextWrapping="Wrap"
                                                           Text="Plugin and FormID — how every rule in the patch names this record. Not editable: it is the record's identity."/>
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="EditorID"
                                               Style="{StaticResource ItemLabelStyle}"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedSpell.EditorID, Mode=OneWay}"
                                             Style="{StaticResource CopyableIdentifierStyle}"
                                               Visibility="{Binding IsScannedSelected, Converter={StaticResource BoolToVis}}"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding UserEditorId}"
                                             Style="{StaticResource ItemTextBoxStyle}"
                                             Visibility="{Binding IsUserCreatedSelected, Converter={StaticResource BoolToVis}}"/>
                                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource InfoButtonStyle}">
                                        <Button.ToolTip>
                                            <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                <TextBlock Style="{StaticResource ToolTipTitelStyle}" TextWrapping="Wrap"
                                                           Text="The name xEdit and the Creation Kit list this record under. Editable only on a spell you created here — a scanned record's editor ID belongs to its plugin, and SkyPatcher has no operation to change it."/>
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Name"
                                               Style="{StaticResource ItemLabelStyle}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedSpell.Name}"
                                             BorderBrush="{Binding IsNameEdited, Converter={StaticResource BoolToChangedBorderConverter}}"
                                             Style="{StaticResource ItemTextBoxStyle}"/>
                                    <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource InfoButtonStyle}">
                                        <Button.ToolTip>
                                            <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                <TextBlock Style="{StaticResource ToolTipTitelStyle}" TextWrapping="Wrap"
                                                           Text="The name shown in the magic menu. Patched with fullName. A name containing ~ or : cannot be written — SkyPatcher uses both as separators — and such a change is reported instead of applied."/>
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>

                                    <!-- WHERE THE GAME FILES IT, which is also the tree branch. A SPEL
                                         has no school field: a plain spell takes the school of its
                                         costliest effect, everything else is filed by its spell type
                                         (Services/SpellCategory). Derived, never stored. -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Filed under"
                                               Style="{StaticResource ItemLabelStyle}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedSpell.CategoryLabel, Mode=OneWay}"
                                               Margin="5" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource InfoButtonStyle}">
                                        <Button.ToolTip>
                                            <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource ToolTipTitelStyle}" TextWrapping="Wrap"
                                                               Text="Where the game's magic menu lists this spell."/>
                                                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                                               Text="A plain spell is filed under the school of its COSTLIEST effect, with that effect's skill tier. A spell record has no school of its own - the school belongs to the magic effect. 'No school' means the costliest effect has none; the game then shows the spell only under 'All'."/>
                                                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                                               Text="Powers and lesser powers go to Powers, shout words to Shouts, abilities never appear in the menu (they are active effects), and diseases, poisons and addictions likewise - whatever their effects' schools are."/>
                                                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                                               Text="Not editable here. Changing a school means changing the shared magic effect, which would change it in every spell and enchantment that uses it."/>
                                                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                                               Text="Shouts: each word is its own spell and is edited here like any other. The shout's cooldown and word order belong to the shout record, which SkyPatcher's spell patcher cannot change."/>
                                                </StackPanel>
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Spell type"
                                               Style="{StaticResource ItemLabelStyle}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedSpell.SpellType}"
                                               Margin="5" VerticalAlignment="Center"
                                               Visibility="{Binding IsScannedSelected, Converter={StaticResource BoolToVis}}"/>
                                    <ComboBox Grid.Row="4" Grid.Column="1"
                                              ItemsSource="{Binding SpellTypeChoices}"
                                              SelectedItem="{Binding UserSpellType}"
                                              Style="{StaticResource CompactComboBoxStyle}"
                                              Margin="0,0,5,5"
                                              Visibility="{Binding IsUserCreatedSelected, Converter={StaticResource BoolToVis}}"/>
                                    <Button Grid.Row="4" Grid.Column="2" Style="{StaticResource InfoButtonStyle}">
                                        <Button.ToolTip>
                                            <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                <TextBlock Style="{StaticResource ToolTipTitelStyle}" TextWrapping="Wrap"
                                                           Text="Spell, Ability, Power, LesserPower, Voice, Disease, Poison or Addiction. Read-only on a scanned record: SkyPatcher has no operation for it, and the tree is grouped by it. On a spell you created here the generated ESP writes it from scratch, so it can be set."/>
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Cast type"
                                               Style="{StaticResource ItemLabelStyle}"/>
                                    <ComboBox Grid.Row="5" Grid.Column="1"
                                              ItemsSource="{Binding CastTypeChoices}"
                                              SelectedItem="{Binding SelectedSpell.CastType}"
                                              Style="{StaticResource CompactComboBoxStyle}"
                                              Margin="0,0,5,5"/>
                                    <Button Grid.Row="5" Grid.Column="2" Style="{StaticResource InfoButtonStyle}">
                                        <Button.ToolTip>
                                            <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                <TextBlock Style="{StaticResource ToolTipTitelStyle}" TextWrapping="Wrap"
                                                           Text="How the spell is delivered: ConstantEffect (always on), FireAndForget (one-shot), Concentration (channelled) or Scroll. The four values SkyPatcher's castType operation accepts."/>
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Target type"
                                               Style="{StaticResource ItemLabelStyle}"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedSpell.TargetType}"
                                               Margin="5" VerticalAlignment="Center"
                                               Visibility="{Binding IsScannedSelected, Converter={StaticResource BoolToVis}}"/>
                                    <ComboBox Grid.Row="6" Grid.Column="1"
                                              ItemsSource="{Binding TargetTypeChoices}"
                                              SelectedItem="{Binding UserTargetType}"
                                              Style="{StaticResource CompactComboBoxStyle}"
                                              Margin="0,0,5,5"
                                              Visibility="{Binding IsUserCreatedSelected, Converter={StaticResource BoolToVis}}"/>
                                    <Button Grid.Row="6" Grid.Column="2" Style="{StaticResource InfoButtonStyle}">
                                        <Button.ToolTip>
                                            <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                <TextBlock Style="{StaticResource ToolTipTitelStyle}" TextWrapping="Wrap"
                                                           Text="Self, Touch, Aimed, TargetActor or TargetLocation. Read-only on a scanned record: there is no targetType operation in the spell patcher, so an edit could never reach the game."/>
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Base cost"
                                               Style="{StaticResource ItemLabelStyle}"/>
                                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding SelectedSpell.BaseCost}"
                                             BorderBrush="{Binding IsBaseCostEdited, Converter={StaticResource BoolToChangedBorderConverter}}"
                                             Style="{StaticResource ItemTextBoxStyle}"/>
                                    <Button Grid.Row="7" Grid.Column="2" Style="{StaticResource InfoButtonStyle}">
                                        <Button.ToolTip>
                                            <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                <TextBlock Style="{StaticResource ToolTipTitelStyle}" TextWrapping="Wrap"
                                                           Text="The magicka the spell costs. Patched with baseCost. The game recalculates the cost from the effects unless 'Manual cost calculation' below is set, so the two usually belong together."/>
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Charge time"
                                               Style="{StaticResource ItemLabelStyle}"/>
                                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding SelectedSpell.ChargeTime}"
                                             BorderBrush="{Binding IsChargeTimeEdited, Converter={StaticResource BoolToChangedBorderConverter}}"
                                             Style="{StaticResource ItemTextBoxStyle}"/>
                                    <Button Grid.Row="8" Grid.Column="2" Style="{StaticResource InfoButtonStyle}">
                                        <Button.ToolTip>
                                            <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                <TextBlock Style="{StaticResource ToolTipTitelStyle}" TextWrapping="Wrap"
                                                           Text="Seconds the spell must be held before it fires. 0 for an instant one. Patched with chargeTime."/>
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>

                                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Half-cost perk"
                                               Style="{StaticResource ItemLabelStyle}"/>
                                    <StackPanel Grid.Row="9" Grid.Column="1"
                                                views:Tutorial.Id="spells.halfcost">
                                        <!-- A pick from the scanned perks, never free text: halfCostPerk=
                                             takes a perk and nothing else (user, 2026-10-18). Filters
                                             as you type - see SpellPerkPickerVM. -->
                                        <ComboBox DataContext="{Binding HalfCostPerkPicker}"
                                                  ItemsSource="{Binding Options}"
                                                  SelectedItem="{Binding Selected, Mode=TwoWay}"
                                                  Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True"
                                                  IsTextSearchEnabled="False"
                                                  IsSynchronizedWithCurrentItem="False"
                                                  StaysOpenOnEdit="True"
                                                  DisplayMemberPath="Display"
                                                  Margin="0,0,5,5"
                                                  BorderBrush="{Binding IsChanged, Converter={StaticResource BoolToChangedBorderConverter}}"
                                                  Style="{StaticResource ItemComboBoxStyle}"/>
                                        <TextBlock DataContext="{Binding HalfCostPerkPicker}"
                                                   Text="This key names no perk in your load order - pick one from the list, or (none)."
                                                   Foreground="{DynamicResource ColorWarning}"
                                                   FontSize="11" TextWrapping="Wrap" Margin="3,0,0,2"
                                                   Visibility="{Binding IsUnknownKey, Converter={StaticResource BoolToVis}}"/>
                                        <!-- The perk names another school than the one the spell is
                                             filed under - legal, but nearly always a slip. -->
                                        <TextBlock Text="{Binding SelectedSpell.HalfCostPerkMismatch, Mode=OneWay}"
                                                   Foreground="{DynamicResource ColorWarning}"
                                                   FontSize="11" TextWrapping="Wrap" Margin="3,0,0,2"
                                                   Visibility="{Binding SelectedSpell.HasHalfCostPerkMismatch, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                    <Button Grid.Row="9" Grid.Column="2" Style="{StaticResource InfoButtonStyle}">
                                        <Button.ToolTip>
                                            <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                <TextBlock Style="{StaticResource ToolTipTitelStyle}" TextWrapping="Wrap"
                                                           Text="The perk that halves this spell's cost - pick one from the scanned perks, nothing else is offered. It can be SET but not cleared: SkyPatcher documents no form for removing it, so (none) on a scanned spell that has a perk is left alone rather than guessed at."/>
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Flags" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ColorTextSecondary}"/>
                                    <Button Margin="8,0,0,0" Style="{StaticResource InfoButtonStyle}">
                                        <Button.ToolTip>
                                            <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource ToolTipTitelStyle}" TextWrapping="Wrap"
                                                               Text="The SPIT flags SkyPatcher can switch, by name."/>
                                                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                                               Text="'Manual cost calculation' is the one to know: without it the game ignores the stored base cost and recomputes it from the effects."/>
                                                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                                               Text="SkyPatcher's flag names differ from the record format's own — costoverride is ManualCostCalc, ignoreloscheck is AreaEffectIgnoresLOS — so the names here are the ones the patch actually writes."/>
                                                </StackPanel>
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>
                                </StackPanel>

                                <!-- One switch per flag SkyPatcher can NAME. setFlags/removeFlags
                                     work by name, so a switch for a bit nobody names would be a
                                     control that does nothing - those are reported below instead. -->
                                <ItemsControl ItemsSource="{Binding FlagVMs}" Margin="0,0,0,6"
                                              views:Tutorial.Id="spells.flags">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSet}"
                                                      Content="{Binding Label}"
                                                      Margin="0,2"
                                                      Foreground="{DynamicResource ColorTextPrimary}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- The bits nothing names. Measured over a real load order, 0x10000,
                                     0x40000 and 0x400000 are set on 415 spells between them and
                                     appear in no enum on either side. Reported rather than hidden:
                                     a window saying "no flags" while three bits are on would be
                                     wrong. -->
                                <Border Background="{DynamicResource ColorSurfaceInfo}"
                                        BorderBrush="{DynamicResource ColorBorderLight}"
                                        BorderThickness="1" CornerRadius="3"
                                        Padding="8,5" Margin="0,0,0,12"
                                        Visibility="{Binding HasUnnamedFlagBits, Converter={StaticResource BoolToVis}}">
                                    <TextBlock TextWrapping="Wrap" FontSize="11"
                                               Foreground="{DynamicResource ColorTextSecondary}">
                                        <Run Text="This spell also carries flag bits that neither SkyPatcher nor the record format names:"/>
                                        <Run Text="{Binding UnnamedFlagBits, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text="— they are kept exactly as scanned, but cannot be switched here: the patcher sets flags by name."/>
                                    </TextBlock>
                                </Border>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Description" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ColorTextTertiary}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedSpell.Description}"
                                               Margin="3" TextWrapping="Wrap"
                                               Visibility="{Binding IsScannedSelected, Converter={StaticResource BoolToVis}}"/>
                                    <TextBox Grid.Column="1" Text="{Binding UserDescription}"
                                             Background="{DynamicResource ColorBackgroundControl}"
                                             Foreground="{DynamicResource ColorTextPrimary}"
                                             BorderBrush="{DynamicResource ColorBorder}"
                                             Padding="3" Margin="0,2" TextWrapping="Wrap" AcceptsReturn="True"
                                             Visibility="{Binding IsUserCreatedSelected, Converter={StaticResource BoolToVis}}"/>
                                    <Button Grid.Column="2" Style="{StaticResource InfoButtonStyle}">
                                        <Button.ToolTip>
                                            <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                                <TextBlock Style="{StaticResource ToolTipTitelStyle}" TextWrapping="Wrap"
                                                           Text="The text shown under the spell in the magic menu. Read-only on a scanned record — the spell patcher has no operation for it."/>
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <!-- EFFECTS. Built to match the Enchantments tab row for row: the two edit
                             the SAME kind of record - Mutagen gives SPEL and ENCH an identical
                             effect type - so anything that looked different here would be a
                             difference invented by this tool rather than one the game has. -->
                        <Expander Style="{StaticResource DarkExpanderStyle}" IsExpanded="True" Margin="0,0,0,10"
                                  views:Tutorial.Id="spells.effects">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Effects"/>
                                    <TextBlock Style="{StaticResource ChangedDotStyle}"
                                               ToolTip="This section contains changes — the effect list differs from the scanned state."
                                               Visibility="{Binding DataContext.SelectedEffectsEdited, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Expander.Header>

                        <StackPanel Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <Button Content="Reset effects"
                                        Command="{Binding DataContext.ResetEffectsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Style="{StaticResource StandardButtonStyle}"
                                        Visibility="{Binding DataContext.SelectedEffectsEdited, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                        ToolTip="Puts magnitude, duration and area back to what the scan found, and undoes any effect added or removed here."/>

                                <Button Margin="10,0,0,0" Style="{StaticResource InfoButtonStyle}">
                                    <Button.ToolTip>
                                        <ToolTip Style="{StaticResource InfoTooltipStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource ToolTipTitelStyle}" TextWrapping="Wrap"
                                                           Text="What the spell actually does. Magnitude, duration and area are patched per effect with mgefsToChange; an added or removed one becomes mgefsToAdd / mgefsToRemove."/>
                                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                                           Text="Only values you change are written; the rest go out as 'null' so another mod's patch is not overwritten."/>
                                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                                           Text="A box is greyed out where the magic effect has no such value — a Soul Trap has no magnitude, a Fortify no area."/>
                                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                                           Text="The magic effect itself — its school, its name, what it does — belongs to a shared record and is not edited here: changing it would change every spell and enchantment that uses it."/>
                                            </StackPanel>
                                        </ToolTip>
                                    </Button.ToolTip>
                                </Button>
                            </StackPanel>

                            <Border BorderBrush="{Binding DataContext.SelectedEffectsEdited, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToChangedBorderConverter}}"
                                    BorderThickness="0,0,0,2" Margin="0,0,0,5"
                                    ToolTip="A colored line here means the Effects differ from how they looked when this spell was loaded."/>

                            <!-- Add an effect. The list shows only what is still missing: an effect
                                 can appear once per spell (PRIMARY KEY over Spell + MagicEffect).
                                 Filters as you type like the other pickers — nobody scrolls 5.482
                                 entries. -->
                            <Grid Margin="0,0,0,8"
                                  views:Tutorial.Id="spells.addEffect">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding DataContext.FilteredMagicEffects, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedItem="{Binding DataContext.SelectedMagicEffectToAdd, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                          Text="{Binding DataContext.MagicEffectSearchText, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          IsTextSearchEnabled="False"
                                          IsSynchronizedWithCurrentItem="False"
                                          StaysOpenOnEdit="True"
                                          DisplayMemberPath="Label"
                                          Style="{StaticResource ItemComboBoxStyle}"
                                          ToolTip="Type to filter the scanned magic effects. Effects this spell already carries are not listed."/>

                                <!-- Its own margin rather than the style's: StandardButtonStyle
                                     brings Margin="0,0,5,5", and those 5px below sit the button too
                                     low against the box beside it. -->
                                <Button Grid.Column="1"
                                        Content="Add effect"
                                        Command="{Binding DataContext.AddEffectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        IsEnabled="{Binding DataContext.CanAddEffect, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Style="{StaticResource StandardButtonStyle}"
                                        Margin="6,0,0,5"
                                        ToolTip="Adds the selected effect with Magnitude / Duration / Area at 0. The patch writes it as mgefsToAdd; Reset effects takes it away again."/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding DataContext.EffectVMs, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource ColorBorder}"
                                                BorderThickness="1"
                                                Padding="5"
                                                Margin="0,0,0,5"
                                                Background="{DynamicResource ColorBackgroundControl}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Takes this effect off the spell. CommandParameter
                                                     is this row's view model; the command itself
                                                     hangs off the view model of the whole view. -->
                                                <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="7"
                                                        Content="Remove"
                                                        VerticalAlignment="Top"
                                                        Command="{Binding DataContext.RemoveEffectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource StandardButtonStyle}"
                                                        Margin="8,0,0,0"
                                                        ToolTip="Takes this effect off the spell. The patch writes it as mgefsToRemove; Reset effects puts it back."/>

                                                <!-- EditorID -->
                                                <TextBlock Grid.Row="0"
                                                           Text="EditorID:"
                                                           Style="{StaticResource ItemLabelStyle}"/>
                                                <TextBox Grid.Row="0"
                                                         Grid.Column="1"
                                                         Text="{Binding Model.EditorID}"
                                                         Style="{StaticResource CopyableIdentifierStyle}"/>

                                                <!-- Name -->
                                                <TextBlock Grid.Row="1"
                                                           Text="Name:"
                                                           Style="{StaticResource ItemLabelStyle}"/>
                                                <TextBox Grid.Row="1"
                                                         Grid.Column="1"
                                                         Text="{Binding Model.Name}"
                                                         Style="{StaticResource CopyableIdentifierStyle}"/>

                                                <!-- Key -->
                                                <TextBlock Grid.Row="2"
                                                           Text="Key:"
                                                           Style="{StaticResource ItemLabelStyle}"/>
                                                <TextBox Grid.Row="2"
                                                         Grid.Column="1"
                                                         Text="{Binding Model.MagicEffectKey}"
                                                         Style="{StaticResource CopyableIdentifierStyle}"/>

                                                <!-- School. The one row the Enchantments tab does not
                                                     have, and it earns its place: a spell IS its
                                                     school to anyone reading the list, and the spell
                                                     record does not carry one - this is where it
                                                     comes from. -->
                                                <TextBlock Grid.Row="3"
                                                           Text="School:"
                                                           Style="{StaticResource ItemLabelStyle}"/>
                                                <!-- Mode=OneWay, and it is not optional: a TextBox's
                                                     Text binding defaults to TwoWay, and SchoolLabel
                                                     is computed with no setter. WPF does not warn
                                                     about that - it throws while building the
                                                     template, which lands as a crash the moment a
                                                     spell is selected. The three rows above bind to
                                                     Model.* fields, which do have setters. -->
                                                <TextBox Grid.Row="3"
                                                         Grid.Column="1"
                                                         Text="{Binding SchoolLabel, Mode=OneWay}"
                                                         Style="{StaticResource CopyableIdentifierStyle}"/>

                                                <!-- Magnitude -->
                                                <TextBlock Grid.Row="4"
                                                           Text="Magnitude:"
                                                           Style="{StaticResource ItemLabelStyle}"/>
                                                <TextBox Grid.Row="4"
                                                         Grid.Column="1"
                                                         Text="{Binding Magnitude}"
                                                         IsEnabled="{Binding AllowsMagnitude}"
                                                         BorderBrush="{Binding IsMagnitudeEdited, Converter={StaticResource BoolToChangedBorderConverter}}"
                                                         Style="{StaticResource ItemTextBoxStyle}"/>

                                                <!-- Duration -->
                                                <TextBlock Grid.Row="5"
                                                           Text="Duration:"
                                                           Style="{StaticResource ItemLabelStyle}"/>
                                                <TextBox Grid.Row="5"
                                                         Grid.Column="1"
                                                         Text="{Binding Duration}"
                                                         IsEnabled="{Binding AllowsDuration}"
                                                         BorderBrush="{Binding IsDurationEdited, Converter={StaticResource BoolToChangedBorderConverter}}"
                                                         Style="{StaticResource ItemTextBoxStyle}"/>

                                                <!-- Area -->
                                                <TextBlock Grid.Row="6"
                                                           Text="Area:"
                                                           Style="{StaticResource ItemLabelStyle}"/>
                                                <TextBox Grid.Row="6"
                                                         Grid.Column="1"
                                                         Text="{Binding Area}"
                                                         IsEnabled="{Binding AllowsArea}"
                                                         BorderBrush="{Binding IsAreaEdited, Converter={StaticResource BoolToChangedBorderConverter}}"
                                                         Style="{StaticResource ItemTextBoxStyle}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="This spell has no effects of its own — its behaviour comes from a script. Adding one above is still possible."
                                       FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ColorTextMuted}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasEffects}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
