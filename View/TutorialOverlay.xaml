<UserControl x:Class="SkyrimCraftingTool.View.TutorialOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">

    <!-- The guided tour (Services/TutorialService.cs). Everything is dimmed except the control the
         step is about; the cut-out is a hole in the dimming path, so a click there reaches the control
         underneath while a click anywhere else lands on the path and goes nowhere.
         No Background on the Canvas: it would catch the clicks meant for the hole. -->
    <Canvas x:Name="Root" ClipToBounds="True">

        <Path x:Name="Dim"
              Fill="{DynamicResource ColorBackgroundBase}"
              Opacity="0.72"/>

        <!-- Frame around the cut-out. Never hit-testable: it sits on top of the very control the user
             may want to click. -->
        <Border x:Name="Frame"
                BorderBrush="{DynamicResource ColorHeadingAccent}"
                BorderThickness="2"
                CornerRadius="4"
                IsHitTestVisible="False"/>

        <Border x:Name="Callout"
                Width="400"
                Background="{DynamicResource ColorBackgroundControl}"
                BorderBrush="{DynamicResource ColorHeadingAccent}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="14,10,14,8">
            <StackPanel>
                <DockPanel>
                    <TextBlock x:Name="Counter"
                               DockPanel.Dock="Right"
                               Margin="10,0,0,0"
                               VerticalAlignment="Top"
                               Foreground="{DynamicResource ColorTextSecondary}"/>
                    <TextBlock x:Name="TitleText"
                               FontSize="14"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorHeadingAccent}"/>
                </DockPanel>

                <TextBlock x:Name="BodyText"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource ColorTextPrimary}"/>

                <Expander x:Name="MoreExpander"
                          Header="More about this"
                          Margin="0,10,0,0"
                          Style="{StaticResource DarkExpanderStyle}">
                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="MoreText"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource ColorTextPrimary}"/>
                    </ScrollViewer>
                </Expander>

                <DockPanel Margin="0,10,0,0" LastChildFill="False">
                    <Button x:Name="SkipButton"
                            DockPanel.Dock="Left"
                            Content="Skip tour"
                            Click="Skip_Click"
                            ToolTip="End the tour here (Esc)."
                            Style="{StaticResource StandardButtonStyle}"/>
                    <Button x:Name="NextButton"
                            DockPanel.Dock="Right"
                            Content="Next"
                            Click="Next_Click"
                            Style="{StaticResource ActionButtonStyle}"/>
                    <Button x:Name="BackButton"
                            DockPanel.Dock="Right"
                            Content="Back"
                            Click="Back_Click"
                            Style="{StaticResource StandardButtonStyle}"/>
                </DockPanel>
            </StackPanel>
        </Border>
    </Canvas>
</UserControl>
