<UserControl x:Class="SkyrimCraftingTool.View.MultiSelectDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SkyrimCraftingTool.ViewModel"
             xmlns:model="clr-namespace:SkyrimCraftingTool.Model">

    <!-- DataContext is MultiSelectDetailVM (see MainContentView.xaml), not MainContentVM
         directly - SelectedItems/Apply commands live there, see MultiSelectDetailVM.cs. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,0">

            <TextBlock Text="{Binding SelectedItems.Count, StringFormat={}{0} items selected}"
                       Style="{StaticResource TitelStyle}"
                       FontWeight="Bold"
                       Margin="0,0,0,6"/>

            <ItemsControl ItemsSource="{Binding SelectedItems}" Margin="0,0,0,6">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ItemNodeVM}">
                        <Border Background="{StaticResource ColorBackgroundControl}"
                                CornerRadius="3" Padding="6,2" Margin="0,0,4,4">
                            <TextBlock Text="{Binding EditorID}"
                                       Foreground="{StaticResource ColorTextSecondary}"
                                       FontSize="11"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{StaticResource ColorWarning}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"/>

            <!-- Auto-Apply: applies a preset (see PresetApplyService) to every selected item - per
                 item, all Armor slots get merged, or the one matching Weapon type is used, exactly
                 like in the single-item editor. -->
            <Expander Style="{StaticResource DarkExpanderStyle}" Header="Auto-Apply (Presets)" IsExpanded="False">
                <StackPanel>
                    <TextBlock Text="Preset:"
                               Style="{StaticResource ItemLabelStyle}"
                               Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding AvailablePresets}"
                              SelectedItem="{Binding SelectedPreset}"
                              DisplayMemberPath="PresetName"
                              Style="{StaticResource ItemComboBoxStyle}"/>

                    <Button Content="Apply to Selection"
                            Command="{Binding ApplyPresetCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0"/>
                </StackPanel>
            </Expander>

            <!-- Keywords: additive. By default only Armor-/Weapon-relevant keywords (like in the
                 single-item editor); "All" shows the full catalog. Without this filter, all several
                 hundred keywords from the mod list got rendered here - that was the main cause of lag
                 when expanding. Search is now debounced (180ms) instead of re-filtering on every
                 keystroke. -->
            <Expander Style="{StaticResource DarkExpanderStyle}" Header="Keywords (additive)" IsExpanded="False">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding KeywordSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Search..."
                                 Style="{StaticResource ItemTextSearchBoxStyle}"/>

                        <CheckBox Grid.Column="1"
                                  Content="All (Expert)"
                                  IsChecked="{Binding ShowAllKeywords}"
                                  Style="{StaticResource ItemCheckBoxStyle}"
                                  Margin="8,0,0,0"/>
                    </Grid>

                    <!-- ListBox instead of ItemsControl+WrapPanel: WPF virtualizes ListBox content by
                         default (VirtualizingStackPanel) - only the visible ~15-20 rows actually get
                         created/laid out, regardless of whether 30 or 800 keywords are filtered.
                         PlainListBoxItemStyle only removes the default selection visuals; the click
                         behavior still comes from its own Border/ToggleCommand. -->
                    <ListBox Height="280"
                             ItemsSource="{Binding KeywordRowsView}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ItemContainerStyle="{StaticResource PlainListBoxItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:KeywordRowVM}">
                                <Border CornerRadius="4" Padding="6,4" Margin="0,0,0,2"
                                        ToolTip="{Binding StatusText}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <!-- Base = "mixed" (some, but not all, items have the keyword) -->
                                            <Setter Property="Background" Value="{StaticResource ColorAccentWarmSoft}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusText}" Value="–">
                                                    <Setter Property="Background" Value="{StaticResource ColorBackgroundControl}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusText}" Value="all">
                                                    <Setter Property="Background" Value="{StaticResource ColorAccentGreen}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleCommand}"/>
                                    </Border.InputBindings>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                   Foreground="{StaticResource ColorTextPrimary}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                                   Foreground="{StaticResource ColorTextTertiary}"
                                                   FontSize="10"
                                                   Margin="6,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Expander>

            <!-- Crafting Recipe: a free-form template the user builds directly right here (Workbench,
                 Conditions, Ingredients - the same fields the single-item editor exposes), NOT copied
                 from one of the selected items. Each checkbox controls whether that part gets applied
                 at all. The Conditions/Ingredients editors below are copied verbatim from
                 MainContentView.xaml's single-item Crafting Recipe (same property/command names on
                 MultiSelectDetailVM - see its class comment) so they behave identically. -->
            <Expander Style="{StaticResource DarkExpanderStyle}" Header="Crafting Recipe" IsExpanded="False">
                <StackPanel>

                    <!-- Workbench -->
                    <CheckBox Content="Workbench"
                              IsChecked="{Binding IncludeCraftingWorkbench}"
                              Style="{StaticResource ItemCheckBoxStyle}"
                              Margin="0,0,0,4"/>

                    <ComboBox ItemsSource="{Binding FilteredCraftingWorkbenches}"
                              SelectedItem="{Binding SelectedCraftingWorkbench}"
                              IsSynchronizedWithCurrentItem="False"
                              Text="{Binding CraftingWorkbenchSearchText}"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              StaysOpenOnEdit="True"
                              TextSearch.TextPath="Name"
                              Style="{StaticResource ItemComboBoxStyle}"
                              Margin="0,0,0,10">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" ToolTip="{Binding Key}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Conditions -->
                    <CheckBox Content="Conditions"
                              IsChecked="{Binding IncludeCraftingConditions}"
                              Style="{StaticResource ItemCheckBoxStyle}"
                              Margin="0,0,0,4"/>

                    <ItemsControl ItemsSource="{Binding CraftingConditionsTemplate}" Margin="0,0,0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <!-- Type -->
                                        <ColumnDefinition Width="*"/>
                                        <!-- Target -->
                                        <ColumnDefinition Width="*"/>
                                        <!-- Value -->
                                        <ColumnDefinition Width="200"/>
                                        <!-- RunOn -->
                                        <ColumnDefinition Width="Auto"/>
                                        <!-- Remove -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Condition Type -->
                                    <DockPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Type:" Style="{StaticResource ItemLabelStyle}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding ConditionTypes}"
                                                  SelectedItem="{Binding Type, Mode=TwoWay}"
                                                  Style="{StaticResource ItemComboBoxStyle}"/>
                                    </DockPanel>

                                    <!-- Target -->
                                    <DockPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Target:" Style="{StaticResource ItemLabelStyle}" VerticalAlignment="Center"/>
                                        <ContentControl Content="{Binding}">
                                            <ContentControl.Resources>

                                                <!-- HasPerk -->
                                                <DataTemplate DataType="{x:Type local:PerkConditionViewModel}">
                                                    <ComboBox ItemsSource="{Binding DataContext.FilteredCraftingPerks,
                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          SelectedItem="{Binding SelectedPerk}" IsSynchronizedWithCurrentItem="False"
                                                          IsEditable="True"
                                                          Text="{Binding PerkSearchText}"
                                                          Style="{StaticResource ItemComboBoxStyle}"/>
                                                </DataTemplate>

                                                <!-- GetIsSex -->
                                                <DataTemplate DataType="{x:Type local:SexConditionViewModel}">
                                                    <ComboBox SelectedItem="{Binding TargetGender}"
                                                          ItemsSource="{Binding Genders}"
                                                          Style="{StaticResource ItemComboBoxStyle}"/>
                                                </DataTemplate>

                                                <!-- GetActorValue -->
                                                <DataTemplate DataType="{x:Type local:ActorValueConditionViewModel}">
                                                    <ComboBox SelectedItem="{Binding SelectedSkill}"
                                                          ItemsSource="{Binding ActorValueWhitelist}"
                                                          Style="{StaticResource ItemComboBoxStyle}"/>
                                                </DataTemplate>

                                                <!-- GetLevel: no real "Target" for this condition type (it only compares the
                                                     player's level) - RequiredLevel IS ComparisonValue (see
                                                     LevelConditionViewModel), edited via the "Value" column instead. Styled
                                                     as a visibly muted/disabled-looking box (not a plain TextBlock - that
                                                     read as blank/broken instead of "intentionally not editable here"; not
                                                     a normal or IsReadOnly TextBox either - both looked just like a live
                                                     input field) so it still reads as a field at a glance, just a disabled
                                                     one. Keeps the column instead of hiding it, so Type/Target/Value/RunOn
                                                     stay aligned across every condition type in the list. -->
                                                <DataTemplate DataType="{x:Type local:LevelConditionViewModel}">
                                                    <Border Background="{StaticResource ColorBackgroundControl}"
                                                            BorderBrush="{StaticResource ColorDivider}"
                                                            BorderThickness="1"
                                                            Padding="4"
                                                            Margin="0,0,5,5"
                                                            Opacity="0.5"
                                                            ToolTip="Edit via the Value field - Target isn't used for this condition type.">
                                                        <TextBlock Text="{Binding RequiredLevel}"
                                                            Foreground="{StaticResource ColorTextMuted}"
                                                            FontSize="11"/>
                                                    </Border>
                                                </DataTemplate>

                                                <!-- GetStageDone -->
                                                <DataTemplate DataType="{x:Type local:QuestStageConditionViewModel}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="60"/>
                                                        </Grid.ColumnDefinitions>

                                                        <ComboBox Grid.Column="0"
                                                              ItemsSource="{Binding DataContext.FilteredQuests,
                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              SelectedItem="{Binding SelectedQuest}" IsSynchronizedWithCurrentItem="False"
                                                              Style="{StaticResource ItemComboBoxStyle}"/>

                                                        <TextBox Grid.Column="1"
                                                             Text="{Binding Stage}"
                                                             Style="{StaticResource ItemTextBoxStyle}"/>
                                                    </Grid>
                                                </DataTemplate>

                                            </ContentControl.Resources>
                                        </ContentControl>
                                    </DockPanel>

                                    <!-- Value -->
                                    <DockPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="Value:" Style="{StaticResource ItemLabelStyle}" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding ComparisonValue}" Style="{StaticResource ItemTextBoxStyle}"/>
                                    </DockPanel>
                                    <!-- RunOn -->
                                    <DockPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Text="Run On:" Style="{StaticResource ItemLabelStyle}" VerticalAlignment="Center"/>
                                        <ComboBox
                                              ItemsSource="{Binding RunOnOptions}"
                                              SelectedItem="{Binding RunOn}"
                                              Style="{StaticResource ItemComboBoxStyle}"/>
                                    </DockPanel>

                                    <!-- Remove -->
                                    <Button Grid.Column="4"
                                        Command="{Binding DataContext.RemoveCraftingConditionCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource RemoveButtonStyle}"
                                        ToolTip="Remove Condition"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Command="{Binding AddCraftingConditionCommand}"
                            Style="{StaticResource AddButtonStyle}"
                            HorizontalAlignment="Left"
                            ToolTip="Add Condition"
                            Margin="0,0,0,10"/>

                    <!-- Ingredients -->
                    <CheckBox Content="Ingredients"
                              IsChecked="{Binding IncludeCraftingIngredients}"
                              Style="{StaticResource ItemCheckBoxStyle}"
                              Margin="0,0,0,4"/>

                    <ItemsControl ItemsSource="{Binding CraftingIngredientsTemplate}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding LocalMaterialsView}"
                                          SelectedItem="{Binding SelectedMaterial}" IsSynchronizedWithCurrentItem="False"
                                          Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="{Binding Key}"
                                          DisplayMemberPath="Name"
                                          IsEditable="True"
                                          IsTextSearchEnabled="False"
                                          StaysOpenOnEdit="True"
                                          Style="{StaticResource ItemComboBoxStyle}"/>

                                    <TextBox Grid.Column="1"
                                         TextAlignment="Center"
                                         ToolTip="Amount"
                                         Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}"
                                         model:NumericTextBoxBehavior.Mode="Integer"
                                         model:NumericTextBoxBehavior.Min="1"
                                         Style="{StaticResource ItemTextBoxStyle}"/>

                                    <Button Grid.Column="2"
                                        Command="{Binding DataContext.RemoveIngredientCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Remove Material"
                                        Style="{StaticResource RemoveButtonStyle}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Command="{Binding AddIngredientCommand}"
                            Style="{StaticResource AddButtonStyle}"
                            HorizontalAlignment="Left"
                            ToolTip="Add Material/Recipe"
                            Margin="0,0,0,10"/>

                    <Button Content="Apply to Selection"
                            Command="{Binding ApplyCraftingRecipeCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Expander>

            <!-- Temper Recipe: mirror image of the Crafting section, minus Workbench - like in the
                 single-item editor, the Temper workbench is always auto-derived from the item at
                 COBJ-creation time and never user-settable, so there's nothing to choose here. -->
            <Expander Style="{StaticResource DarkExpanderStyle}" Header="Temper Recipe" IsExpanded="False">
                <StackPanel>

                    <!-- Conditions -->
                    <CheckBox Content="Conditions"
                              IsChecked="{Binding IncludeTemperConditions}"
                              Style="{StaticResource ItemCheckBoxStyle}"
                              Margin="0,0,0,4"/>

                    <ItemsControl ItemsSource="{Binding TemperConditionsTemplate}" Margin="0,0,0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <!-- Type -->
                                        <ColumnDefinition Width="*"/>
                                        <!-- Target -->
                                        <ColumnDefinition Width="*"/>
                                        <!-- Value -->
                                        <ColumnDefinition Width="200"/>
                                        <!-- RunOn -->
                                        <ColumnDefinition Width="Auto"/>
                                        <!-- Remove -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Condition Type -->
                                    <DockPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Type:" Style="{StaticResource ItemLabelStyle}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding ConditionTypes}"
                                                  SelectedItem="{Binding Type, Mode=TwoWay}"
                                                  Style="{StaticResource ItemComboBoxStyle}"/>
                                    </DockPanel>

                                    <!-- Target -->
                                    <DockPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Target:" Style="{StaticResource ItemLabelStyle}" VerticalAlignment="Center"/>
                                        <ContentControl Content="{Binding}">
                                            <ContentControl.Resources>

                                                <!-- HasPerk -->
                                                <DataTemplate DataType="{x:Type local:PerkConditionViewModel}">
                                                    <ComboBox ItemsSource="{Binding DataContext.FilteredCraftingPerks,
                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          SelectedItem="{Binding SelectedPerk}" IsSynchronizedWithCurrentItem="False"
                                                          IsEditable="True"
                                                          Text="{Binding PerkSearchText}"
                                                          Style="{StaticResource ItemComboBoxStyle}"/>
                                                </DataTemplate>

                                                <!-- GetIsSex -->
                                                <DataTemplate DataType="{x:Type local:SexConditionViewModel}">
                                                    <ComboBox SelectedItem="{Binding TargetGender}"
                                                          ItemsSource="{Binding Genders}"
                                                          Style="{StaticResource ItemComboBoxStyle}"/>
                                                </DataTemplate>

                                                <!-- GetActorValue -->
                                                <DataTemplate DataType="{x:Type local:ActorValueConditionViewModel}">
                                                    <ComboBox SelectedItem="{Binding SelectedSkill}"
                                                          ItemsSource="{Binding ActorValueWhitelist}"
                                                          Style="{StaticResource ItemComboBoxStyle}"/>
                                                </DataTemplate>

                                                <!-- GetLevel: no real "Target" for this condition type (it only compares the
                                                     player's level) - RequiredLevel IS ComparisonValue (see
                                                     LevelConditionViewModel), edited via the "Value" column instead. Styled
                                                     as a visibly muted/disabled-looking box (not a plain TextBlock - that
                                                     read as blank/broken instead of "intentionally not editable here"; not
                                                     a normal or IsReadOnly TextBox either - both looked just like a live
                                                     input field) so it still reads as a field at a glance, just a disabled
                                                     one. Keeps the column instead of hiding it, so Type/Target/Value/RunOn
                                                     stay aligned across every condition type in the list. -->
                                                <DataTemplate DataType="{x:Type local:LevelConditionViewModel}">
                                                    <Border Background="{StaticResource ColorBackgroundControl}"
                                                            BorderBrush="{StaticResource ColorDivider}"
                                                            BorderThickness="1"
                                                            Padding="4"
                                                            Margin="0,0,5,5"
                                                            Opacity="0.5"
                                                            ToolTip="Edit via the Value field - Target isn't used for this condition type.">
                                                        <TextBlock Text="{Binding RequiredLevel}"
                                                            Foreground="{StaticResource ColorTextMuted}"
                                                            FontSize="11"/>
                                                    </Border>
                                                </DataTemplate>

                                                <!-- GetStageDone -->
                                                <DataTemplate DataType="{x:Type local:QuestStageConditionViewModel}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="60"/>
                                                        </Grid.ColumnDefinitions>

                                                        <ComboBox Grid.Column="0"
                                                              ItemsSource="{Binding DataContext.FilteredQuests,
                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              SelectedItem="{Binding SelectedQuest}" IsSynchronizedWithCurrentItem="False"
                                                              Style="{StaticResource ItemComboBoxStyle}"/>

                                                        <TextBox Grid.Column="1"
                                                             Text="{Binding Stage}"
                                                             Style="{StaticResource ItemTextBoxStyle}"/>
                                                    </Grid>
                                                </DataTemplate>

                                            </ContentControl.Resources>
                                        </ContentControl>
                                    </DockPanel>

                                    <!-- Value -->
                                    <DockPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="Value:" Style="{StaticResource ItemLabelStyle}" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding ComparisonValue}" Style="{StaticResource ItemTextBoxStyle}"/>
                                    </DockPanel>
                                    <!-- RunOn -->
                                    <DockPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Text="Run On:" Style="{StaticResource ItemLabelStyle}" VerticalAlignment="Center"/>
                                        <ComboBox
                                              ItemsSource="{Binding RunOnOptions}"
                                              SelectedItem="{Binding RunOn}"
                                              Style="{StaticResource ItemComboBoxStyle}"/>
                                    </DockPanel>

                                    <!-- Remove -->
                                    <Button Grid.Column="4"
                                        Command="{Binding DataContext.RemoveTemperConditionCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource RemoveButtonStyle}"
                                        ToolTip="Remove Condition"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Command="{Binding AddTemperConditionCommand}"
                            Style="{StaticResource AddButtonStyle}"
                            HorizontalAlignment="Left"
                            ToolTip="Add Condition"
                            Margin="0,0,0,10"/>

                    <!-- Ingredients -->
                    <CheckBox Content="Ingredients"
                              IsChecked="{Binding IncludeTemperIngredients}"
                              Style="{StaticResource ItemCheckBoxStyle}"
                              Margin="0,0,0,4"/>

                    <ItemsControl ItemsSource="{Binding TemperIngredientsTemplate}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding LocalMaterialsView}"
                                          SelectedItem="{Binding SelectedMaterial}" IsSynchronizedWithCurrentItem="False"
                                          Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="{Binding Key}"
                                          DisplayMemberPath="Name"
                                          IsEditable="True"
                                          IsTextSearchEnabled="False"
                                          StaysOpenOnEdit="True"
                                          Style="{StaticResource ItemComboBoxStyle}"/>

                                    <TextBox Grid.Column="1"
                                         TextAlignment="Center"
                                         ToolTip="Amount"
                                         Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}"
                                         model:NumericTextBoxBehavior.Mode="Integer"
                                         model:NumericTextBoxBehavior.Min="1"
                                         Style="{StaticResource ItemTextBoxStyle}"/>

                                    <Button Grid.Column="2"
                                        Command="{Binding DataContext.RemoveTemperIngredientCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Remove Material"
                                        Style="{StaticResource RemoveButtonStyle}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Command="{Binding AddTemperIngredientCommand}"
                            Style="{StaticResource AddButtonStyle}"
                            HorizontalAlignment="Left"
                            ToolTip="Add Material/Recipe"
                            Margin="0,0,0,10"/>

                    <Button Content="Apply to Selection"
                            Command="{Binding ApplyTemperRecipeCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Expander>

            <!-- Container: additive (union). Left: selection catalog (by default only vendors, like
                 LimitedContainerVMs in the single-item editor); right: the template with LVLi levels,
                 which get applied 1:1 to every affected item. -->
            <Expander Style="{StaticResource DarkExpanderStyle}" Header="Container (additive)" IsExpanded="False">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Catalog -->
                    <StackPanel Grid.Column="0">
                        <TextBox Text="{Binding ContainerSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Search..."
                                 Style="{StaticResource ItemTextSearchBoxStyle}"
                                 Margin="0,0,0,6"/>

                        <CheckBox Content="All (Expert)"
                                  IsChecked="{Binding ShowExpertContainers}"
                                  Style="{StaticResource ItemCheckBoxStyle}"
                                  Margin="0,0,0,6"/>

                        <!-- ListBox instead of ItemsControl: same virtualization reasoning as with
                             Keywords above. -->
                        <ListBox Height="240"
                                 ItemsSource="{Binding ContainerRowsView}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 ItemContainerStyle="{StaticResource PlainListBoxItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:ContainerEntryVM}">
                                    <Border Padding="6" Margin="0,0,0,6"
                                            Background="{StaticResource ColorBackgroundControl}"
                                            CornerRadius="4">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{StaticResource ColorTextPrimary}"
                                                       VerticalAlignment="Center"/>

                                            <Button Width="70"
                                                    HorizontalAlignment="Right"
                                                    Style="{StaticResource StandardButtonStyle}"
                                                    Command="{Binding ToggleSelectedCommand}"
                                                    Content="{Binding IsSelected, Converter={StaticResource BoolToSelectTextConverter}}"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                  Background="{StaticResource ColorDivider}"/>

                    <!-- RIGHT: Template -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Template (gets applied to all selected items)"
                                   Style="{StaticResource ItemLabelStyle}"
                                   Margin="0,0,0,6"/>

                        <ItemsControl ItemsSource="{Binding SelectedContainerTemplateRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:ContainerEntryVM}">
                                    <Border Padding="8" Margin="0,0,0,8"
                                            Background="{StaticResource ColorBackgroundControl}"
                                            CornerRadius="4">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                           Foreground="{StaticResource ColorTextPrimary}"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Center"/>

                                                <Button Grid.Column="1" Content="Remove"
                                                        Style="{StaticResource StandardButtonStyle}"
                                                        Command="{Binding ToggleSelectedCommand}"
                                                        Margin="8,0,0,0"/>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding LVLiEntries}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,6,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="180"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0" Text="{Binding LVLiName}"
                                                                       Foreground="{StaticResource ColorTextPrimary}"
                                                                       VerticalAlignment="Center"/>

                                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                        VerticalAlignment="Center">
                                                                <Slider Minimum="0" Maximum="100"
                                                                        Value="{Binding LevelDouble, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                                                        SmallChange="1" LargeChange="1" TickFrequency="1"
                                                                        Width="120"
                                                                        Thumb.DragCompleted="TemplateSlider_ThumbDragCompleted"/>
                                                                <TextBlock Text="{Binding Level}"
                                                                           Foreground="{StaticResource ColorTextPrimary}"
                                                                           Margin="8,0,0,0"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="Add to Selection"
                                Command="{Binding ApplyContainersCommand}"
                                Style="{StaticResource ActionButtonStyle}"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
