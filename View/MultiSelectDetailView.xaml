<UserControl x:Class="SkyrimCraftingTool.View.MultiSelectDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SkyrimCraftingTool.ViewModel"
             xmlns:model="clr-namespace:SkyrimCraftingTool.Model">

    <!-- DataContext is MultiSelectDetailVM (see MainContentView.xaml), not MainContentVM
         directly - SelectedItems/Apply commands live there, see MultiSelectDetailVM.cs. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,0">

            <TextBlock Text="{Binding SelectedItems.Count, StringFormat={}{0} items selected}"
                       Style="{StaticResource TitelStyle}"
                       FontWeight="Bold"
                       Margin="0,0,0,6"/>

            <ItemsControl ItemsSource="{Binding SelectedItems}" Margin="0,0,0,6">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ItemNodeVM}">
                        <Border Background="{DynamicResource ColorBackgroundControl}"
                                CornerRadius="3" Padding="6,2" Margin="0,0,4,4">
                            <TextBlock Text="{Binding EditorID}"
                                       Foreground="{DynamicResource ColorTextSecondary}"
                                       FontSize="11"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource ColorWarning}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"/>

            <!-- Bulk reset: the single-item editor's "Reset ALL" for the whole selection, with one
                 confirmation for all of it (see MultiSelectDetailVM.ResetSelection). Deliberately
                 NOT inside one of the Expanders below - those all ADD something to the selection,
                 this is the one destructive action here and shouldn't be buried in a collapsed
                 section. Always enabled, like the Apply buttons: a selection with nothing to revert
                 answers via StatusMessage instead of a greyed-out button with no explanation. -->
            <Button Content="Reset ALL selected"
                    Command="{Binding ResetSelectionCommand}"
                    Style="{StaticResource StandardButtonStyle}"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,10">
                <Button.ToolTip>
                    <ToolTip Style="{StaticResource InfoTooltipStyle}">
                        <StackPanel>
                            <TextBlock Text="Reverts EVERYTHING - fields, crafting recipe and temper recipe - on every selected item that has edits, back to the scanned state. Asks for confirmation once for the whole selection."
                                Style="{StaticResource ToolTipTitelStyle}"/>
                        </StackPanel>
                    </ToolTip>
                </Button.ToolTip>
            </Button>

            <!-- Auto-Apply: applies a preset (see PresetApplyService) to every selected item - per
                 item, all Armor slots get merged, or the one matching Weapon type is used, exactly
                 like in the single-item editor. -->
            <Expander Style="{StaticResource DarkExpanderStyle}" Header="Auto-Apply (Presets)" IsExpanded="False">
                <StackPanel>
                    <TextBlock Text="Preset:"
                               Style="{StaticResource ItemLabelStyle}"
                               Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding AvailablePresets}"
                              SelectedItem="{Binding SelectedPreset}"
                              DisplayMemberPath="PresetName"
                              Style="{StaticResource ItemComboBoxStyle}"/>

                    <Button Content="Apply to Selection"
                            Command="{Binding ApplyPresetCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0"/>
                </StackPanel>
            </Expander>

            <!-- Numeric fields: for each field a per-item op (= set / + add / - subtract) applied to
                 every selected item that actually has the field. + / - use each item's own current
                 value; the RESULT is clamped to the field's valid range (Speed/Reach/Stagger 0..10,
                 the rest floored at 0). Persists directly per item via MainContentVM.PersistFieldAsync
                 (bypasses the shared debouncer - see its comment). -->
            <Expander Style="{StaticResource DarkExpanderStyle}" Header="Numeric Fields (set / add / subtract)" IsExpanded="False">
                <StackPanel>
                    <TextBlock Text="Applies to every selected item that has the field. + / − use each item's current value; the result is clamped to the valid range."
                               Foreground="{DynamicResource ColorTextTertiary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>

                    <ItemsControl ItemsSource="{Binding NumericFields}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:NumericBulkFieldVM}">
                                <Grid Margin="0,3" Visibility="{Binding IsRelevant, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding Include}"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource ItemCheckBoxStyle}"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Label}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource ColorTextPrimary}"/>

                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding OpChoices}"
                                              SelectedItem="{Binding SelectedOpChoice}"
                                              IsSynchronizedWithCurrentItem="False"
                                              Style="{StaticResource CompactComboBoxStyle}"
                                              Margin="0,0,6,0"/>

                                    <TextBox Grid.Column="3"
                                             Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Amount (for + / −) or the new value (for =)"
                                             Style="{StaticResource ItemTextBoxStyle}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="Apply to Selection"
                            Command="{Binding ApplyNumericFieldsCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            HorizontalAlignment="Left"
                            Margin="0,10,0,0"/>
                </StackPanel>
            </Expander>

            <!-- Keywords: additive. By default only Armor-/Weapon-relevant keywords (like in the
                 single-item editor); "All" shows the full catalog. Without this filter, all several
                 hundred keywords from the mod list got rendered here - that was the main cause of lag
                 when expanding. Search is now debounced (180ms) instead of re-filtering on every
                 keystroke. -->
            <Expander Style="{StaticResource DarkExpanderStyle}" Header="Keywords (additive)" IsExpanded="False">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding KeywordSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Search..."
                                 Style="{StaticResource ItemTextSearchBoxStyle}"/>

                        <CheckBox Grid.Column="1"
                                  Content="All (Expert)"
                                  IsChecked="{Binding ShowAllKeywords}"
                                  Style="{StaticResource ItemCheckBoxStyle}"
                                  Margin="8,0,0,0"/>
                    </Grid>

                    <!-- ListBox instead of ItemsControl+WrapPanel: WPF virtualizes ListBox content by
                         default (VirtualizingStackPanel) - only the visible ~15-20 rows actually get
                         created/laid out, regardless of whether 30 or 800 keywords are filtered.
                         PlainListBoxItemStyle only removes the default selection visuals; the click
                         behavior still comes from its own Border/ToggleCommand. -->
                    <ListBox Height="280"
                             ItemsSource="{Binding KeywordRowsView}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ItemContainerStyle="{StaticResource PlainListBoxItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:KeywordRowVM}">
                                <Border CornerRadius="4" Padding="6,4" Margin="0,0,0,2"
                                        ToolTip="{Binding StatusText}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <!-- Base = "mixed" (some, but not all, items have the keyword) -->
                                            <Setter Property="Background" Value="{DynamicResource ColorSurfaceWarn}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusText}" Value="–">
                                                    <Setter Property="Background" Value="{DynamicResource ColorBackgroundControl}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusText}" Value="all">
                                                    <Setter Property="Background" Value="{DynamicResource ColorSurfaceOk}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleCommand}"/>
                                    </Border.InputBindings>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                   Foreground="{DynamicResource ColorTextPrimary}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                                   Foreground="{DynamicResource ColorTextTertiary}"
                                                   FontSize="10"
                                                   Margin="6,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Expander>

            <!-- Crafting Recipe: a free-form template the user builds directly right here (Workbench,
                 Conditions, Ingredients - the same fields the single-item editor exposes), NOT copied
                 from one of the selected items. Each checkbox controls whether that part gets applied
                 at all. The Conditions/Ingredients editors below are copied verbatim from
                 MainContentView.xaml's single-item Crafting Recipe (same property/command names on
                 MultiSelectDetailVM - see its class comment) so they behave identically. -->
            <Expander Style="{StaticResource DarkExpanderStyle}" Header="Crafting Recipe" IsExpanded="False">
                <StackPanel>

                    <!-- Workbench -->
                    <CheckBox Content="Workbench"
                              IsChecked="{Binding IncludeCraftingWorkbench}"
                              Style="{StaticResource ItemCheckBoxStyle}"
                              Margin="0,0,0,4"/>

                    <ComboBox ItemsSource="{Binding FilteredCraftingWorkbenches}"
                              SelectedItem="{Binding SelectedCraftingWorkbench}"
                              IsSynchronizedWithCurrentItem="False"
                              Text="{Binding CraftingWorkbenchSearchText}"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              StaysOpenOnEdit="True"
                              TextSearch.TextPath="Name"
                              Style="{StaticResource ItemComboBoxStyle}"
                              Margin="0,0,0,10">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" ToolTip="{Binding Key}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Conditions -->
                    <CheckBox Content="Conditions"
                              IsChecked="{Binding IncludeCraftingConditions}"
                              Style="{StaticResource ItemCheckBoxStyle}"
                              Margin="0,0,0,4"/>

                    <ItemsControl ItemsSource="{Binding CraftingConditionsTemplate}" Margin="0,0,0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <!-- Type -->
                                        <ColumnDefinition Width="*"/>
                                        <!-- Target -->
                                        <ColumnDefinition Width="*"/>
                                        <!-- Value -->
                                        <ColumnDefinition Width="200"/>
                                        <!-- RunOn -->
                                        <ColumnDefinition Width="Auto"/>
                                        <!-- Remove -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Condition Type -->
                                    <DockPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Type:" Style="{StaticResource ItemLabelStyle}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding ConditionTypes}"
                                                  SelectedItem="{Binding Type, Mode=TwoWay}"
                                                  Style="{StaticResource ItemComboBoxStyle}"/>
                                    </DockPanel>

                                    <!-- Target -->
                                    <DockPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Target:" Style="{StaticResource ItemLabelStyle}" VerticalAlignment="Center"/>
                                        <ContentControl Content="{Binding}"/>
                                    </DockPanel>

                                    <!-- Value -->
                                    <DockPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="Value:" Style="{StaticResource ItemLabelStyle}" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding ComparisonValue}" Style="{StaticResource ItemTextBoxStyle}"/>
                                    </DockPanel>
                                    <!-- RunOn -->
                                    <DockPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Text="Run On:" Style="{StaticResource ItemLabelStyle}" VerticalAlignment="Center"/>
                                        <ComboBox
                                              ItemsSource="{Binding RunOnOptions}"
                                              SelectedItem="{Binding RunOn}"
                                              Style="{StaticResource ItemComboBoxStyle}"/>
                                    </DockPanel>

                                    <!-- Remove -->
                                    <Button Grid.Column="4"
                                        Command="{Binding DataContext.RemoveCraftingConditionCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource RemoveButtonStyle}"
                                        ToolTip="Remove Condition"/>

                                                                        <!-- Read-only condition overlay: covers the whole row for a condition type that is preserved
                                                                             but not editable. The overlay itself lives in Styles/ConditionTemplates.xaml as the
                                                                             template for ReadOnlyConditionViewModel.
                                                                             Content is set by a DataTrigger and left null otherwise - NOT a Visibility toggle on a
                                                                             filled element. Null content means the template is never instantiated for an ordinary
                                                                             condition, so its bindings (Explanation, FunctionName, ...) cannot be evaluated against a
                                                                             view model that has none of them. That was 12 binding errors per editable row. -->
                                                                        <ContentControl Grid.Column="0" Grid.ColumnSpan="5" Panel.ZIndex="10">
                                                                            <ContentControl.Style>
                                                                                <Style TargetType="ContentControl">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Type}" Value="ReadOnly">
                                                                                            <Setter Property="Content" Value="{Binding}"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </ContentControl.Style>
                                                                        </ContentControl>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Command="{Binding AddCraftingConditionCommand}"
                            Style="{StaticResource AddButtonStyle}"
                            HorizontalAlignment="Left"
                            ToolTip="Add Condition"
                            Margin="0,0,0,10"/>

                    <!-- Ingredients -->
                    <CheckBox Content="Ingredients"
                              IsChecked="{Binding IncludeCraftingIngredients}"
                              Style="{StaticResource ItemCheckBoxStyle}"
                              Margin="0,0,0,4"/>

                    <ItemsControl ItemsSource="{Binding CraftingIngredientsTemplate}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding LocalMaterialsView}"
                                          SelectedItem="{Binding SelectedMaterial}" IsSynchronizedWithCurrentItem="False"
                                          Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="{Binding Key}"
                                          DisplayMemberPath="Name"
                                          IsEditable="True"
                                          IsTextSearchEnabled="False"
                                          StaysOpenOnEdit="True"
                                          Style="{StaticResource ItemComboBoxStyle}"/>

                                    <TextBox Grid.Column="1"
                                         TextAlignment="Center"
                                         ToolTip="Amount"
                                         Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}"
                                         model:NumericTextBoxBehavior.Mode="Integer"
                                         model:NumericTextBoxBehavior.Min="1"
                                         Style="{StaticResource ItemTextBoxStyle}"/>

                                    <Button Grid.Column="2"
                                        Command="{Binding DataContext.RemoveIngredientCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Remove Material"
                                        Style="{StaticResource RemoveButtonStyle}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Command="{Binding AddIngredientCommand}"
                            Style="{StaticResource AddButtonStyle}"
                            HorizontalAlignment="Left"
                            ToolTip="Add Material/Recipe"
                            Margin="0,0,0,10"/>

                    <Button Content="Apply to Selection"
                            Command="{Binding ApplyCraftingRecipeCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Expander>

            <!-- Temper Recipe: mirror image of the Crafting section, minus Workbench - like in the
                 single-item editor, the Temper workbench is always auto-derived from the item at
                 COBJ-creation time and never user-settable, so there's nothing to choose here. -->
            <Expander Style="{StaticResource DarkExpanderStyle}" Header="Temper Recipe" IsExpanded="False">
                <StackPanel>

                    <!-- Conditions -->
                    <CheckBox Content="Conditions"
                              IsChecked="{Binding IncludeTemperConditions}"
                              Style="{StaticResource ItemCheckBoxStyle}"
                              Margin="0,0,0,4"/>

                    <ItemsControl ItemsSource="{Binding TemperConditionsTemplate}" Margin="0,0,0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <!-- Type -->
                                        <ColumnDefinition Width="*"/>
                                        <!-- Target -->
                                        <ColumnDefinition Width="*"/>
                                        <!-- Value -->
                                        <ColumnDefinition Width="200"/>
                                        <!-- RunOn -->
                                        <ColumnDefinition Width="Auto"/>
                                        <!-- Remove -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Condition Type -->
                                    <DockPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Type:" Style="{StaticResource ItemLabelStyle}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding ConditionTypes}"
                                                  SelectedItem="{Binding Type, Mode=TwoWay}"
                                                  Style="{StaticResource ItemComboBoxStyle}"/>
                                    </DockPanel>

                                    <!-- Target -->
                                    <DockPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Target:" Style="{StaticResource ItemLabelStyle}" VerticalAlignment="Center"/>
                                        <ContentControl Content="{Binding}"/>
                                    </DockPanel>

                                    <!-- Value -->
                                    <DockPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="Value:" Style="{StaticResource ItemLabelStyle}" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding ComparisonValue}" Style="{StaticResource ItemTextBoxStyle}"/>
                                    </DockPanel>
                                    <!-- RunOn -->
                                    <DockPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Text="Run On:" Style="{StaticResource ItemLabelStyle}" VerticalAlignment="Center"/>
                                        <ComboBox
                                              ItemsSource="{Binding RunOnOptions}"
                                              SelectedItem="{Binding RunOn}"
                                              Style="{StaticResource ItemComboBoxStyle}"/>
                                    </DockPanel>

                                    <!-- Remove -->
                                    <Button Grid.Column="4"
                                        Command="{Binding DataContext.RemoveTemperConditionCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource RemoveButtonStyle}"
                                        ToolTip="Remove Condition"/>

                                                                        <!-- Read-only condition overlay: covers the whole row for a condition type that is preserved
                                                                             but not editable. The overlay itself lives in Styles/ConditionTemplates.xaml as the
                                                                             template for ReadOnlyConditionViewModel.
                                                                             Content is set by a DataTrigger and left null otherwise - NOT a Visibility toggle on a
                                                                             filled element. Null content means the template is never instantiated for an ordinary
                                                                             condition, so its bindings (Explanation, FunctionName, ...) cannot be evaluated against a
                                                                             view model that has none of them. That was 12 binding errors per editable row. -->
                                                                        <ContentControl Grid.Column="0" Grid.ColumnSpan="5" Panel.ZIndex="10">
                                                                            <ContentControl.Style>
                                                                                <Style TargetType="ContentControl">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Type}" Value="ReadOnly">
                                                                                            <Setter Property="Content" Value="{Binding}"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </ContentControl.Style>
                                                                        </ContentControl>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Command="{Binding AddTemperConditionCommand}"
                            Style="{StaticResource AddButtonStyle}"
                            HorizontalAlignment="Left"
                            ToolTip="Add Condition"
                            Margin="0,0,0,10"/>

                    <!-- Ingredients -->
                    <CheckBox Content="Ingredients"
                              IsChecked="{Binding IncludeTemperIngredients}"
                              Style="{StaticResource ItemCheckBoxStyle}"
                              Margin="0,0,0,4"/>

                    <ItemsControl ItemsSource="{Binding TemperIngredientsTemplate}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding LocalMaterialsView}"
                                          SelectedItem="{Binding SelectedMaterial}" IsSynchronizedWithCurrentItem="False"
                                          Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="{Binding Key}"
                                          DisplayMemberPath="Name"
                                          IsEditable="True"
                                          IsTextSearchEnabled="False"
                                          StaysOpenOnEdit="True"
                                          Style="{StaticResource ItemComboBoxStyle}"/>

                                    <TextBox Grid.Column="1"
                                         TextAlignment="Center"
                                         ToolTip="Amount"
                                         Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}"
                                         model:NumericTextBoxBehavior.Mode="Integer"
                                         model:NumericTextBoxBehavior.Min="1"
                                         Style="{StaticResource ItemTextBoxStyle}"/>

                                    <Button Grid.Column="2"
                                        Command="{Binding DataContext.RemoveTemperIngredientCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Remove Material"
                                        Style="{StaticResource RemoveButtonStyle}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Command="{Binding AddTemperIngredientCommand}"
                            Style="{StaticResource AddButtonStyle}"
                            HorizontalAlignment="Left"
                            ToolTip="Add Material/Recipe"
                            Margin="0,0,0,10"/>

                    <Button Content="Apply to Selection"
                            Command="{Binding ApplyTemperRecipeCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Expander>

            <!-- Container: additive (union). Left: selection catalog (by default only vendors, like
                 LimitedContainerVMs in the single-item editor); right: the template with LVLi levels,
                 which get applied 1:1 to every affected item. -->
            <Expander Style="{StaticResource DarkExpanderStyle}" Header="Container (additive)" IsExpanded="False">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Catalog -->
                    <StackPanel Grid.Column="0">
                        <TextBox Text="{Binding ContainerSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Search..."
                                 Style="{StaticResource ItemTextSearchBoxStyle}"
                                 Margin="0,0,0,6"/>

                        <CheckBox Content="All (Expert)"
                                  IsChecked="{Binding ShowExpertContainers}"
                                  Style="{StaticResource ItemCheckBoxStyle}"
                                  Margin="0,0,0,6"/>

                        <!-- ListBox instead of ItemsControl: same virtualization reasoning as with
                             Keywords above. -->
                        <ListBox Height="240"
                                 ItemsSource="{Binding ContainerRowsView}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 ItemContainerStyle="{StaticResource PlainListBoxItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:ContainerEntryVM}">
                                    <Border Padding="6" Margin="0,0,0,6"
                                            Background="{DynamicResource ColorBackgroundControl}"
                                            CornerRadius="4">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{DynamicResource ColorTextPrimary}"
                                                       VerticalAlignment="Center"/>

                                            <Button Width="70"
                                                    HorizontalAlignment="Right"
                                                    Style="{StaticResource StandardButtonStyle}"
                                                    Command="{Binding ToggleSelectedCommand}"
                                                    Content="{Binding IsSelected, Converter={StaticResource BoolToSelectTextConverter}}"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                  Background="{DynamicResource ColorDivider}"/>

                    <!-- RIGHT: Template -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Template (gets applied to all selected items)"
                                   Style="{StaticResource ItemLabelStyle}"
                                   Margin="0,0,0,6"/>

                        <TextBlock Text="Leave every slider at 0 and the items are placed in the container itself - permanently, and they will be there. Raise a slider and they go into that leveled list instead: from that level on they can turn up when the merchant restocks (vanilla: about every 48 h), by chance rather than guaranteed."
                                   Foreground="{DynamicResource ColorTextTertiary}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <ItemsControl ItemsSource="{Binding SelectedContainerTemplateRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:ContainerEntryVM}">
                                    <Border Padding="8" Margin="0,0,0,8"
                                            Background="{DynamicResource ColorBackgroundControl}"
                                            CornerRadius="4">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                           Foreground="{DynamicResource ColorTextPrimary}"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Center"/>

                                                <Button Grid.Column="1" Content="Remove"
                                                        Style="{StaticResource StandardButtonStyle}"
                                                        Command="{Binding ToggleSelectedCommand}"
                                                        Margin="8,0,0,0"/>
                                            </Grid>

                                            <!-- Rows come from Styles/LeveledListRowTemplate.xaml - shared by all four views that
                                                 show a container's leveled lists, so a change to the row cannot reach only one. -->
                                            <ItemsControl ItemsSource="{Binding LVLiEntries}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="Add to Selection"
                                Command="{Binding ApplyContainersCommand}"
                                Style="{StaticResource ActionButtonStyle}"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
