<Window x:Class="SkyrimCraftingTool.View.ChangedListsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Leveled lists changed by you"
        Width="720" Height="480"
        Background="{DynamicResource ColorBackgroundBase}"
        TextElement.Foreground="{DynamicResource ColorTextPrimary}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Summary}"
                   Foreground="{DynamicResource ColorTextSecondary}"
                   TextWrapping="Wrap" Margin="0,0,0,10"/>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Rows}">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8" Margin="0,0,0,6" CornerRadius="4"
                            Background="{DynamicResource ColorBackgroundControl}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Reset" Width="80"
                                    Command="{Binding ResetCommand}"
                                    Style="{StaticResource StandardButtonStyle}"
                                    ToolTip="Put this list back to what your load order says. The patch stops changing it."/>

                            <StackPanel>
                                <TextBlock Text="{Binding Display}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Changes}"
                                           Foreground="{DynamicResource ColorWarning}"
                                           TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding ListKey}"
                                           Foreground="{DynamicResource ColorTextTertiary}"
                                           FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Width="90" IsCancel="True"
                    Style="{StaticResource StandardButtonStyle}"/>
            <Button DockPanel.Dock="Right" Content="Reset all" Width="90" Margin="0,0,8,0"
                    Command="{Binding ResetAllCommand}"
                    Style="{StaticResource StandardButtonStyle}"
                    Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="These are list properties, not placements - your items stay where you put them."
                       Foreground="{DynamicResource ColorTextTertiary}"
                       FontSize="11" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
