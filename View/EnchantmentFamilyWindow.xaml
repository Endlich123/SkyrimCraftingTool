<Window x:Class="SkyrimCraftingTool.View.EnchantmentFamilyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apply effects to the tier variants"
        Width="900" Height="560"
        Background="{DynamicResource ColorBackgroundBase}"
        TextElement.Foreground="{DynamicResource ColorTextPrimary}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Summary}"
                   Foreground="{DynamicResource ColorTextSecondary}"
                   TextWrapping="Wrap" Margin="0,0,0,4"/>

        <TextBlock Grid.Row="1"
                   Text="The tiers are a ladder of their own values, so a new effect is scaled by where each variant sits relative to this one — not copied. Every number below can be overwritten."
                   Foreground="{DynamicResource ColorTextSecondary}"
                   TextWrapping="Wrap" Margin="0,0,0,10"/>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding Rows}">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource ColorBorder}"
                            BorderThickness="0,0,0,1"
                            Padding="0,5"
                            Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <CheckBox Grid.Row="0" Grid.Column="0"
                                      IsChecked="{Binding IsSelected}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"/>

                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding ChildName}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource ColorTextPrimary}"/>

                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Action}"
                                           FontWeight="Bold"
                                           Margin="0,0,6,0"
                                           Foreground="{DynamicResource ColorAccentLight}"/>
                                <TextBlock Text="{Binding EffectLabel}"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource ColorTextPrimary}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="0" Grid.Column="3"
                                       Text="{Binding FactorText}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,10,0"
                                       Foreground="{DynamicResource ColorTextSecondary}"/>

                            <!-- Values only mean something for an addition; a removal takes the row
                                 away whatever it holds. -->
                            <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRemoval}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBlock Text="mag" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ColorTextSecondary}" Margin="0,0,3,0"/>
                                <TextBox Text="{Binding Magnitude}" Width="60"
                                         Style="{StaticResource ItemTextBoxStyle}" Margin="0,0,6,0"/>
                                <TextBlock Text="dur" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ColorTextSecondary}" Margin="0,0,3,0"/>
                                <TextBox Text="{Binding Duration}" Width="50"
                                         Style="{StaticResource ItemTextBoxStyle}" Margin="0,0,6,0"/>
                                <TextBlock Text="area" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ColorTextSecondary}" Margin="0,0,3,0"/>
                                <TextBox Text="{Binding Area}" Width="50"
                                         Style="{StaticResource ItemTextBoxStyle}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3"
                                       Text="{Binding Note}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"
                                       Foreground="{DynamicResource ColorWarning}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource StandardButtonStyle}"
                    Width="110" Margin="0,0,8,0"/>
            <Button Content="Apply checked"
                    Command="{Binding ApplyCommand}"
                    Style="{StaticResource ActionButtonStyle}"
                    Width="140" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
