<Window x:Class="SkyrimCraftingTool.View.ModularDryRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SkyrimCraftingTool.ViewModel"
        Title="Modular presets - dry run"
        Width="1200" Height="820"
        Background="{DynamicResource ColorBackgroundBase}"
        TextElement.Foreground="{DynamicResource ColorTextPrimary}"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- A card turns red when it is switched off: left out of every Apply. The trigger sits in each
             typed template (both card types have IsIncluded), the look here. -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ColorBackgroundPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <!-- Cards, not a selectable list: no selection highlight, no focus rectangle. -->
        <Style x:Key="PlainItemStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A removable addon name. -->
        <DataTemplate DataType="{x:Type local:DryRunChipVM}">
            <Border Background="{DynamicResource ColorChipBackground}" CornerRadius="4" Padding="6,2" Margin="0,0,4,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name, Mode=OneWay}" Foreground="{DynamicResource ColorChipText}" VerticalAlignment="Center"/>
                    <Button Content="×" Command="{Binding RemoveCommand}" Padding="4,0" Margin="4,0,0,0"
                            Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ColorChipText}" Cursor="Hand"
                            ToolTip="Remove"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="ChipPanel"><WrapPanel/></ItemsPanelTemplate>

        <!-- Open / close a card: ▸ closed, ▾ open. -->
        <Style x:Key="CardToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Open / close the card"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <TextBlock x:Name="Glyph" Text="▸" FontSize="14" Foreground="{DynamicResource ColorTextSecondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Glyph" Property="Text" Value="▾"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type local:DryRunItemCardVM}">
            <Border Padding="8,6" Margin="0,0,0,6">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsIncluded}" Value="False">
                                <Setter Property="Background" Value="{DynamicResource ColorSurfaceDanger}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ColorDanger}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Left" IsChecked="{Binding IsExpanded}" Style="{StaticResource CardToggleStyle}" Margin="0,0,2,0"/>
                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsIncluded}" VerticalAlignment="Center" Margin="0,0,8,0"
                                  ToolTip="Patch this item. Off: left out of every Apply - remembered for next time."/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Short, Mode=OneWay}" Foreground="{DynamicResource ColorTextTertiary}"
                                   FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <TextBlock Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <!-- Closed: the header line only. -->
                    <StackPanel Visibility="{Binding IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <WrapPanel Margin="24,4,0,0">
                        <TextBlock Text="Type" Foreground="{DynamicResource ColorTextTertiary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox Width="110" ItemsSource="{Binding TypeOptions, Mode=OneWay}" SelectedItem="{Binding SelectedType}" Style="{StaticResource CompactComboBoxStyle}" Margin="0,0,10,4"/>
                        <TextBlock Text="Material" Foreground="{DynamicResource ColorTextTertiary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox Width="170" ItemsSource="{Binding MaterialOptions, Mode=OneWay}" SelectedItem="{Binding SelectedMaterial}" Style="{StaticResource CompactComboBoxStyle}" Margin="0,0,10,4"/>
                        <!-- Weapons have no slots. -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding ShowSlots, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Slot" Foreground="{DynamicResource ColorTextTertiary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox Width="130" ItemsSource="{Binding SlotOptions, Mode=OneWay}" SelectedItem="{Binding SelectedSlot}" Style="{StaticResource CompactComboBoxStyle}" Margin="0,0,10,4"/>
                        </StackPanel>
                        <TextBlock Text="+ Addon" Foreground="{DynamicResource ColorTextTertiary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox Width="150" ItemsSource="{Binding AddonOptions, Mode=OneWay}" SelectedItem="{Binding AddonToAdd}" Style="{StaticResource CompactComboBoxStyle}" Margin="0,0,4,4"/>
                        <Button Content="Add" Command="{Binding AddAddonCommand}" Style="{StaticResource StandardButtonStyle}" Padding="8,0" Margin="0,0,10,4"/>
                        <Button Content="Reset" Command="{Binding ResetChoiceCommand}" Style="{StaticResource StandardButtonStyle}" Padding="8,0" Margin="0,0,0,4"
                                ToolTip="Back to what the pre-fill (and the plugin card) gives this item."/>
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding Addons, Mode=OneWay}" ItemsPanel="{StaticResource ChipPanel}" Margin="24,2,0,0"/>
                    <TextBlock Text="{Binding Assignment, Mode=OneWay}" Foreground="{DynamicResource ColorTextSecondary}"
                               TextWrapping="Wrap" Margin="24,2,0,0"/>
                    <TextBlock Text="{Binding Stats, Mode=OneWay}" Margin="24,2,0,0"/>
                    <TextBlock Text="{Binding Keywords, Mode=OneWay}" Foreground="{DynamicResource ColorTextSecondary}"
                               TextWrapping="Wrap" FontSize="11" Margin="24,2,0,0"/>
                    <TextBlock Text="{Binding Craft, Mode=OneWay}" Foreground="{DynamicResource ColorTextTertiary}"
                               TextWrapping="Wrap" FontSize="11" Margin="24,2,0,0"/>
                    <TextBlock Text="{Binding Notes, Mode=OneWay}" Foreground="{DynamicResource ColorWarning}"
                               Visibility="{Binding HasNotes, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                               TextWrapping="Wrap" FontSize="11" Margin="24,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:DryRunPluginCardVM}">
            <Border Padding="12,10" Margin="0,0,0,10">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsIncluded}" Value="False">
                                <Setter Property="Background" Value="{DynamicResource ColorSurfaceDanger}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ColorDanger}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Left" IsChecked="{Binding IsExpanded}" Style="{StaticResource CardToggleStyle}" Margin="0,0,4,0"/>
                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsIncluded}" VerticalAlignment="Center" Margin="0,0,10,0"
                                  ToolTip="Patch this plugin. Off: none of its items is applied - remembered for next time."/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Counts, Mode=OneWay}"
                                   Foreground="{DynamicResource ColorTextTertiary}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <!-- Closed: the header line only. -->
                    <StackPanel Visibility="{Binding IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <WrapPanel Margin="28,8,0,0">
                        <TextBlock Text="Preset for all items:" Foreground="{DynamicResource ColorTextTertiary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Type" Foreground="{DynamicResource ColorTextTertiary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox Width="110" ItemsSource="{Binding TypeOptions, Mode=OneWay}" SelectedItem="{Binding SelectedType}" Style="{StaticResource CompactComboBoxStyle}" Margin="0,0,10,4"/>
                        <TextBlock Text="Material" Foreground="{DynamicResource ColorTextTertiary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox Width="170" ItemsSource="{Binding MaterialOptions, Mode=OneWay}" SelectedItem="{Binding SelectedMaterial}" Style="{StaticResource CompactComboBoxStyle}" Margin="0,0,10,4"/>
                        <TextBlock Text="+ Addon" Foreground="{DynamicResource ColorTextTertiary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox Width="150" ItemsSource="{Binding AddonOptions, Mode=OneWay}" SelectedItem="{Binding AddonToAdd}" Style="{StaticResource CompactComboBoxStyle}" Margin="0,0,4,4"/>
                        <Button Content="Add" Command="{Binding AddAddonCommand}" Style="{StaticResource StandardButtonStyle}" Padding="8,0" Margin="0,0,10,4"/>
                        <Button Content="Reset" Command="{Binding ResetChoiceCommand}" Style="{StaticResource StandardButtonStyle}" Padding="8,0" Margin="0,0,0,4"
                                ToolTip="Back to what the pre-fill detects per item."/>
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding AddedAddons, Mode=OneWay}" ItemsPanel="{StaticResource ChipPanel}" Margin="28,2,0,0"/>

                    <Grid Margin="28,6,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="Type" Foreground="{DynamicResource ColorTextTertiary}"/>
                        <TextBlock Grid.Column="1" Text="{Binding TypeTally, Mode=OneWay}" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="1" Text="Material" Foreground="{DynamicResource ColorTextTertiary}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MaterialTally, Mode=OneWay}" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="2" Text="Addons" Foreground="{DynamicResource ColorTextTertiary}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AddonTally, Mode=OneWay}" TextWrapping="Wrap"/>
                    </Grid>

                    <Expander Header="{Binding ItemsHeader, Mode=OneWay}" IsExpanded="{Binding ItemsExpanded}" Margin="28,8,0,0"
                              Foreground="{DynamicResource ColorTextPrimary}">
                        <!-- Own scroll area: a plugin with 2,000 items stays virtualized. -->
                        <ListBox ItemsSource="{Binding VisibleItems, Mode=OneWay}" MaxHeight="560" Margin="0,6,0,0"
                                 Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource PlainItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"/>
                    </Expander>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Summary, Mode=OneWay}"
                   Foreground="{DynamicResource ColorTextSecondary}"
                   TextWrapping="Wrap" Margin="0,0,0,8"/>

        <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="False">
            <!-- Armor or weapons: two catalogs, and each remembers its own switched-off plugins and choices. -->
            <RadioButton DockPanel.Dock="Left" Content="Armor" IsChecked="{Binding ShowArmor}" GroupName="DryRunKind"
                         Foreground="{DynamicResource ColorTextPrimary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <RadioButton DockPanel.Dock="Left" Content="Weapons" IsChecked="{Binding ShowWeapons}" GroupName="DryRunKind"
                         Foreground="{DynamicResource ColorTextPrimary}" VerticalAlignment="Center" Margin="0,0,18,0"/>
            <TextBox DockPanel.Dock="Left" Width="240" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource ItemTextBoxStyle}" Margin="0,0,12,0"
                     ToolTip="Search plugin and item names. The buttons act on what is shown."/>
            <CheckBox DockPanel.Dock="Left" Content="Only items that change" IsChecked="{Binding OnlyChanging}"
                      Foreground="{DynamicResource ColorTextPrimary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <CheckBox DockPanel.Dock="Left" Content="Only items with notes" IsChecked="{Binding OnlyWithNotes}"
                      Foreground="{DynamicResource ColorTextPrimary}" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button DockPanel.Dock="Left" Content="All on" Width="70" Margin="0,0,6,0"
                    Command="{Binding AllPluginsOnCommand}" Style="{StaticResource StandardButtonStyle}"
                    ToolTip="Switch on every plugin card shown."/>
            <Button DockPanel.Dock="Left" Content="All off" Width="70" Margin="0,0,16,0"
                    Command="{Binding AllPluginsOffCommand}" Style="{StaticResource StandardButtonStyle}"
                    ToolTip="Switch off every plugin card shown."/>
            <Button DockPanel.Dock="Left" Content="Expand" Width="70" Margin="0,0,6,0"
                    Command="{Binding ExpandAllCommand}" Style="{StaticResource StandardButtonStyle}" ToolTip="Open every plugin card shown."/>
            <Button DockPanel.Dock="Left" Content="Collapse" Width="70" Margin="0,0,6,0"
                    Command="{Binding CollapseAllCommand}" Style="{StaticResource StandardButtonStyle}" ToolTip="Close every plugin card shown."/>
            <Button DockPanel.Dock="Left" Content="Reset all" Width="80" Margin="16,0,0,0"
                    Command="{Binding ResetAllCommand}" Style="{StaticResource ActionButtonWarmStyle}"
                    ToolTip="Every card shown back to on and (auto): preset combinations and switched-off plugins and items are dropped. Asks first; the items themselves are not changed."/>
        </DockPanel>

        <ListBox Grid.Row="2" ItemsSource="{Binding PluginCardsView, Mode=OneWay}"
                 Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{StaticResource PlainItemStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"/>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Width="90" IsCancel="True"
                    Style="{StaticResource StandardButtonStyle}"/>
            <Button DockPanel.Dock="Right" Content="Edit building blocks" Width="150" Margin="0,0,8,5"
                    Command="{Binding EditCatalogCommand}"
                    Style="{StaticResource StandardButtonStyle}"
                    ToolTip="Open the building-block editor. The cards are computed again with what you save."/>
            <Button DockPanel.Dock="Right" Content="Apply" Width="100" Margin="0,0,8,5"
                    Command="{Binding ApplyCommand}"
                    Style="{StaticResource ActionButtonWarmStyle}"
                    ToolTip="Write the result to every item that is shown and switched on (plugin and item). Asks first; each item can be reverted with its Reset button."/>
            <TextBlock Foreground="{DynamicResource ColorTextTertiary}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="{Binding CatalogPath, Mode=OneWay, StringFormat=Dry run - nothing is written until you press Apply. Switched-off plugins and items are remembered. Building blocks: {0}}"/>
        </DockPanel>
    </Grid>
</Window>
