<Window x:Class="SkyrimCraftingTool.View.FolderChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose your folders"
        Width="640"
        SizeToContent="Height"
        Background="{StaticResource ColorBackgroundBase}"
        TextElement.Foreground="{StaticResource ColorTextPrimary}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Dark TextBox with a placeholder driven by Tag. -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource ColorBackgroundControl}"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                                <TextBlock x:Name="Placeholder"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="{StaticResource ColorTextTertiary}"
                                           Margin="{TemplateBinding Padding}"
                                           IsHitTestVisible="False"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ColorTextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="2,0,0,3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Game Data folder"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Browse…" Width="76" VerticalAlignment="Stretch" Margin="6,0,0,0"
                        Style="{StaticResource StandardButtonStyle}" Click="SelectGameDataPath_Click"/>
                <TextBox x:Name="GameDataPathBox" Tag="…\Skyrim Special Edition\Data"/>
            </DockPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Mods folder"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Browse…" Width="76" VerticalAlignment="Stretch" Margin="6,0,0,0"
                        Style="{StaticResource StandardButtonStyle}" Click="SelectModDirectoryPath_Click"/>
                <TextBox x:Name="ModDirectoryPathBox" Tag="your mod manager's mods folder"/>
            </DockPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Style="{StaticResource FieldLabel}" Text="plugins.txt"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Browse…" Width="76" VerticalAlignment="Stretch" Margin="6,0,0,0"
                        Style="{StaticResource StandardButtonStyle}" Click="SelectPluginsFilePath_Click"/>
                <TextBox x:Name="PluginsFilePathBox" Tag="MO2: profiles\&lt;profile&gt;\plugins.txt  ·  vanilla: %LocalAppData%\Skyrim Special Edition\plugins.txt"/>
            </DockPanel>
        </StackPanel>

        <Button Grid.Row="3" Content="Save" Height="32" Width="120" HorizontalAlignment="Right" Margin="0,6,0,0"
                Style="{StaticResource ActionButtonStyle}" Click="SaveAndClose_Click"/>
    </Grid>
</Window>
