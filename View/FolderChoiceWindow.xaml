<Window x:Class="SkyrimCraftingTool.View.FolderChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose your folders"
        Width="640"
        SizeToContent="Height"
        Background="{DynamicResource ColorBackgroundBase}"
        TextElement.Foreground="{DynamicResource ColorTextPrimary}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Dark TextBox with a placeholder driven by Tag. -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ColorBackgroundControl}"/>
            <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                                <TextBlock x:Name="Placeholder"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="{DynamicResource ColorTextTertiary}"
                                           Margin="{TemplateBinding Padding}"
                                           IsHitTestVisible="False"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ColorTextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="2,0,0,3"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ColorTextTertiary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="2,4,0,0"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- The manager question comes FIRST because it decides ONE thing the paths cannot say:
             which copy of a duplicated plugin file the scan reads (see Services/PluginPathPicker).
             Two answers, because every manager that deploys behaves identically here. -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Mod manager"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="Mo2Radio" Content="Mod Organizer 2" GroupName="Manager" Checked="ManagerChanged"/>
                <RadioButton x:Name="OtherRadio" Content="Other Manager (Vortex, etc) / Base Game" GroupName="Manager" Checked="ManagerChanged"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Game Data folder"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Browse…" Width="76" VerticalAlignment="Stretch" Margin="6,0,0,0"
                        Style="{StaticResource StandardButtonStyle}" Click="SelectGameDataPath_Click"/>
                <TextBox x:Name="GameDataPathBox" Tag="…\Skyrim Special Edition\Data"/>
            </DockPanel>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock x:Name="ModsFolderLabel" Style="{StaticResource FieldLabel}" Text="Mods folder"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Browse…" Width="76" VerticalAlignment="Stretch" Margin="6,0,0,0"
                        Style="{StaticResource StandardButtonStyle}" Click="SelectModDirectoryPath_Click"/>
                <TextBox x:Name="ModDirectoryPathBox" Tag="your mod manager's mods folder"/>
            </DockPanel>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,8">
            <TextBlock Style="{StaticResource FieldLabel}" Text="plugins.txt"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Browse…" Width="76" VerticalAlignment="Stretch" Margin="6,0,0,0"
                        Style="{StaticResource StandardButtonStyle}" Click="SelectPluginsFilePath_Click"/>
                <!-- "your profile name", not "<profile>": a tester read the angle brackets as part of the
                     path and typed them in literally. The Browse button beside it is the way out of
                     that, but the hint should not be sending anyone there in the first place. -->
                <TextBox x:Name="PluginsFilePathBox" Tag="MO2: profiles\your profile name\plugins.txt  ·  vanilla: %LocalAppData%\Skyrim Special Edition\plugins.txt"/>
            </DockPanel>
        </StackPanel>

        <!-- MO2 only, and filled in from the plugins.txt above - the two live in the same profile
             folder. This is the mod PRIORITY, the only thing that can say which copy of a
             duplicated plugin file MO2 actually loads. Optional: without it the scan still works,
             it just falls back to "a mod folder beats the game folder" without the ordering. -->
        <StackPanel x:Name="ModListPanel" Grid.Row="5" Margin="0,0,0,8" Visibility="Collapsed">
            <TextBlock Style="{StaticResource FieldLabel}" Text="modlist.txt (found next to plugins.txt — decides which copy of a duplicated plugin wins)"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Browse…" Width="76" VerticalAlignment="Stretch" Margin="6,0,0,0"
                        Style="{StaticResource StandardButtonStyle}" Click="SelectModListFilePath_Click"/>
                <TextBox x:Name="ModListFilePathBox" Tag="profiles\your profile name\modlist.txt"/>
            </DockPanel>
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="6" Style="{StaticResource HintText}"/>

        <Button Grid.Row="7" Content="Save" Height="32" Width="120" HorizontalAlignment="Right" Margin="0,10,0,0"
                Style="{StaticResource ActionButtonStyle}" Click="SaveAndClose_Click"/>
    </Grid>
</Window>
