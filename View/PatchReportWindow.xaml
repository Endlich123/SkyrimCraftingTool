<Window x:Class="SkyrimCraftingTool.View.PatchReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SkyrimCraftingTool.View"
        Title="Patch report"
        Width="900" Height="620"
        MinWidth="500" MinHeight="300"
        Background="{DynamicResource ColorBackgroundBase}"
        TextElement.Foreground="{DynamicResource ColorTextPrimary}"
        WindowStartupLocation="CenterOwner">

    <!-- The end of Generate Patch / Preview Patch. Was a MessageBox: with 10,000+ edits the report
         grew taller than the screen and its buttons were out of reach (2026-10-26). A scrolling,
         selectable box instead, with the buttons always at the bottom. -->
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeadlineText" Style="{StaticResource TitelStyle}" Margin="0,0,0,10"
                   TextWrapping="Wrap"/>

        <!-- Read-only TextBox rather than a TextBlock: parts of the report get copied into bug
             reports, and a ScrollViewer around a TextBlock gives no selection. -->
        <TextBox Grid.Row="1"
                 x:Name="ReportBox"
                 IsReadOnly="True"
                 FontFamily="Consolas"
                 FontSize="12"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 Background="{DynamicResource ColorBackgroundControl}"
                 Foreground="{DynamicResource ColorTextPrimary}"
                 BorderBrush="{DynamicResource ColorBorder}"
                 BorderThickness="1"
                 Padding="6"/>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Width="90" IsCancel="True" IsDefault="True"
                    Style="{StaticResource StandardButtonStyle}"/>
            <StackPanel Orientation="Horizontal">
                <!-- Main action of the window, so ActionButtonStyle instead of the implicit Open Folder
                     look; the tooltip with the path is set with FolderPath in code. -->
                <views:OpenFolderButton x:Name="OutputFolderButton" Content="Open output folder" Width="140"
                                        Style="{StaticResource ActionButtonStyle}"/>
                <Button x:Name="OpenFileButton" Content="Open report file" Width="120" Click="OpenFile_Click"
                        Style="{StaticResource StandardButtonStyle}"
                        ToolTip="The same report as a text file in the Logs folder - kept after this window is closed."/>
                <Button Content="Copy" Width="80" Click="Copy_Click"
                        Style="{StaticResource StandardButtonStyle}"/>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="{DynamicResource ColorTextSecondary}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
