<Window x:Class="SkyrimCraftingTool.View.ImportConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Conflicts"
        Width="760" Height="500"
        Background="{StaticResource ColorBackgroundBase}"
        TextElement.Foreground="{StaticResource ColorTextPrimary}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource TitelStyle}" Margin="0,0,0,12"
                   Text="These items were edited locally more recently than in the import file. Please decide per item:"
                   TextWrapping="Wrap"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="All: Keep Local" Style="{StaticResource StandardButtonStyle}" Width="150" Click="KeepAllLocal_Click"/>
            <Button Content="All: Use Import" Style="{StaticResource StandardButtonStyle}" Width="150" Click="UseAllFile_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="2"
                  Style="{StaticResource DarkDataGridStyle}"
                  ItemsSource="{Binding Rows}"
                  IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Table" Binding="{Binding Table}" Width="80" MinWidth="60" IsReadOnly="True"/>
                <DataGridTextColumn Header="Item" Binding="{Binding DisplayName}" Width="*" MinWidth="140" IsReadOnly="True"/>
                <DataGridTextColumn Header="Locally Changed" Binding="{Binding LocalLastChanged}" Width="170" MinWidth="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="File Changed" Binding="{Binding FileLastChanged}" Width="170" MinWidth="120" IsReadOnly="True"/>
                <DataGridCheckBoxColumn Header="Use Import" Binding="{Binding UseFileVersion, Mode=TwoWay}" Width="110" MinWidth="90"
                                        ElementStyle="{StaticResource DataGridCheckBoxCellStyle}"
                                        EditingElementStyle="{StaticResource DataGridCheckBoxCellStyle}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Style="{StaticResource StandardButtonStyle}" Width="100" Click="Cancel_Click"/>
            <Button Content="Apply" Style="{StaticResource ActionButtonWarmStyle}" Width="100" Margin="6,0,0,5" Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
