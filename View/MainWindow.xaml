<Window x:Class="SkyrimCraftingTool.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SkyrimCraftingTool.ViewModel"
        xmlns:views="clr-namespace:SkyrimCraftingTool.View"
        Title="Skyrim Crafting Tool"
        MinWidth="900" MinHeight="700"
        TextElement.Foreground="{DynamicResource ColorTextPrimary}"
        Background="{DynamicResource ColorBackgroundBase}">

    <Window.Resources>

        <DataTemplate DataType="{x:Type vm:MainContentVM}">
            <views:MainContentView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:EnchantmentMenuVM}">
            <views:EnchantmentMenuView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:NpcMenuVM}">
            <views:NpcMenuView />
        </DataTemplate>

        <!-- Same view model as the NPC tab; the wrapper only carries a second type so the
             shell can tell the tabs apart. See TemplateTabVM. -->
        <DataTemplate DataType="{x:Type vm:TemplateTabVM}">
            <views:TemplateListView DataContext="{Binding Npc}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:NpcGroupVM}">
            <views:NpcGroupView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PresetsConfigVM}">
            <views:PresetsConfigView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SettingsVM}">
            <views:SettingsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:WorldContentVM}">
            <views:WorldContentView />
        </DataTemplate>

    </Window.Resources>


    <DockPanel>
        <!-- Shell toolbar: nav tabs on the left, app-wide actions on the right.
             "Generate Patch" lives here rather than in the Items view because it covers everything -
             armor, weapons, recipes, enchantments and form lists. It binds through to ContentVM,
             which still owns the command (services + autosave flush live there). -->
        <DockPanel DockPanel.Dock="Top" Background="{DynamicResource ColorBackgroundBase}">

            <!-- TOP, not centred. These have a fixed height and the default Stretch alignment, which
                 WPF resolves by centring them in whatever height they are given. While the nav row
                 was one line that looked like the top; the moment it wraps, the header doubles and
                 the action buttons slide down to float between the two rows. They belong beside the
                 FIRST row of tabs, whatever the row does below. -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        VerticalAlignment="Top" Margin="0,10,12,0">
                <!-- The two patch toggles that used to sit here moved into the Settings view:
                     "One ESP per plugin" as-is, and "Write patch next to app" replaced by a free
                     output-folder picker, which covers that case and every other one. -->

                <!-- Height and the top offset match the nav tabs opposite, so the two groups sit on
                     one line. The WIDTHS are their own: these three say what they do and keep the
                     size that fits, while the nav tabs now size to their labels. ActionButtonStyle
                     only sets MinHeight and carries its own margin, which left it visibly smaller
                     and 5px too high. -->
                <!-- Bug report: builds a local text report (versions, paths, DB state, log).
                     Nothing is sent anywhere - see LogViewerWindow. -->
                <Button Content="Log / Bug report"
                        Command="{Binding OpenLogViewerCommand}"
                        Style="{StaticResource StandardButtonStyle}"
                        Width="120" Height="30" Margin="0,0,14,0"
                        ToolTip="View the log and build a bug report you can copy or save. Nothing leaves your PC."/>
                <!-- Same run as the button next to it, stopped before anything is written. Styled as
                     a secondary button so the writing one stays the obvious primary action. -->
                <Button Content="Preview Patch"
                        Command="{Binding ContentVM.PreviewPatchCommand}"
                        Style="{StaticResource StandardButtonStyle}"
                        Width="120" Height="30" Margin="0,0,8,0"
                        ToolTip="Works out exactly what Generate Patch would produce - rule counts, recipes, warnings - and writes nothing."/>
                <Button Content="Generate Patch"
                        Command="{Binding ContentVM.GeneratePatchCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        Width="150" Height="30" Margin="0"
                        ToolTip="SkyPatcher INIs for every edited armor, weapon, enchantment and form list, plus SkyrimCraftingTool.esp for created/edited recipes and re-pointed worn-restriction lists."/>
            </StackPanel>

            <!-- A WrapPanel, and that is the whole guarantee: a StackPanel in the fill slot of a
                 DockPanel does not shrink and does not scroll, it is simply cut off at the right
                 edge - and the last button in the row is Settings. At the window's own minimum
                 width of 900 the row was over 600px too long, so the one tab that must always be
                 reachable was the one that disappeared.
                 Wrapping costs a second row of header at narrow widths, which is a price paid only
                 by someone who has already made the window that small; nothing is ever unreachable.
                 The tabs they never use can be switched off in Settings, which puts the row back on
                 one line. -->
            <!-- THE INSETS BELONG TO THE PANEL, THE GAPS TO THE BUTTONS. On one line the two are
                 indistinguishable; wrapped, they are not:
                   a left margin on the first button indents row one and leaves every row under it
                   starting 12px further left;
                   a top margin on every button is a gap BETWEEN rows as well as above the first one,
                   so 10 above plus 6 below put the rows 16px apart while the buttons beside each
                   other sat 7px apart.
                 The panel now carries the 12/10 offset into the header, and each button carries 7 to
                 its right and 7 below: one gap, both directions. -->
            <WrapPanel Orientation="Horizontal" Margin="12,10,0,0">
                <Button Content="Items"
                        Command="{Binding OpenMainContentCommand}"
                        Style="{StaticResource NavTabButtonStyle}"
                        Tag="{Binding IsMainContentActive}"
                        Margin="0,0,7,7"/>
                <Button Content="Enchantments"
                        Command="{Binding OpenEnchantmentMenuCommand}"
                        Style="{StaticResource NavTabButtonStyle}"
                        Tag="{Binding IsEnchantmentActive}"
                        Visibility="{Binding ShowEnchantments, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,7,7"/>

                <Button Content="NPCs"
                        Command="{Binding OpenNpcMenuCommand}"
                        Style="{StaticResource NavTabButtonStyle}"
                        Tag="{Binding IsNpcActive}"
                        Visibility="{Binding ShowNpcs, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,7,7"/>

                <!-- THE TEMPLATES TAB HAS NO NAV BUTTON ANY MORE (2026-09-26).
                     It existed because 4.039 of 6.580 NPCs take their stats from a template, so the
                     template looked like the only lever that moves them - a faction rule on stats
                     reached 613 NPCs and moved 110 (docs/NPC-Plan.md section 12). Measured in game on
                     2026-09-26, that is not true of a SkyPatcher rule: three inheriting records, two
                     different templates, all moved to the patched values (NPC-Gruppen-Plan.md section
                     3.4). A group rule reaches them directly, so the detour is gone.

                     The view itself stays reachable: following an NPC's template link still opens it
                     (NpcVM.TemplateOpened in MainWindowVM). Only the tab is gone. -->

                <!-- The group editor (docs/NPC-Gruppen-Plan.md). Its own tab rather than a pane in the
                     NPC tab: the work unit there is one record, the work unit here is a filter set,
                     and the two screens answer different questions. -->
                <Button Content="NPC groups"
                        Command="{Binding OpenNpcGroupsCommand}"
                        Style="{StaticResource NavTabButtonStyle}"
                        Tag="{Binding IsNpcGroupsActive}"
                        Visibility="{Binding ShowNpcGroups, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,7,7"/>

                <!-- Where things are taken OUT of containers and lists. Its own tab because this is
                     the one part of the tool that is not additive - see WorldContentVM. -->
                <Button Content="Container/LeveledList"
                        Command="{Binding OpenWorldCommand}"
                        Style="{StaticResource NavTabButtonStyle}"
                        Tag="{Binding IsWorldActive}"
                        Visibility="{Binding ShowWorld, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,7,7"/>

                <Button Content="Presets"
                        Command="{Binding OpenPresetsConfigCommand}"
                        Style="{StaticResource NavTabButtonStyle}"
                        Tag="{Binding IsPresetsActive}"
                        Visibility="{Binding ShowPresets, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,7,7"/>

                <Button Content="Settings"
                        Command="{Binding OpenSettingsCommand}"
                        Style="{StaticResource NavTabButtonStyle}"
                        Tag="{Binding IsSettingsActive}"
                        Margin="0,0,7,7"/>
            </WrapPanel>
        </DockPanel>

        <Border DockPanel.Dock="Top"
            BorderBrush="{DynamicResource ColorBorder}"
            BorderThickness="0,0,0,1"
            Height="1"
            Margin="0,5,0,5"/>

        <!-- Issue status strip: only visible when there is something to show. Click the summary to
             expand the list; "Clear" empties it. Fed by IssueHub.Current. -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource ColorBackgroundControl}"
                BorderBrush="{DynamicResource ColorBorder}"
                BorderThickness="0,1,0,0"
                Padding="8,3"
                Visibility="{Binding Issues.HasIssues, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="Clear"
                        Command="{Binding ClearIssuesCommand}"
                        Style="{StaticResource StandardButtonStyle}"/>

                <ToggleButton x:Name="IssueToggle"
                              HorizontalAlignment="Left"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="{DynamicResource ColorWarning}"
                              Content="{Binding Issues.Summary, StringFormat=⚠ {0}}"/>

                <Popup IsOpen="{Binding IsChecked, ElementName=IssueToggle}"
                       PlacementTarget="{Binding ElementName=IssueToggle}"
                       Placement="Top"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       MaxWidth="640"
                       MaxHeight="320">
                    <Border Background="{DynamicResource ColorBackgroundBase}"
                            BorderBrush="{DynamicResource ColorBorder}"
                            BorderThickness="1"
                            Padding="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Issues.Issues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,3">
                                            <TextBlock Text="{Binding Message}"
                                                       Foreground="{DynamicResource ColorTextPrimary}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Context}"
                                                       Foreground="{DynamicResource ColorTextSecondary}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </DockPanel>
        </Border>

        <ContentControl Content="{Binding CurrentView}" />
    </DockPanel>
</Window>