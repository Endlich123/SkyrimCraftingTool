<UserControl x:Class="SkyrimCraftingTool.View.EnchantmentMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SkyrimCraftingTool.ViewModel"
             xmlns:model="clr-namespace:SkyrimCraftingTool.Model">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: TREEVIEW -->
        <Border BorderBrush="{StaticResource ColorBorder}"
                BorderThickness="1"
                Padding="5"
                Margin="0,0,10,0"
                Background="{StaticResource ColorBackgroundPanel}">
            <TreeView ItemsSource="{Binding TreeItems}"
          SelectedItemChanged="TreeView_SelectedItemChanged"
          Background="{StaticResource ColorBackgroundControl}"
          Foreground="{StaticResource ColorTextPrimary}">

                <!-- Container-Style wie in MainContentView -->
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="Padding" Value="2" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />

                        <Style.Resources>
                            <!-- Fokus-Selection -->
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                 Color="#444444"/>
                            <!-- Inaktive Selection -->
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                                 Color="#333333"/>
                        </Style.Resources>
                    </Style>
                </TreeView.ItemContainerStyle>

                <!-- Deine ursprünglichen Templates -->
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding DisplayName}"
                       Foreground="{StaticResource ColorTextPrimary}"/>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <!-- RIGHT: DETAIL VIEW -->
        <Border Grid.Column="1"
                BorderBrush="{StaticResource ColorBorder}"
                BorderThickness="1"
                Padding="10"
                Background="{StaticResource ColorBackgroundPanel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel DataContext="{Binding SelectedEnchantment}">

                    <!-- TITLE -->
                    <TextBlock Text="{Binding Name}"
                               FontSize="22"
                               Foreground="{StaticResource ColorAccentLight}"
                               Margin="0,0,0,10"/>

                    <!-- BASIC INFO -->
                    <StackPanel Orientation="Vertical" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <TextBlock Grid.Row="0"
                                       Text="Basic Info"
                                       Style="{StaticResource TitelStyle}"
                                       Margin="0,0,0,5"/>

                            <!-- Key -->
                            <TextBlock Grid.Row="1"
                                       Text="Key:"
                                       Style="{StaticResource ItemLabelStyle}"/>
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding Key}"
                                       Foreground="{StaticResource ColorTextPrimary}"
                                       Margin="5"/>

                            <!-- EditorID -->
                            <TextBlock Grid.Row="2"
                                       Text="EditorID:"
                                       Style="{StaticResource ItemLabelStyle}"/>
                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Text="{Binding EditorID}"
                                       Foreground="{StaticResource ColorTextPrimary}"
                                       Margin="5"/>

                            <!-- Name -->
                            <TextBlock Grid.Row="3"
                                       Text="Name:"
                                       Style="{StaticResource ItemLabelStyle}"/>
                            <TextBox Grid.Row="3"
                                     Grid.Column="1"
                                     Text="{Binding Name}"
                                     Style="{StaticResource ItemTextBoxStyle}"/>

                            <!-- Cast Type -->
                            <TextBlock Grid.Row="4"
                                       Text="Cast Type:"
                                       Style="{StaticResource ItemLabelStyle}"/>
                            <TextBlock Grid.Row="4"
                                       Grid.Column="1"
                                       Text="{Binding CastType}"
                                       Foreground="{StaticResource ColorTextPrimary}"
                                       Margin="5"/>

                            <!-- Target Type -->
                            <TextBlock Grid.Row="5"
                                       Text="Target Type:"
                                       Style="{StaticResource ItemLabelStyle}"/>
                            <TextBlock Grid.Row="5"
                                       Grid.Column="1"
                                       Text="{Binding TargetType}"
                                       Foreground="{StaticResource ColorTextPrimary}"
                                       Margin="5"/>

                            <!-- Enchantment Cost -->
                            <TextBlock Grid.Row="6"
                                       Text="Cost:"
                                       Style="{StaticResource ItemLabelStyle}"/>
                            <TextBox Grid.Row="6"
                                     Grid.Column="1"
                                     Text="{Binding EnchantmentCost}"
                                     Style="{StaticResource ItemTextBoxStyle}"/>
                        </Grid>
                    </StackPanel>

                    <!-- EFFECTS -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Effects"
                                   Style="{StaticResource TitelStyle}"
                                   Margin="0,0,0,5"/>

                        <ItemsControl ItemsSource="{Binding DataContext.EffectVMs, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource ColorBorder}"
                                            BorderThickness="1"
                                            Padding="5"
                                            Margin="0,0,0,5"
                                            Background="{StaticResource ColorBackgroundControl}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- EditorID -->
                                            <TextBlock Grid.Row="0"
                                                       Text="EditorID:"
                                                       Style="{StaticResource ItemLabelStyle}"/>
                                            <TextBox Grid.Row="0"
                                                     Grid.Column="1"
                                                     Text="{Binding Model.EditorID}"
                                                     IsEnabled="False"
                                                     Style="{StaticResource ItemTextBoxStyle}"/>

                                            <!-- Name -->
                                            <TextBlock Grid.Row="1"
                                                       Text="Name:"
                                                       Style="{StaticResource ItemLabelStyle}"/>
                                            <TextBox Grid.Row="1"
                                                     Grid.Column="1"
                                                     Text="{Binding Model.Name}"
                                                     IsEnabled="False"
                                                     Style="{StaticResource ItemTextBoxStyle}"/>

                                            <!-- Key -->
                                            <TextBlock Grid.Row="2"
                                                       Text="Key:"
                                                       Style="{StaticResource ItemLabelStyle}"/>
                                            <TextBox Grid.Row="2"
                                                     Grid.Column="1"
                                                     Text="{Binding Model.MagicEffectKey}"
                                                     IsEnabled="False"
                                                     Style="{StaticResource ItemTextBoxStyle}"/>

                                            <!-- Magnitude -->
                                            <TextBlock Grid.Row="3"
                                                       Text="Magnitude:"
                                                       Style="{StaticResource ItemLabelStyle}"/>
                                            <TextBox Grid.Row="3"
                                                     Grid.Column="1"
                                                     Text="{Binding Model.Magnitude}"
                                                     IsEnabled="{Binding AllowsMagnitude}"
                                                     Style="{StaticResource ItemTextBoxStyle}"/>

                                            <!-- Duration -->
                                            <TextBlock Grid.Row="4"
                                                       Text="Duration:"
                                                       Style="{StaticResource ItemLabelStyle}"/>
                                            <TextBox Grid.Row="4"
                                                     Grid.Column="1"
                                                     Text="{Binding Model.Duration}"
                                                     IsEnabled="{Binding AllowsDuration}"
                                                     Style="{StaticResource ItemTextBoxStyle}"/>

                                            <!-- Area -->
                                            <TextBlock Grid.Row="5"
                                                       Text="Area:"
                                                       Style="{StaticResource ItemLabelStyle}"/>
                                            <TextBox Grid.Row="5"
                                                     Grid.Column="1"
                                                     Text="{Binding Model.Area}"
                                                     IsEnabled="{Binding AllowsArea}"
                                                     Style="{StaticResource ItemTextBoxStyle}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- WORN RESTRICTIONS -->
                    <StackPanel>
                        <TextBlock Text="Worn Restrictions"
                                   Style="{StaticResource TitelStyle}"
                                   Margin="0,0,0,5"/>

                        <DockPanel Margin="0,5">
                            <CheckBox Content="All Keywords (Expert)"
                                      IsChecked="{Binding DataContext.ShowAllKeywords, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      Style="{StaticResource ItemCheckBoxStyle}"
                                      DockPanel.Dock="Right"
                                      Margin="10,0"/>

                            <TextBlock Text="Search:"
                                       Style="{StaticResource ItemLabelStyle}"
                                       Margin="0,0,5,0"/>

                            <TextBox Text="{Binding DataContext.CurrentSearch, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ItemTextSearchBoxStyle}"/>
                        </DockPanel>

                        <GroupBox Header="Selected Keywords"
                                  Foreground="{StaticResource ColorTextPrimary}"
                                  BorderBrush="{StaticResource ColorBorder}"
                                  Margin="0,0,0,10"
                                  Padding="10">
                            <ItemsControl ItemsSource="{Binding DataContext.KeywordItems, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4"
                                                Padding="5"
                                                Margin="3"
                                                Background="{Binding IsSelected, Converter={StaticResource BoolToBrushConverter}}"
                                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding ToggleSelectedCommand}"/>
                                            </Border.InputBindings>
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{StaticResource ColorTextPrimary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </GroupBox>

                        <GroupBox Header="Keywords"
                                  Foreground="{StaticResource ColorTextPrimary}"
                                  BorderBrush="{StaticResource ColorBorder}"
                                  Margin="0,0,0,15"
                                  Padding="10">
                            <ItemsControl ItemsSource="{Binding DataContext.KeywordItems, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4"
                                                Padding="5"
                                                Margin="3"
                                                ToolTip="{Binding Key}"
                                                Background="{Binding IsSelected, Converter={StaticResource BoolToBrushConverter}}">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding ToggleSelectedCommand}"/>
                                            </Border.InputBindings>
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{StaticResource ColorTextPrimary}"
                                                       HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </GroupBox>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

    </Grid>
</UserControl>
