<Window x:Class="SkyrimCraftingTool.View.ModularCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SkyrimCraftingTool.View"
        Title="Modular presets - building blocks"
        Width="1150" Height="800"
        Background="{DynamicResource ColorBackgroundBase}"
        TextElement.Foreground="{DynamicResource ColorTextPrimary}"
        WindowStartupLocation="CenterOwner">

    <!-- The Presets tab's editor in a window, for the dry run: edit, close, see the table again. -->
    <DockPanel Margin="14">
        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Content="Close" Width="90" IsCancel="True"
                Margin="0,8,0,0" Style="{StaticResource StandardButtonStyle}"/>
        <views:ModularCatalogView/>
    </DockPanel>
</Window>
