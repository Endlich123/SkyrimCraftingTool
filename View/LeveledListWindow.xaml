<Window x:Class="SkyrimCraftingTool.View.LeveledListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:model="clr-namespace:SkyrimCraftingTool.Model"
        Title="Leveled List"
        Width="980" Height="760"
        Background="{DynamicResource ColorBackgroundBase}"
        TextElement.Foreground="{DynamicResource ColorTextPrimary}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- list properties + calculator, side by side -->
            <RowDefinition Height="Auto"/>
            <!-- this item's placement -->
            <RowDefinition Height="Auto"/>
            <!-- contents -->
            <RowDefinition Height="*"/>
            <!-- where this list is rolled -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{Binding ListName}" Style="{StaticResource TitelStyle}"
                       FontSize="18" FontWeight="Bold" Margin="0,0,0,2"/>
            <TextBlock Text="{Binding ListKey}" Foreground="{DynamicResource ColorTextTertiary}"
                       FontSize="11"/>
        </StackPanel>

        <!-- What this list does, and what it means for the object in question. The markup is
             Styles/LeveledListPropertiesPanel.xaml, shared with the Container/LeveledList tab's
             contents pane - this window is not the only place a list gets read. -->
        <ContentPresenter Grid.Row="1" Content="{Binding}"
                          ContentTemplate="{StaticResource LeveledListPropertiesPanel}"/>

        <!-- This item's placement -->
        <GroupBox Grid.Row="2" Style="{StaticResource DarkGroupBoxStyle}" Padding="10" Margin="0,0,0,10"
                  Visibility="{Binding CanPlace, Converter={StaticResource BoolToVis}}">
            <GroupBox.Header>
                <TextBlock Text="Your placement" Style="{StaticResource TitelStyle}"/>
            </GroupBox.Header>

            <StackPanel>
                <TextBlock Text="{Binding ItemName}" FontWeight="Bold" Margin="0,0,0,2"/>

                <!-- Only from the multi-select: the row is a template, nothing is written until the
                     bulk apply runs. -->
                <TextBlock Text="{Binding PlacementScopeNote}"
                           Foreground="{DynamicResource ColorWarning}"
                           TextWrapping="Wrap" FontSize="11" Margin="0,0,0,4"
                           Visibility="{Binding HasPlacementScopeNote, Converter={StaticResource BoolToVis}}"/>

                <!-- Only meaningful for real items: a preset slot has no form key, so it can never
                     be "already in this list". -->
                <TextBlock Text="{Binding AlreadyInListSummary}"
                           Foreground="{DynamicResource ColorTextTertiary}"
                           TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                           Visibility="{Binding HasSubjects, Converter={StaticResource BoolToVis}}"/>

                <CheckBox Content="Put this item into this list"
                          IsChecked="{Binding IsPlaced}"
                          Style="{StaticResource ItemCheckBoxStyle}"
                          Margin="0,0,0,8"/>

                <Grid Visibility="{Binding IsPlaced, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="From level:" Style="{StaticResource ItemLabelStyle}"
                               VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Minimum="1" Maximum="100"
                            Value="{Binding LevelDouble, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SmallChange="1" LargeChange="1" TickFrequency="1"
                            VerticalAlignment="Center" Margin="6,0,6,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding Level}" MinWidth="28"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="3" Text="Amount:" Style="{StaticResource ItemLabelStyle}"
                               VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <TextBox Grid.Column="4" Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}"
                             model:NumericTextBoxBehavior.Mode="Integer"
                             Width="46" Style="{StaticResource ItemTextBoxStyle}"
                             ToolTip="How many of this item the list hands out when it rolls this entry."/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- What the list holds today -->
        <GroupBox Grid.Row="3" Style="{StaticResource DarkGroupBoxStyle}" Padding="10">
            <GroupBox.Header>
                <TextBlock Text="What this list contains" Style="{StaticResource TitelStyle}"/>
            </GroupBox.Header>

            <ListBox ItemsSource="{Binding Contents}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="Contents_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,1,0,1">
                            <Grid.ColumnDefinitions>
                                <!-- Both markers live here, side by side. They used to sit on top of
                                     each other in one 54px cell, which was harmless while only items
                                     were ever planned - a restored entry can be a nested LIST, and on
                                     a real load order 91 of 340 lost entries are. -->
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                            <!-- A nested list is linked, not expanded. Double-click opens it in a
                                 window of its own - see the code-behind. -->
                            <TextBlock Text="List" Margin="0,0,6,0"
                                       Foreground="{DynamicResource ColorAccentLight}"
                                       FontSize="11" VerticalAlignment="Center"
                                       Visibility="{Binding IsList, Converter={StaticResource BoolToVis}}"/>

                            <!-- Not in the game yet: your patch puts it here. Marked rather than
                                 mixed in silently - what the list has and what you are adding must
                                 stay tellable apart. The words, the colours and the tooltips are
                                 Styles/PlacementTagStyle.xaml, shared with the Container tab, which
                                 says the same thing about the same kind of row. -->
                            <TextBlock Style="{StaticResource PlacementTagStyle}"/>

                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                       ToolTip="{Binding Reference}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="2" Margin="10,0,0,0"
                                       Foreground="{DynamicResource ColorTextMuted}"
                                       FontSize="11" VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="Level {0}  x{1}">
                                        <Binding Path="Level"/>
                                        <Binding Path="Count"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <!-- Who actually rolls this list. Collapsed and loaded on first expand: it walks every
             ancestor of the list and then computes odds per container, which is cheap for a leaf
             list and not cheap for one hanging under 120 of them. -->
        <Expander Grid.Row="4" Margin="0,10,0,0"
                  Header="Where this list is rolled"
                  Foreground="{DynamicResource ColorTextPrimary}"
                  IsExpanded="{Binding IsReachExpanded, Mode=TwoWay}"
                  Visibility="{Binding CanCalculate, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="0,6,0,0">
                <TextBlock Text="{Binding ReachSummary}"
                           Foreground="{DynamicResource ColorTextTertiary}"
                           TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6"/>

                <ItemsControl ItemsSource="{Binding ReachedBy}" MaxHeight="150">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,1,0,1" ToolTip="{Binding Tooltip}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ChanceText}"
                                           Foreground="{DynamicResource ColorAccentLight}"
                                           FontSize="11" Margin="10,0,0,0"/>

                                <!-- Which way in: the container holds this list itself, or it holds
                                     another list that leads here. With 120 containers reaching one
                                     list, most are the second kind, and the name of the list they
                                     enter through is the next thing anyone wants to know. -->
                                <Border DockPanel.Dock="Left" Width="62" Margin="0,0,6,0"
                                        Padding="4,0" CornerRadius="3"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Tag}" FontSize="10"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource ColorTextMuted}"/>
                                </Border>

                                <TextBlock DockPanel.Dock="Right" Text="{Binding ViaText}"
                                           Foreground="{DynamicResource ColorTextTertiary}"
                                           FontSize="10" Margin="8,0,0,0"
                                           TextTrimming="CharacterEllipsis" MaxWidth="180"/>

                                <TextBlock Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis" FontSize="11"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding ReachTruncationNote}"
                           Foreground="{DynamicResource ColorTextTertiary}"
                           FontSize="11" Margin="0,4,0,0"
                           Visibility="{Binding ReachTruncated, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Expander>

        <!-- HISTORY
             Collapsed by default and hidden entirely when there is nothing to report: on most lists
             there is nothing, and an empty box that is always there teaches people to stop looking.
             Yellow, never the amber used for the user's own edits - "this used to be here" and "you
             changed this" must not read alike. The strikethrough carries the same meaning without
             colour, for anyone who cannot tell the two apart. -->
        <Expander Grid.Row="5" Margin="0,10,0,0"
                  Foreground="{DynamicResource ColorTextPrimary}"
                  Visibility="{Binding HasLostEntries, Converter={StaticResource BoolToVis}}">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="History"/>
                    <TextBlock Text="{Binding LostEntries.Count, StringFormat=' (items lost to overrides: {0})'}"
                               Foreground="{DynamicResource ColorTextTertiary}"/>
                </StackPanel>
            </Expander.Header>

            <StackPanel Margin="0,6,0,0">
                <TextBlock Text="{Binding LostSummary}"
                           Foreground="{DynamicResource ColorTextTertiary}"
                           TextWrapping="Wrap" FontSize="11" Margin="0,0,0,2"/>

                <!-- Said plainly, because the obvious reading is the wrong one: a mod that drops an
                     entry may have meant to. Nothing here is patched unless the user says so. -->
                <TextBlock Text="A plugin may have removed these on purpose, or may simply have overwritten the list. Nothing here is written to your patch."
                           Foreground="{DynamicResource ColorTextTertiary}"
                           TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6"/>

                <!-- Selectable, not a button per row. One list measured lost 47 entries, and that is
                     almost always one decision rather than 47 - see LostEntryVM. -->
                <ListBox ItemsSource="{Binding LostEntries}" MaxHeight="150"
                         Background="Transparent" BorderThickness="0"
                         SelectionMode="Extended"
                         ItemTemplate="{StaticResource LostEntryRowTemplate}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <DockPanel Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Content="Undo selected" Width="110"
                            Command="{Binding UndoSelectedCommand}"
                            IsEnabled="{Binding HasSelectedLostEntries}"
                            Style="{StaticResource StandardButtonStyle}"
                            Margin="8,0,0,0"
                            ToolTip="Take the selected entries back out of the patch."/>

                    <Button DockPanel.Dock="Right" Content="Put back selected" Width="130"
                            Command="{Binding PutBackSelectedCommand}"
                            IsEnabled="{Binding HasSelectedLostEntries}"
                            Style="{StaticResource StandardButtonStyle}"
                            ToolTip="Add the selected entries back. The next patch puts them in at runtime - the mod that dropped them is not changed."/>

                    <TextBlock Text="{Binding LostSelectionSummary}"
                               Foreground="{DynamicResource ColorTextTertiary}"
                               FontSize="11" VerticalAlignment="Center"
                               TextWrapping="Wrap" Margin="0,0,8,0"/>
                </DockPanel>
            </StackPanel>
        </Expander>

        <DockPanel Grid.Row="6" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Width="90" IsCancel="True"
                    Style="{StaticResource StandardButtonStyle}"/>
            <TextBlock Text="Double-click a nested list to open it."
                       Foreground="{DynamicResource ColorTextTertiary}"
                       FontSize="11" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
