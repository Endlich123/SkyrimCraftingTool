{
  // Guided tour of the Settings tab. Targets: views:Tutorial.Id in View/SettingsView.xaml.
  "id": "settings",
  "title": "Settings tab",
  "steps": [
    {
      "title": "Settings",
      "text": "Here you find the Options for the whole tool: \n    -where the patch goes\n    -how it is split\n    -which tabs you see\n    -and the colour theme.\n\nThe game and mod folders are not set here - they are chosen in the window that opens at every start of the tool."
    },
    {
      "target": "settings.output",
      "title": "Patch output",
      "text": "Set a path for your patch output. Empty means the Output folder lies next to the tool.\n\nThe easiest setup: point it straight at an (empty) mod folder of your mod manager and enable that mod. Every Generate Patch then updates the mod in place.",
      "more": "Mod Organizer 2: if the tool runs from your MO2 mods folder and writes into its own folder, MO2 redirects the files into Overwrite. \n\nThe line under the box shows the folder that is actually used."
    },
    {
      "target": "settings.layout",
      "title": "One ESP per plugin",
      "text": "Off: all generated recipes go into one SkyrimCraftingTool.esp. On: one ESP per source mod, so your changes to a single mod can be switched off or shared on their own.",
      "more": "Every extra ESP is one more plugin in your load order. With many patched mods, one ESP is the simpler choice."
    },
    {
      "target": "settings.lists",
      "title": "Leveled lists that lost entries",
      "text": "When two mods change the same leveled list, the one loaded later wins and can silently drop what the other one added. This counts such lists in your load order; the button lists them, worst first.",
      "more": "To bring lost entries back, open the list in the Container/LeveledList tab and use 'Put back selected' on the rows in its lower section."
    },
    {
      "target": "settings.exportall",
      "title": "Export / import all edits",
      "text": "Presses Export or Import on every tab at once - for example after a fresh database or on another PC. The files are the same ones the tab buttons write. The import shows conflicts before it writes anything.",
      "more": "Only your edits are exported, not the scanned data, so the import always checks them against your current load order. Import all reads every tab in one pass, so an item that uses one of your own enchantments finds it even if that enchantment got a new FormID. Presets are not included - they are files already."
    },
    {
      "target": "settings.tabs",
      "title": "Main tabs",
      "text": "Hide the tabs you never use, so the row at the top stays on one line. Hiding only removes the button - nothing is deleted and everything is still patched."
    },
    {
      "target": "settings.theme",
      "title": "Appearance",
      "text": "Dark or light theme. Applies at once and is remembered."
    },
    {
      "title": "That's it",
      "text": "Every tab has its own tour - press Tutorial in any of them. Esc ends a tour at any time."
    }
  ]
}
