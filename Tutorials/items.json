{
  // Guided tour of the Items tab. Targets are views:Tutorial.Id values in View/MainContentView.xaml
  // (and shell.* in View/MainWindow.xaml). Texts are English, like the rest of the UI.
  "id": "items",
  "title": "Items tab",
  "steps": [
    {
      "title": "The Items tab",
      "text": "This is where armor and weapons are edited:\n    -their stats\n    -keywords\n    -recipes and where they can be found."
    },
    {
      "target": "items.toolbar",
      "title": "Scan, Export, Import",
      "text": "Scan/Rescan reads your load order into the tool. Run it once at the first start, and again whenever you install, remove or reorder mods.\n\nExport writes every edited item and recipe to Output/Exports/Items (one file per item) and Import reads them back - for a backup, for another profile, or to share a setup.\n\nPreset dry run applies the Presets tab's building blocks to many items at once (see the Presets tour) - armor or weapons, switched at the top of its window. Reset all items reverts every edited item the tree shows.",
      "more": "A rescan keeps your edits. If an edited item's plugin has left the load order, the edit is kept anyway and an 'Orphaned edits' button appears here, so you can review and delete it.\n\nReset all items asks first and cannot be undone. With a search or 'Only edited' active it resets only what the tree shows - clear the search to reset everything.\n\nNothing you do in this tool changes your plugins. The game only sees your edits once Generate Patch has written the patch."
    },
    {
      "target": "items.tree",
      "title": "The tree",
      "text": "Every plugin with armor or weapons will be listed here. It is split into categories, with the items below them.\n\nA dot marks something you edited - on the item itself, and on its category and plugin, so a collapsed branch still shows it.",
      "more": "•  Click an item to open it on the right.\n•  Ctrl+click adds items to a selection, Shift+click selects a range. With two or more items selected, the right side becomes a bulk editor that changes all of them at once.\n•  Click a plugin name to act on the whole plugin: apply a preset to all its items, export or import just that plugin, or reset every edit in it."
    },
    {
      "target": "items.search",
      "title": "Search",
      "text": "Filters the tree by plugin, name or item EditorID as you type."
    },
    {
      "target": "items.filters",
      "title": "Only edited",
      "text": "Shows only the items you changed - the quickest way to review your work before generating the patch. The numbers beside it count the edited items and the plugins in view."
    },
    {
      "target": "items.presetRow",
      "prepare": "items.selectExample",
      "prepareFailedText": "The rest of this tour walks through an item, and there are no armors in the tree yet. Run Scan/Rescan (or clear the search box), then start the tour again.",
      "title": "One item, opened",
      "text": "The tour has opened an armor so there is something to show. Everything below belongs to this one item.\n\nThis row: Preview its 3D model, or Export / Import just this item."
    },
    {
      "target": "items.build",
      "title": "Build",
      "text": "Puts the building blocks from the Presets tab together for this item: type, material, slot definitions, addons and extras. It starts with what the tool detects on the item; the grey line shows what Apply would change.",
      "more": "•  Select several items, or click a plugin name, and the same box applies to all of them. Slots then always stay each item's own, and type and material can stay on '(detected)'.\n•  '+ Addon' and '+ Extra' add as many as you like.\n•  Apply is an ordinary edit - Reset ALL takes it back."
    },
    {
      "target": "items.details",
      "title": "Item Details",
      "text": "The basics: name, value (Cost) and weight. EditorID and Key identify the record and cannot be changed.\n\nA field you change gets a coloured border, so you can always see what differs from the scanned state. Edits are saved automatically.",
      "more": "•  Reset Changes reverts the fields of this item.\n•  Reset ALL also reverts its crafting and temper recipe, back to how the scan found them.\n•  The ? buttons next to each field explain it in a sentence.\n\nA weapon has its own block instead of armor rating and body slots: Damage, Critical damage, Crit chance mult, Speed, Reach and Stagger.\n•  Critical damage is added on a critical hit. Vanilla uses about half the base damage (Iron Sword 7 / 3) - it does not follow Damage on its own, so change both together.\n•  Crit chance mult multiplies the chance of a critical hit: 1 is normal, 0 means the weapon never lands one outside perk effects.\n•  The WeapType keyword of a weapon cannot be changed here: it follows the weapon's animation."
    },
    {
      "target": "items.enchantment",
      "title": "Enchantment",
      "text": "Which enchantment the item carries. Type to search, or choose (no enchantment) to take it off. Jump to enchantment opens it in the Enchantments tab, where its effects are edited.",
      "more": "•  This assigns an existing enchantment; it does not change the enchantment itself.\n•  Charge, the field below, is how much enchantment charge the item holds. A weapon with an enchantment but no charge cannot be recharged.\n•  Whether the player can LEARN an enchantment by disenchanting is decided in the Enchantments tab (worn restrictions)."
    },
    {
      "target": "items.armorType",
      "expand": [ "items.expander.specific" ],
      "skipIfMissing": true,
      "title": "Armor Type",
      "text": "Light armor, heavy armor or clothing. This decides the inventory category, whether an armor rating is shown, which skill levels up, and whether the item can be tempered.",
      "more": "Armor Type is NOT the same as the ArmorLight / ArmorHeavy / ArmorClothing keyword:\n\n•  The field decides how the game treats the item (category, armor rating, skill).\n•  The keyword is what perks, materials and vendors look at.\n\nPicking an armor-class keyword moves this field along automatically, as a normal edit you can reset. Setting the field alone leaves the keywords as they are - useful for jewelry, see the Keywords step."
    },
    {
      "target": "items.bodySlots",
      "expand": [ "items.expander.specific" ],
      "skipIfMissing": true,
      "title": "Body Slots",
      "text": "Where the item is worn. Click a slot to toggle it. Two items that share a slot cannot be worn together.",
      "more": "The vanilla slots: 30 head, 31 hair, 32 body, 33 hands, 34 forearms, 35 amulet, 36 ring, 37 feet, 38 calves, 39 shield, 42 circlet. The rest are free for mods to use.\n\nA helmet that covers the hair uses 30 and 31; a hood often only 31, so a circlet (42) still fits under it. Changing slots does not change the mesh - a body armor moved to slot 52 still looks like body armor."
    },
    {
      "target": "items.keywords.selected",
      "expand": [ "items.expander.keywords" ],
      "title": "Keywords on the item",
      "text": "The keywords the item carries right now. Click one to take it off. Below are the keywords you can add.\n\nKeywords are how the game and other mods recognise an item: perks, smithing, vendors, Survival Mode and many mods all read them.",
      "more": "The tool enforces these rules while you click:\n\n•  Only one of ArmorLight, ArmorHeavy, ArmorClothing.\n•  ArmorLight or ArmorHeavy blocks all Clothing* keywords; ArmorClothing blocks the five armor-piece keywords (ArmorCuirass, ArmorHelmet, ArmorGauntlets, ArmorBoots, ArmorShield). ArmorJewelry and materials stay allowed.\n•  Only one WeapMaterial* at a time - picking a second replaces the first. Armor may carry two materials: vanilla does it on purpose (Iron + Banded Iron).\n•  WeapType* keywords cannot be changed: the game ties them to the weapon's animation type.\n\nWhy it matters for perks (vanilla):\n•  Custom Fit / Well Fitted check the WHOLE outfit for ArmorHeavy / ArmorLight. A ring with ArmorLight breaks Well Fitted for a heavy build.\n•  Matching Set needs exactly four pieces of one material. A fifth item with the same material keyword (a ring, say) makes it five and the bonus is gone.\n•  So: leave class and material keywords off jewelry. To make jewelry count as armor, set its Armor Type instead - no vanilla perk reads that field."
    },
    {
      "target": "items.keywords.expert",
      "expand": [ "items.expander.keywords" ],
      "title": "All Keywords (Expert)",
      "text": "The standard list shows the keywords commonly used on armor and weapons. Tick this to load every keyword from your whole mod list - including the ones other mods react to.",
      "more": "This is where the interesting tricks live. Examples:\n\n•  Survival Mode warmth: Survival Mode reads keywords, not slots. A piece gets its warmth from its body-part keyword (ArmorCuirass / ClothingBody, ArmorHelmet / ClothingHead, ArmorGauntlets / ClothingHands, ArmorBoots / ClothingFeet), and Survival_ArmorWarm or Survival_ArmorCold raises or lowers it. A piece without a body-part keyword adds no warmth, whatever slot it uses.\n•  Vendors: merchants buy only items with the keywords on their list (e.g. VendorItemJewelry, VendorItemClothing). An item nobody will buy is usually missing its vendor keyword.\n•  Mods: many mods add their own keywords to decide what they affect. Their mod page usually says which.\n\nOnly add keywords you know the purpose of: a wrong keyword is silent - nothing warns, things just behave oddly in game."
    },
    {
      "target": "items.crafting.workbench",
      "expand": [ "items.expander.crafting" ],
      "title": "Crafting Recipe",
      "text": "How the item is made: at which workbench, from what, and under which conditions. Pick a workbench or press a green + to create a recipe for an item that has none.",
      "more": "•  Workbench: where the recipe shows up. SkyrimSmithingForge is the normal forge.\n•  Ingredients: the materials and how many of each. A recipe without ingredients is free.\n•  A recipe without a workbench never shows up anywhere - the section warns about both.\n•  'other recipes' in the section header appears when an item has more than one crafting recipe; there you choose which one this editor shows."
    },
    {
      "target": "items.crafting.addCondition",
      "expand": [ "items.expander.crafting" ],
      "title": "Conditions",
      "text": "Conditions decide WHO may use the recipe - for example only with the Steel Smithing perk, or only from a certain level.",
      "more": "Typical conditions:\n•  Perk: the player needs a smithing perk (how vanilla gates materials).\n•  Level: the player needs a minimum level.\n•  Quest stage: unlocked by progress in a quest.\n\nEach row reads: Type, Target, Operator, Value, Run On.\n•  Operator: how the value is compared - GetLevel >= 20 is 'level 20 or higher', GetLevel < 20 'below 20'. A new condition shows the usual operator for its type.\n•  OR: this condition OR the next one must be true. Unticked, all conditions must be true. Two perk conditions joined with OR mean 'either perk'; without it the player needs both.\n•  Run On: Subject is the player. Some mods use other targets (Reference, ...); the tool keeps them as they are.\n\nConditions the tool cannot edit are kept as they are and shown read-only, so a recipe from another mod never loses them."
    },
    {
      "target": "items.expander.temper",
      "title": "Temper Recipe",
      "text": "What improving the item at the armor workbench or grindstone costs. Same idea as the crafting recipe: ingredients and conditions. The workbench is set automatically.",
      "more": "Vanilla usually ties tempering to the matching smithing perk through a condition. Remove that condition and anyone can improve the item; add one to make it harder to improve."
    },
    {
      "target": "items.expander.breakdown",
      "title": "Breakdown",
      "text": "Recipes that USE UP this item instead of making it - melting it down at the smelter or cutting it up at the tanning rack. Vanilla has none for armor and weapons; mods like CCOR add them. The + creates one."
    },
    {
      "target": "items.container",
      "expand": [ "items.expander.container" ],
      "title": "Where it can be found",
      "text": "Adds the item to merchants, containers and their leveled lists, so it shows up in the world. Click to select, click again to unselect; the level slider sets from which player level it appears.",
      "more": "•  The patch only ADDS the item to these lists - it never takes anything out. Removing items is the Container/LeveledList tab.\n•  Most merchants and chests do not hold items directly but draw them from leveled lists, which is why the lists are offered here as well.\n•  Standard view shows merchants; the expert view shows every container in your load order."
    },
    {
      "target": "shell.generate",
      "title": "Generate Patch",
      "text": "Nothing above reaches the game until this button writes the patch: SkyPatcher INI files for your item edits, plus SkyrimCraftingTool.esp for recipes. Enable the output in your mod manager like any other mod.\n\nPreview Patch, next to it, shows what would be written without writing anything.",
      "more": "Generate again after every round of edits, so the patch matches what you see here. Your edits themselves are saved in the tool's database and survive a restart."
    }
  ]
}
