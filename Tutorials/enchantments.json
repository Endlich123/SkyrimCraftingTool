{
  // Guided tour of the Enchantments tab. Targets: views:Tutorial.Id in View/EnchantmentMenuView.xaml.
  "id": "enchantments",
  "title": "Enchantments tab",
  "steps": [
    {
      "title": "The Enchantments tab",
      "text": "Here the enchantments themselves are edited: their effects, cost and which items they may go on. Which enchantment an ITEM carries is chosen in the Items tab - this tab changes what the enchantment does.\n\nAn edit here reaches every item that carries the enchantment."
    },
    {
      "target": "ench.toolbar",
      "title": "New, Export, Import",
      "text": "New enchantment creates an empty enchantment of your own. It appears under SkyrimCraftingTool.esp in the tree; give it at least one effect, then assign it to an item in the Items tab.\n\nExport and Import work like in the Items tab: one file per edited enchantment under Output/Exports."
    },
    {
      "target": "ench.tree",
      "title": "The tree",
      "text": "Plugins, split into weapon, armor and other enchantments. A dot marks what you edited.\n\nAn arrow (↳) marks a derived enchantment: a stronger or weaker tier that inherits from a base enchantment.",
      "more": "Vanilla builds enchantments in families: one base record (e.g. Fortify Health) and many tiers that point at it (the 01, 02, 03 ... variants found on loot). The tiers carry the actual numbers; the base is what the player learns and puts on items at the enchanting table.\n\nClick a plugin name for plugin-wide actions: export, import, reset every edit in it."
    },
    {
      "target": "ench.filters",
      "title": "Filters",
      "text": "Only edited shows what you changed. Only base hides the derived tiers, which makes the tree far shorter - usually the base is the one you are looking for."
    },
    {
      "target": "ench.basic",
      "prepare": "enchantments.selectExample",
      "prepareFailedText": "The rest of this tour walks through an enchantment, and none with a worn-restriction list was found. Run Scan/Rescan in the Items tab, then start the tour again.",
      "title": "One enchantment, opened",
      "text": "The tour has opened an armor enchantment as an example.\n\nName is what the game shows (it becomes part of the item's title, '... of Frost'). Cost is the charge one use costs. EditorID and the cast/target types can only be changed on enchantments you created yourself.",
      "more": "•  Cast Type decides whether this is an armor enchantment (ConstantEffect, always on) or a weapon one (FireAndForget, on hit).\n•  Charge Time only matters for staff enchantments.\n•  Changed fields get a coloured border; Reset Changes reverts them."
    },
    {
      "target": "ench.flags",
      "title": "No auto-calc",
      "text": "Without this flag the game calculates the cost itself from the effects and ignores the number you typed. Tick it whenever you set Cost or Amount by hand.",
      "more": "The other side of it: with the flag set, the cost no longer follows the effects. Make the effects stronger later and the cost stays where you left it."
    },
    {
      "target": "ench.lineage",
      "skipIfMissing": true,
      "title": "Base and tiers",
      "text": "Where this enchantment sits in its family. On a tier, Open base jumps to the base record. On a base, the button lists the tiers that point at it."
    },
    {
      "target": "ench.effects",
      "title": "Effects",
      "text": "The magic effects this enchantment applies, each with magnitude, duration and area. Change the numbers per row, remove an effect, or add a new one above the list.",
      "more": "•  An effect can appear only once per enchantment.\n•  Fields an effect does not use (e.g. duration on a constant armor effect) are greyed out.\n•  A new effect starts at 0 - set its magnitude, or it does nothing."
    },
    {
      "target": "ench.applyFamily",
      "skipIfMissing": true,
      "title": "Apply to the whole family",
      "text": "Carries this effect list over to all tiers that point at this enchantment - added effects scaled to each tier's strength, removed ones removed. Shows every change before writing anything.",
      "more": "Useful after adding an effect to a base: without it, the loot versions of the enchantment would still have the old effect list."
    },
    {
      "target": "ench.expander.worn",
      "expand": [ "ench.expander.worn" ],
      "title": "Worn Restrictions",
      "text": "A list of keywords that decides which items this enchantment can be put on at the enchanting table. An item needs at least one keyword from the list.",
      "more": "How an enchantment becomes usable for the player:\n\n1. LEARN it: disenchant an item that carries it (or one of its tiers). The player learns the base enchantment. Items with the keyword MagicDisallowEnchanting cannot be disenchanted.\n2. APPLY it: at the enchanting table only items that carry a keyword from this list are offered for it.\n\nSo when a modded piece of armor does not show up for an enchantment you know, compare its keywords (Items tab) with this list. Two ways out:\n•  give the item a keyword the list already has (e.g. ClothingNecklace for an amulet), or\n•  add the item's keyword to the list here.\n\nThe first changes one item; the second changes every enchantment that uses the list."
    },
    {
      "target": "ench.worn.list",
      "expand": [ "ench.expander.worn" ],
      "title": "Which list",
      "text": "The keyword list this enchantment points at. Pick another existing list to change what it may go on, or (none) to lift the restriction. The line above says how many enchantments share the list.",
      "more": "Lists are shared: vanilla points many enchantments at the same few lists. Re-pointing THIS enchantment at another list affects only this one; editing a list's keywords (next step) affects all of them.\n\nThe tool offers only lists that already exist in your load order; it does not create new ones."
    },
    {
      "target": "ench.worn.selected",
      "expand": [ "ench.expander.worn" ],
      "skipIfMissing": true,
      "title": "Keywords in the list",
      "text": "The keywords the list contains. Click one to remove it; add more from the list below (tick All Keywords (Expert) for every keyword in your load order). Reset list puts the list back as it was scanned.",
      "more": "Remember: this list belongs to every enchantment that uses it. Adding ClothingRing here makes ALL of them available for rings."
    },
    {
      "title": "Generate Patch",
      "text": "As everywhere, nothing here reaches the game until Generate Patch writes the patch. Most enchantment edits go into SkyPatcher INI files; a re-pointed worn-restriction list goes into SkyrimCraftingTool.esp."
    }
  ]
}
