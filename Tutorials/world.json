{
  // Guided tour of the Container/LeveledList tab. Targets: views:Tutorial.Id in
  // View/WorldContentView.xaml and View/PlacementListView.xaml. "world.tab:N" switches sub-tabs
  // (0 Containers, 1 Leveled lists, 2 Armor, 3 Weapons, 4 Books, ...).
  "id": "world",
  "title": "Container/LeveledList tab",
  "steps": [
    {
      "title": "Containers and leveled lists",
      "text": "This tab is about WHERE things can be found in the game: in chests, on merchants, in the leveled lists that fill them.\n\nThe sub-tabs work in two directions:\n•  Containers and Leveled lists: look inside, take things OUT, or put back what was taken out.\n•  All the others (Armor, Weapons, Books, ...): put things IN."
    },
    {
      "target": "world.tabs",
      "title": "The sub-tabs",
      "text": "The first two show what is inside a container or a list. The rest list the objects you can place - one tab per kind - and are the way to add them.",
      "more": "Why most things go through leveled lists: very few chests and merchants hold their items directly. They hold leveled lists, and a list picks what appears depending on the player's level. Adding an item to the right list is how it shows up 'naturally' - at the right merchants, at the right level, without filling a chest by hand."
    },
    {
      "target": "world.owner.tree",
      "prepare": "world.tab:0",
      "title": "Containers: pick one",
      "text": "Every container in your load order, grouped by the plugin that defines it. Pick one to see what is in it; Ctrl or Shift picks several at once.",
      "more": "Picking several shows what they have in common - useful to take one object out of a whole family of chests in one go."
    },
    {
      "target": "world.owner.search",
      "prepare": "world.tab:0",
      "title": "Search",
      "text": "Filters by name or FormID."
    },
    {
      "target": "world.owner.rows",
      "prepare": "world.tab:0",
      "title": "What is in it",
      "text": "The upper section is what the container holds now. The lower section, 'Not in it any more', is what is missing: things you took out, and things a mod dropped from the lists inside it.",
      "more": "•  'removed by you' and a line through the name: your patch takes this out.\n•  The lower section also shows entries other mods LOST to an override - when two mods edit the same list, the later one wins and can silently drop what the first one added. The note under the list says which plugin did it.\n•  For a container this history comes from the leveled lists hanging in it; a container itself keeps none."
    },
    {
      "target": "world.owner.buttons",
      "prepare": "world.tab:0",
      "title": "Remove and put back",
      "text": "Tick rows, then Remove selected moves them to the lower section; Put back selected moves them up again.",
      "more": "Removing is the one thing in this whole tool that takes something away that another mod put there - everything else only adds. A yellow box above the list reminds you once there are removals.\n\nPut back does two things, and they look the same from the list's side:\n•  it undoes your own removal, or\n•  it adds back an entry an override dropped, at the level and amount it last had."
    },
    {
      "target": "world.owner.tree",
      "prepare": "world.tab:1",
      "title": "Leveled lists",
      "text": "The same view for leveled lists: pick a list, see what it hands out, take entries out or put lost ones back. Each row says from which player level an entry is used.",
      "more": "Mods often add their items to a vanilla list, and a later mod that edits the same list without merging drops them. Those entries show up in the lower section here - Put back restores them."
    },
    {
      "target": "world.owner.newList",
      "prepare": "world.tab:1",
      "title": "Your own leveled list",
      "text": "Creates an empty leveled list of your own. Hang it into a container or another list, then fill it from an item's Container section - the list appears there under the container it hangs in.",
      "more": "Why your own list: it bundles your additions. A merchant then hands out 'one of your items' instead of each one being added separately, and the chance settings of the list decide how often."
    },
    {
      "target": "world.owner.odds",
      "prepare": "world.tab:1",
      "skipIfMissing": true,
      "title": "This list and its odds",
      "text": "How the list picks: the chance that it gives nothing at all, whether it uses all levels up to the player's, and what the odds come to for one entry. Only shown once a list is picked."
    },
    {
      "target": "world.place.tree",
      "prepare": "world.tab:2",
      "title": "Putting things in",
      "text": "From here on each sub-tab is a kind of object. Pick one on the left (Ctrl/Shift for several) and place it on the right - in merchants, containers and their leveled lists, from a player level you choose.",
      "more": "Armor and Weapons here are the same items as in the Items tab; placing them here or in their Container section is the same thing. The other kinds - books, scrolls, misc items, soul gems, ammo, food, ingredients, keys - can only be placed here."
    },
    {
      "target": "world.place.panel",
      "prepare": "world.tab:2",
      "title": "Placing",
      "text": "With one record picked this is its placement panel. With several picked it becomes a template: set the containers once and Apply to picked adds them to all of them.",
      "more": "Placing is always additive: the patch adds your item to the lists and never takes anything out of them. Containers already named for a record keep their entries; only their levels are replaced by what you set here."
    },
    {
      "title": "Generate Patch",
      "text": "Placements and removals are written by Generate Patch, like every other edit. Removals become rules that take the object out for EVERY mod that feeds the list - check the yellow reminder before you generate."
    }
  ]
}
