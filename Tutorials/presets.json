{
  // Guided tour of the Presets tab. Targets: views:Tutorial.Id in View/PresetsConfigView.xaml.
  "id": "presets",
  "title": "Presets tab",
  "steps": [
    {
      "title": "Presets",
      "text": "A preset is a reusable set of values - armor rating, weight, price, keywords, recipes, where the item can be found - stored per body slot and per weapon type.\n\nApplied to an item in the Items tab, it fills in everything at once. Applied to a whole plugin, it brings a complete armor mod in line with your balance in one click."
    },
    {
      "target": "presets.new",
      "title": "New preset",
      "text": "Creates an empty preset. Click its name in the tree to rename or delete it. Presets are saved automatically as files in Output/Presets."
    },
    {
      "target": "presets.tree",
      "title": "Preset, then slot",
      "text": "Each preset has an Armor branch with one entry per body slot, and a Weapons branch with one entry per weapon type. You fill in only the slots you need.",
      "more": "•  Ctrl+click or Shift+click selects several slots - the right side then edits all of them at once.\n•  Slots you leave empty do nothing: an item in that slot keeps its own values."
    },
    {
      "target": "presets.values",
      "prepare": "presets.selectExample",
      "prepareFailedText": "There is no preset yet to walk through. Press '+ New Preset', then start the tour again.",
      "title": "Values - and the tick boxes",
      "text": "The tour has opened the body slot of a preset. Every field has a tick box: only ticked fields are applied. An unticked field leaves the item's own value alone.",
      "more": "How a preset meets an item: it looks at the item's body slots and uses every slot entry that matches.\n\n•  An item in several slots (e.g. body + forearms) gets the numbers of all its matching slots ADDED together.\n•  Keywords from all matching slots together become the item's complete keyword list.\n\nThat is why a good preset spreads the total over the slots - e.g. body 40 %, head, hands and feet 14 % each - rather than giving every slot the full value."
    },
    {
      "target": "presets.keywords",
      "expand": [ "presets.keywords" ],
      "title": "Keywords",
      "text": "Tick 'Include Keywords' and pick the keywords this slot should give. The same rules as on an item apply (one armor class, one material, ...).",
      "more": "Careful: applied keywords REPLACE the item's keyword list - keywords the preset does not list are taken off. Include everything the item needs: class (ArmorLight / ArmorHeavy), slot (ArmorCuirass ...), material, and VendorItemArmor so merchants buy it."
    },
    {
      "target": "presets.crafting",
      "title": "Recipes",
      "text": "Crafting, temper and breakdown recipes work like on an item: workbench, ingredients, conditions. An item without a recipe gets one created when the preset is applied.",
      "more": "•  Ingredients from the preset become the item's complete ingredient list.\n•  Conditions replace the item's conditions of the same type (a preset's perk condition replaces the item's perk condition, its level condition stays).\n•  Leave the temper workbench alone - the tool picks the right one (armor workbench or grindstone) by itself."
    },
    {
      "target": "presets.container",
      "title": "Container",
      "text": "Where items with this preset can be found - merchants, containers and their leveled lists, from a player level. 'Include Container' must be ticked for it to be applied."
    },
    {
      "target": "presets.enchantment",
      "title": "Enchantment",
      "text": "An enchantment and charge to give every matching item. Pick '(no enchantment)' with the box ticked to strip enchantments instead."
    },
    {
      "title": "Applying a preset",
      "text": "Presets are applied from the Items tab: pick the preset in the row above an item's details and press Apply - or click a plugin name in the tree and Apply there for every item of that plugin.\n\nApplying is an ordinary edit: it shows up as edited, and Reset ALL takes it back."
    }
  ]
}
