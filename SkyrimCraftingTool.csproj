<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- Bump this per release. It is what the bug report shows under "Tool version", and a report
         without a version costs a round trip on every single bug. -->
    <!-- Version must stay numeric (Major.Minor.Build[.Revision]); the release label lives in
         InformationalVersion, which is what the bug report prints as "Tool version" (see
         DiagnosticsReport). Kept spelled exactly like the uploaded file name so a report and a
         download name can be compared without translating between them. -->
    <Version>0.9.2</Version>
    <InformationalVersion>0.9.2_beta</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Behaviors\**" />
    <EmbeddedResource Remove="Behaviors\**" />
    <None Remove="Behaviors\**" />
    <Page Remove="Behaviors\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.5" />
    <PackageReference Include="Mutagen.Bethesda.Skyrim" Version="0.52.0" />
  </ItemGroup>

  <ItemGroup>
    <Page Remove="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SkyrimCraftingTool.Tests" />
  </ItemGroup>

</Project>
