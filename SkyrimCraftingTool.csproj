<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- Bump this per release. It is what the bug report shows under "Tool version", and a report
         without a version costs a round trip on every single bug. -->
    <!-- Version must stay numeric (Major.Minor.Build[.Revision]); the release label lives in
         InformationalVersion, which is what the bug report prints as "Tool version" (see
         DiagnosticsReport). Kept spelled exactly like the uploaded file name so a report and a
         download name can be compared without translating between them. -->
    <Version>0.9.8</Version>
    <InformationalVersion>0.9.8</InformationalVersion>

    <!-- Ship only English resources. The 13 satellite folders are localized error strings from .NET
         and third-party libraries; the tool's own UI is English either way. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Symbols INSIDE the assembly instead of a loose .pdb next to the exe. "none" was the first
         idea and would have been a mistake: it also strips file and line numbers from exception
         stack traces, and those traces are the most useful thing in the bug reports this tool goes
         out of its way to collect (see Services/DiagnosticsReport.cs). Embedded keeps the folder
         clean AND keeps the line numbers. -->
    <DebugType>embedded</DebugType>

    <!-- Server GC, with DATAS (docs/Performance-Plan.md, Messung 9). The scan reads 1.800 plugins on
         20 threads at once; with the default workstation GC every one of ~320 small collections
         stopped all of them, 2-3.5 s of pure pause. Server GC gives each core its own heap and
         collects far less often: reading the plugins went 4.6 s -> 2.6 s, the tree rebuild
         3.2 s -> 2.1 s.
         Server GC alone would size itself by the core count and hold on to more memory on every
         many-core machine, wanted or not. GarbageCollectionAdaptationMode=1 (DATAS, .NET 8) starts
         it with few heaps and adds more only under load, so the pauses get short without the memory
         growing with the core count. Concurrent (background) GC stays on, as by default.
         perf.log names the GC mode actually in effect in each session header, so a measurement can
         always be told apart by it. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <GarbageCollectionAdaptationMode>1</GarbageCollectionAdaptationMode>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Behaviors\**" />
    <EmbeddedResource Remove="Behaviors\**" />
    <None Remove="Behaviors\**" />
    <Page Remove="Behaviors\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.5" />
    <PackageReference Include="Mutagen.Bethesda.Skyrim" Version="0.52.0" />
  </ItemGroup>

  <ItemGroup>
    <Page Remove="App.xaml" />
  </ItemGroup>

  <!-- Guided tours (Services/TutorialService.cs). Embedded, not copied next to the exe: a loose file
       is one more thing the release ZIP can be missing. -->
  <ItemGroup>
    <EmbeddedResource Include="Tutorials\*.json" LogicalName="SkyrimCraftingTool.Tutorials.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SkyrimCraftingTool.Tests" />
  </ItemGroup>

</Project>
