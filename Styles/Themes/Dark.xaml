<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark palette. One brush per token, and the whole file is what a theme switch replaces:
         ThemeService swaps this dictionary inside Application.Resources.MergedDictionaries, and the
         ~330 {DynamicResource ColorX} references across the UI re-resolve against the new one.

         Why a swap and not "write Color into the existing brushes": WPF freezes Freezables in any
         ResourceDictionary that gets an owner, and Application.Resources is one. Brushes here are
         frozen, and that is fine - nothing writes to them, they get replaced wholesale. It is also
         why the references must be DynamicResource: StaticResource is resolved once at load time
         and would keep pointing at the old, discarded brush.

         Every palette must define every key, or the switch leaves the previous theme's color
         standing for the ones it misses. ThemePaletteCompletenessTests checks that. -->

    <SolidColorBrush x:Key="ColorBackgroundBase" Color="#333333"/>
    <SolidColorBrush x:Key="ColorBackgroundPanel" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="ColorBackgroundControl" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="ColorBackgroundHighlight" Color="#444444"/>
    <SolidColorBrush x:Key="ColorTextPrimary" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="ColorTextSecondary" Color="#C0C0C0"/>
    <SolidColorBrush x:Key="ColorTextTertiary" Color="#777777"/>
    <SolidColorBrush x:Key="ColorTextMuted" Color="#999999"/>
    <SolidColorBrush x:Key="ColorTextOnAccent" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="ColorTreeRoot" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ColorTreeBranch" Color="#B0C4DE"/>
    <SolidColorBrush x:Key="ColorTreeLeaf" Color="#D3D3D3"/>
    <SolidColorBrush x:Key="ColorHeadingAccent" Color="#FFD700"/>
    <SolidColorBrush x:Key="ColorAccent" Color="#0F4C86"/>
    <SolidColorBrush x:Key="ColorAccentLight" Color="#2A63A8"/>
    <SolidColorBrush x:Key="ColorAccentSoft" Color="#0A2A4A"/>
    <SolidColorBrush x:Key="ColorAccentWarm" Color="#8A5D12"/>
    <SolidColorBrush x:Key="ColorAccentWarmLight" Color="#B3791A"/>
    <SolidColorBrush x:Key="ColorAccentWarmSoft" Color="#5C3D0C"/>
    <SolidColorBrush x:Key="ColorAccentGreen" Color="#2E8B57"/>
    <SolidColorBrush x:Key="ColorAccentGreenLight" Color="#3CAF6E"/>
    <SolidColorBrush x:Key="ColorAccentGreenSoft" Color="#1F5E3B"/>
    <SolidColorBrush x:Key="ColorDanger" Color="#C04040"/>
    <SolidColorBrush x:Key="ColorSuccess" Color="#4CAF50"/>
    <SolidColorBrush x:Key="ColorWarning" Color="#D9A300"/>
    <SolidColorBrush x:Key="ColorBorder" Color="#555555"/>
    <SolidColorBrush x:Key="ColorBorderLight" Color="#666666"/>
    <SolidColorBrush x:Key="ColorDivider" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="ColorScrollbarTrack" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="ColorScrollbarThumb" Color="#46464A"/>
    <SolidColorBrush x:Key="ColorScrollbarThumbHover" Color="#5F5F63"/>
    <SolidColorBrush x:Key="ColorScrollbarArrow" Color="#999999"/>
    <SolidColorBrush x:Key="ColorChipBackground" Color="#333333"/>
    <SolidColorBrush x:Key="ColorChipText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ColorSurfaceInfo" Color="#003C78"/>
    <SolidColorBrush x:Key="ColorSurfaceWarn" Color="#5C3D0C"/>
    <SolidColorBrush x:Key="ColorSurfaceOk" Color="#2E8B57"/>
    <SolidColorBrush x:Key="ColorSurfaceDanger" Color="#8B0000"/>

    <!-- WPF's own selection keys. Defined here so selection looks the same everywhere: before this,
         three views overrode them in their own Style.Resources (in two different spellings) and two
         did not override them at all, which is why the item and preset lists did not quite match. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#444444"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#555555"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E8E8E8"/>

</ResourceDictionary>
