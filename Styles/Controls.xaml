<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== -->
    <!--      COLOR PALETTE    -->
    <!-- ===================== -->
    <!-- Background Layers -->
    <SolidColorBrush x:Key="ColorBackgroundBase" Color="#333"/>
    <SolidColorBrush x:Key="ColorBackgroundPanel" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="ColorBackgroundControl" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="ColorBackgroundHighlight" Color="#444444"/>

    <!-- Text Colors -->
    <SolidColorBrush x:Key="ColorTextPrimary" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="ColorTextSecondary" Color="#C0C0C0"/>
    <SolidColorBrush x:Key="ColorTextTertiary" Color="#777777"/>
    <SolidColorBrush x:Key="ColorTextMuted" Color="#999999"/>

    <!-- Accent Colors -->
    <!-- Blue = read/export actions (nothing changes locally). Slightly brighter than the original
         #003C78 — that read as too close to the panel backgrounds to register as "clickable". -->
    <SolidColorBrush x:Key="ColorAccent" Color="#0F4C86"/>
    <SolidColorBrush x:Key="ColorAccentLight" Color="#2A63A8"/>
    <SolidColorBrush x:Key="ColorAccentSoft" Color="#0A2A4A"/>

    <!-- Amber = write/import actions (overwrites local edits) — same family as ColorWarning, so the
         "this changes your data" signal reads instantly next to the neutral blue Export buttons. -->
    <SolidColorBrush x:Key="ColorAccentWarm" Color="#8A5D12"/>
    <SolidColorBrush x:Key="ColorAccentWarmLight" Color="#B3791A"/>
    <SolidColorBrush x:Key="ColorAccentWarmSoft" Color="#5C3D0C"/>
    <!-- Green = scan/refresh action (reads the mod DB, no data leaves/enters the tool) — kept
         distinct from the blue Export accent so it doesn't read as another export button. -->
    <SolidColorBrush x:Key="ColorAccentGreen" Color="#2E8B57"/>
    <SolidColorBrush x:Key="ColorAccentGreenLight" Color="#3CAF6E"/>
    <SolidColorBrush x:Key="ColorAccentGreenSoft" Color="#1F5E3B"/>

    <!-- Status Colors -->
    <SolidColorBrush x:Key="ColorDanger" Color="#C04040"/>
    <SolidColorBrush x:Key="ColorSuccess" Color="#4CAF50"/>
    <SolidColorBrush x:Key="ColorWarning" Color="#D9A300"/>

    <!-- Borders & Dividers -->
    <SolidColorBrush x:Key="ColorBorder" Color="#555555"/>
    <SolidColorBrush x:Key="ColorBorderLight" Color="#666666"/>
    <SolidColorBrush x:Key="ColorDivider" Color="#3A3A3A"/>

    <!-- Scrollbars -->
    <SolidColorBrush x:Key="ColorScrollbarTrack" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="ColorScrollbarThumb" Color="#46464A"/>
    <SolidColorBrush x:Key="ColorScrollbarThumbHover" Color="#5F5F63"/>
    <SolidColorBrush x:Key="ColorScrollbarArrow" Color="#999999"/>

    <!-- Chips / Tags -->
    <SolidColorBrush x:Key="ColorChipBackground" Color="#333333"/>
    <SolidColorBrush x:Key="ColorChipSelected" Color="#003C78"/>
    <SolidColorBrush x:Key="ColorChipBorder" Color="#555555"/>

    <!-- ===================== -->
    <!--      Controls         -->
    <!-- ===================== -->

    <!-- ===================== -->
    <!--      TEXTBLOCKS       -->
    <!-- ===================== -->

    <Style x:Key="ItemLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ColorTextSecondary}"/>
        <Setter Property="Margin" Value="0,0,5,5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style x:Key="TitelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="5,0,0,0"/>
    </Style>

    <Style x:Key="ToolTipTitelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="5,0,0,0"/>
    </Style>

    <Style x:Key="ToolTipTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ColorTextSecondary}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="5,0,0,0"/>
    </Style>

    <!-- ===================== -->
    <!--      TOOLTIP          -->
    <!-- ===================== -->
    
    <Style x:Key="InfoTooltipStyle" TargetType="ToolTip">
        <Setter Property="Background" Value="#333"/>
        <Setter Property="BorderBrush" Value="#555"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10"/>
    </Style>

    <!-- ===================== -->
    <!--      TEXTBOX          -->
    <!-- ===================== -->

    <Style x:Key="ItemTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource ColorBackgroundControl}"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Margin" Value="0,0,5,5"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style x:Key="ItemTextSearchBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource ColorBackgroundControl}"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
        <Setter Property="Margin" Value="0,0,5,5"/>
        <Setter Property="FontSize" Value="11"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{StaticResource ColorBackgroundControl}"
                        BorderBrush="{StaticResource ColorBorder}"
                        BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="25"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Lupe -->
                            <Path Grid.Column="0"
                              Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 
                                    16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 
                                    3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 
                                    0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 
                                    11.99 14 9.5 14z"
                              Fill="{StaticResource ColorTextPrimary}"
                              Stretch="Uniform"
                              Width="12" Height="12"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"/>

                            <!-- Inhalt -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                      Grid.Column="1"
                                      Margin="2,4,4,4"/>
                            <!-- WICHTIG -->
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== -->
    <!--      CHECKBOX         -->
    <!-- ===================== -->

    <Style x:Key="ItemCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
        <Setter Property="Background" Value="{StaticResource ColorBackgroundControl}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>


    <!-- ===================== -->
    <!--      COMBOBOX         -->
    <!-- ===================== -->

    <Style x:Key="ItemComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource ColorBackgroundControl}"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,5,5"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="IsEditable" Value="True"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <!-- The outer border now encloses the search field together with the magnifying glass -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="25"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left area: magnifying glass + text field in one shared box -->
                        <!-- BorderBrush flows from the control so callers can highlight it
                             (edited-state amber, dead-reference red, ...). Default is ColorBorder
                             via the style Setter. -->
                        <Border Grid.Column="0"
                        Background="{StaticResource ColorBackgroundControl}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1,1,0,1">
                            <!-- Right edge left open, since that's where the button docks -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- The magnifying glass now sits cleanly within the inner border -->
                                <Path Grid.Column="0" 
                                      Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" 
                                      Fill="{StaticResource ColorTextPrimary}" 
                                      Stretch="Uniform" 
                                      Width="12" Height="12" 
                                      VerticalAlignment="Center" 
                                      HorizontalAlignment="Center"/>

                                <!-- The actual text field no longer has its own border -->
                                <TextBox x:Name="PART_EditableTextBox"
                                     Grid.Column="1"
                                     Background="Transparent"
                                     Foreground="{StaticResource ColorTextPrimary}"
                                     BorderThickness="0"
                                     Padding="2,4,4,4"
                                     FontSize="11"
                                     VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Left"
                                     Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"/>
                            </Grid>
                        </Border>

                        <!-- Right area: dropdown button -->
                        <ToggleButton x:Name="ToggleButton"
                              Content="▼"
                              Grid.Column="1"
                              Background="{StaticResource ColorBackgroundControl}"
                              Foreground="{StaticResource ColorTextPrimary}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="1"
                              Focusable="False"
                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>

                        <Popup x:Name="Popup"
                           Placement="Bottom"
                           IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                           AllowsTransparency="True">
                            <Border Background="{StaticResource ColorBackgroundControl}"
                                BorderBrush="{StaticResource ColorBorder}"
                                BorderThickness="1">
                                <ScrollViewer>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    
                    
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

    <!-- ===================== -->
    <!--      Expander         -->
    <!-- ===================== -->

    <Style x:Key="DarkExpanderStyle" TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
        <Setter Property="Background" Value="{StaticResource ColorBackgroundPanel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,5,10"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border 
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3">

                        <StackPanel>
                            <!-- HEADER -->
                            <!-- A bare ToggleButton (no OverridesDefaultStyle/Template of its own)
                                 keeps WPF's built-in chrome, which paints its own light "hot tracking"
                                 hover overlay on top of whatever Background we set — that's what was
                                 washing out the white header text on hover. Templating it fully here
                                 makes our own Background trigger below the only thing controlling how
                                 it looks. -->
                            <ToggleButton x:Name="HeaderSite"
                                      Content="{TemplateBinding Header}"
                                      FontWeight="Bold"
                                      Background="{StaticResource ColorBackgroundHighlight}"
                                      Foreground="{StaticResource ColorTextPrimary}"
                                      BorderThickness="0"
                                      Padding="8"
                                      HorizontalContentAlignment="Left"
                                      OverridesDefaultStyle="True"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- CONTENT -->
                            <ContentPresenter x:Name="ExpandSite"
                                          Visibility="Collapsed"
                                          Margin="10,8,10,10"
                                          Content="{TemplateBinding Content}"/>
                        </StackPanel>
                    </Border>

                    <!-- TRIGGERS -->
                    <ControlTemplate.Triggers>

                        <!-- Expand -->
                        <Trigger SourceName="HeaderSite" Property="IsChecked" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                        </Trigger>

                        <!-- Hover Effekt -->
                        <Trigger SourceName="HeaderSite" Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderSite" Property="Background" 
                                Value="{StaticResource ColorBackgroundControl}"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== -->
    <!--      GroupBox         -->
    <!-- ===================== -->

    <!-- WPF's default GroupBox chrome draws its header-notch border with hardcoded
         SystemColors highlight/shadow brushes (a light bevel), ignoring BorderBrush
         entirely for those bevel lines. On this dark theme that shows up as a bright
         white line across the header no matter what BorderBrush is set to - this
         fully custom template replaces that chrome so every color comes from our
         own palette. -->
    <Style x:Key="DarkGroupBoxStyle" TargetType="GroupBox">
        <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
        <Setter Property="Background" Value="{StaticResource ColorBackgroundPanel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <DockPanel>
                        <ContentPresenter DockPanel.Dock="Top"
                                          ContentSource="Header"
                                          Margin="0,0,0,6"/>
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



    <!-- ===================== -->
    <!--      BUTTONS          -->
    <!-- ===================== -->

    <Style x:Key="InfoButtonStyle" TargetType="Button">
        <Setter Property="Content" Value="?"/>
        <Setter Property="Width" Value="25"/>
        <Setter Property="MinHeight" Value="25"/>
        <Setter Property="Margin" Value="0,0,5,5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource ColorBackgroundControl}"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
    </Style>

    <Style x:Key="StandardButtonStyle" TargetType="Button">
        <Setter Property="Content" Value="?"/>
        <Setter Property="MinWidth" Value="25"/>
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinHeight" Value="25"/>
        <Setter Property="Margin" Value="0,0,5,5"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource ColorBackgroundControl}"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>

        <!-- WPF's default Button chrome ignores Background/Foreground entirely once IsEnabled=False,
             painting its own hardcoded light/white disabled look regardless of theme (the same class
             of bug DarkGroupBoxStyle fixes for GroupBox) - retemplate so the dark theme actually
             applies in every state, including disabled. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background"
                                Value="{StaticResource ColorBackgroundHighlight}"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background"
                                Value="{StaticResource ColorBackgroundPanel}"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background"
                                Value="{StaticResource ColorBackgroundControl}"/>
                            <Setter TargetName="border" Property="BorderBrush"
                                Value="{StaticResource ColorDivider}"/>
                            <Setter Property="Foreground"
                                Value="{StaticResource ColorTextMuted}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RemoveButtonStyle" TargetType="Button">
        <Setter Property="Content" Value="X"/>
        <Setter Property="Width" Value="25"/>
        <Setter Property="MinHeight" Value="25"/>
        <Setter Property="Margin" Value="0,0,5,5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource ColorDanger}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style x:Key="AddButtonStyle" TargetType="Button">
        <Setter Property="Content" Value="+"/>
        <Setter Property="Width" Value="25"/>
        <Setter Property="MinHeight" Value="25"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Margin" Value="0,0,5,5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource ColorSuccess}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Base template shared by ActionButtonStyle/ActionButtonWarmStyle — only the 3 accent
         resource keys differ between them (set via the resource names baked into each style below). -->
    <Style x:Key="ActionButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Margin" Value="6,0,0,5"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
        <Setter Property="Background" Value="{StaticResource ColorAccent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="MinHeight" Value="25"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background"
                                Value="{StaticResource ColorAccentLight}"/>
                        </Trigger>

                        <!-- Pressed -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background"
                                Value="{StaticResource ColorAccentSoft}"/>
                        </Trigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background"
                                Value="{StaticResource ColorBackgroundControl}"/>
                            <Setter Property="Foreground"
                                Value="{StaticResource ColorTextMuted}"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Same shape/behavior as ActionButtonStyle, green — used for the Scan/Rescan action. -->
    <Style x:Key="ActionButtonGreenStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
        <Setter Property="Background" Value="{StaticResource ColorAccentGreen}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background"
                                Value="{StaticResource ColorAccentGreenLight}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background"
                                Value="{StaticResource ColorAccentGreenSoft}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background"
                                Value="{StaticResource ColorBackgroundControl}"/>
                            <Setter Property="Foreground"
                                Value="{StaticResource ColorTextMuted}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Same shape/behavior as ActionButtonStyle, amber instead of blue — used for Import buttons so
         "this overwrites local edits" is visible before reading the label. -->
    <Style x:Key="ActionButtonWarmStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
        <Setter Property="Background" Value="{StaticResource ColorAccentWarm}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background"
                                Value="{StaticResource ColorAccentWarmLight}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background"
                                Value="{StaticResource ColorAccentWarmSoft}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background"
                                Value="{StaticResource ColorBackgroundControl}"/>
                            <Setter Property="Foreground"
                                Value="{StaticResource ColorTextMuted}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Nav tab buttons (MainWindow) - one accent (ColorAccent) marks only the active tab, so
         navigation doesn't compete with the views' semantic action colors (green/blue/amber).
         Active status comes via Tag="{Binding IsXActive}" per button. -->
    <Style x:Key="NavTabButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="150"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Background" Value="{StaticResource ColorBackgroundControl}"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextSecondary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background"
                                Value="{StaticResource ColorBackgroundHighlight}"/>
                        </Trigger>

                        <!-- Active tab (after Hover, so it takes precedence). DataTrigger instead of
                             Trigger: "Tag" is of type object, a normal Trigger would parse "True" as
                             a string and never match against the bound bool. -->
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                            <Setter TargetName="border" Property="Background"
                                Value="{StaticResource ColorAccent}"/>
                            <Setter Property="Foreground"
                                Value="{StaticResource ColorTextPrimary}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </DataTrigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bare ListBoxItem container without selection/hover chrome - for lists that only use ListBox
         for its built-in UI virtualization (VirtualizingStackPanel out of the box), but bring their
         own click/highlight logic via the DataTemplate (e.g. MultiSelectDetailView Keywords/Container). -->
    <Style x:Key="PlainListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Colors for the dark theme -->
    <SolidColorBrush x:Key="ScrollbarTrackBackground" Color="#1E1E1E" />
    <SolidColorBrush x:Key="ScrollbarThumbBackground" Color="#46464A" />
    <SolidColorBrush x:Key="ScrollbarThumbHover" Color="#5F5F63" />
    <SolidColorBrush x:Key="ArrowColor" Color="#999999" />

    <!-- Style for hiding the inner track click areas -->
    <Style x:Key="ScrollBarTrackButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="true"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="false"/>
        <Setter Property="IsTabStop" Value="false"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Fill="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style for the arrow buttons -->
    <Style x:Key="ScrollBarLineButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="true"/>
        <Setter Property="Focusable" Value="false"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{StaticResource ScrollbarTrackBackground}">
                        <TextBlock Text="{TemplateBinding Content}" 
                               Foreground="{StaticResource ArrowColor}" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               FontSize="9"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style for the scroll handle (Thumb) -->
    <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="true"/>
        <Setter Property="IsTabStop" Value="false"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="border" Background="Transparent">
                        <Rectangle x:Name="rectangle" Fill="{StaticResource ScrollbarThumbBackground}" RadiusX="2" RadiusY="2"/>
                    </Border>
                    <!-- Trigger for hover effect -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="rectangle" Property="Fill" Value="{StaticResource ScrollbarThumbHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The main style for all ScrollBars (switches layout based on orientation) -->
    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="true"/>
        <Setter Property="Background" Value="{StaticResource ScrollbarTrackBackground}"/>

        <!-- STANDARD: Vertikales Layout (Hochkant) -->
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition MaxHeight="18"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition MaxHeight="18"/>
                        </Grid.RowDefinitions>

                        <RepeatButton Grid.Row="0" Height="18" Style="{StaticResource ScrollBarLineButton}" Content="▲" Command="ScrollBar.LineUpCommand" />

                        <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="true">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarTrackButton}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <!-- Padding creates spacing left/right from the edge -->
                                <Thumb Style="{StaticResource ScrollBarThumbStyle}" Margin="3,0,3,0"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarTrackButton}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>

                        <RepeatButton Grid.Row="2" Height="18" Style="{StaticResource ScrollBarLineButton}" Content="▼" Command="ScrollBar.LineDownCommand" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <!-- TRIGGER: Wechselt zu Horizontalem Layout (Quer format) -->
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition MaxWidth="18"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition MaxWidth="18"/>
                                </Grid.ColumnDefinitions>

                                <!-- Linker Pfeil -->
                                <RepeatButton Grid.Column="0" Width="18" Style="{StaticResource ScrollBarLineButton}" Content="◀" Command="ScrollBar.LineLeftCommand" />

                                <Track x:Name="PART_Track" Grid.Column="1" IsDirectionReversed="false">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBarTrackButton}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <!-- Padding creates spacing top/bottom from the edge -->
                                        <Thumb Style="{StaticResource ScrollBarThumbStyle}" Margin="0,3,0,3"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBarTrackButton}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>

                                <!-- Rechter Pfeil -->
                                <RepeatButton Grid.Column="2" Width="18" Style="{StaticResource ScrollBarLineButton}" Content="▶" Command="ScrollBar.LineRightCommand" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- This additional style colors the white corner in the bottom-right of the ScrollViewer dark -->
    <Style TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid x:Name="Grid" Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}" CanHorizontallyScroll="False" CanVerticallyScroll="False" ContentTemplate="{TemplateBinding ContentTemplate}" Content="{TemplateBinding Content}" Grid.Column="0" Margin="{TemplateBinding Padding}" Grid.Row="0"/>

                        <ScrollBar x:Name="PART_VerticalScrollBar" AutomationProperties.AutomationId="VerticalScrollBar" Cursor="Arrow" Grid.Column="1" Maximum="{TemplateBinding ScrollableHeight}" Minimum="0" Grid.Row="0" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ScrollBar x:Name="PART_HorizontalScrollBar" AutomationProperties.AutomationId="HorizontalScrollBar" Cursor="Arrow" Grid.Column="0" Maximum="{TemplateBinding ScrollableWidth}" Minimum="0" Grid.Row="1" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" Orientation="Horizontal"/>

                        <!-- HERE the white corner square gets recolored -->
                        <Rectangle Grid.Column="1" Grid.Row="1" Fill="{StaticResource ScrollbarTrackBackground}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


</ResourceDictionary>