<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:model="clr-namespace:SkyrimCraftingTool.Model">

    <!-- Default text color for every TextBlock that does not set one itself.
         Without this they inherit UserControl's default, which is plain black - unreadable on the
         dark theme and, more to the point, not themed at all. There were 17 of them; this catches
         those and any future one, and an explicit Foreground still wins over it. -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
    </Style>

    <!-- ... and the exception the style above needs, for buttons.
         A Button with plain string content renders it through a TextBlock the ContentPresenter
         generates. The implicit style above SETS Foreground, and a style setter beats an inherited
         value - so it overrode the Button's own Foreground on every button in the app.
         The dark theme hid it: ColorTextPrimary is near-white there, so it happened to look right.
         In the light theme it is #1B1B1B on the #0F4C86 accent blue - measured at 1.97:1 contrast,
         where 4.5:1 is the readable minimum (green 4.06:1, warm 3.00:1).
         Each button template pulls this into its ContentPresenter's resources, where it outranks the
         app-wide implicit style without replacing it. Defined HERE, before the first button style,
         because StaticResource only sees what a dictionary declared above it. -->
    <Style x:Key="OnAccentTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    </Style>

    <!-- ===================== -->
    <!--      Controls         -->
    <!-- ===================== -->

    <!-- ===================== -->
    <!--      TEXTBLOCKS       -->
    <!-- ===================== -->

    <Style x:Key="ItemLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ColorTextSecondary}"/>
        <Setter Property="Margin" Value="0,0,5,5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style x:Key="TitelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="5,0,0,0"/>
    </Style>

    <Style x:Key="ToolTipTitelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="5,0,0,0"/>
    </Style>

    <Style x:Key="ToolTipTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ColorTextSecondary}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="5,0,0,0"/>
    </Style>

    <!-- ===================== -->
    <!--      TOOLTIP          -->
    <!-- ===================== -->
    
    <Style x:Key="InfoTooltipStyle" TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource ColorBackgroundBase}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10"/>
    </Style>

    <!-- THE SAME LOOK FOR THE OTHER 56 TOOLTIPS.
         InfoTooltipStyle above is keyed, so it only reaches the "?" buttons that build a full
         <ToolTip> element. Every plain ToolTip="some text" - and there are 56 of them - fell through
         to the Windows default instead: a pale system background under the dark theme's light text,
         which is exactly as readable as it sounds.
         Implicit (no x:Key), so it applies without touching a single call site. The rich tooltips are
         unaffected: all of them name InfoTooltipStyle explicitly, and an explicit style always wins
         over an implicit one.
         The ContentTemplate is what makes long text wrap rather than run off the screen; it is safe
         here precisely because this style only ever sees string content. -->
    <Style TargetType="ToolTip" BasedOn="{StaticResource InfoTooltipStyle}">
        <Setter Property="MaxWidth" Value="380"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource ColorTextPrimary}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== -->
    <!--      TEXTBOX          -->
    <!-- ===================== -->

    <Style x:Key="ItemTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource ColorBackgroundControl}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorder}"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Margin" Value="0,0,5,5"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style x:Key="ItemTextSearchBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource ColorBackgroundControl}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorder}"/>
        <Setter Property="Margin" Value="0,0,5,5"/>
        <Setter Property="FontSize" Value="11"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{DynamicResource ColorBackgroundControl}"
                        BorderBrush="{DynamicResource ColorBorder}"
                        BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="25"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Lupe -->
                            <Path Grid.Column="0"
                              Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 
                                    16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 
                                    3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 
                                    0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 
                                    11.99 14 9.5 14z"
                              Fill="{DynamicResource ColorTextPrimary}"
                              Stretch="Uniform"
                              Width="12" Height="12"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"/>

                            <!-- Inhalt -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                      Grid.Column="1"
                                      Margin="2,4,4,4"/>
                            <!-- WICHTIG -->
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== -->
    <!--      CHECKBOX         -->
    <!-- ===================== -->

    <!-- App-wide dark CheckBox. WPF's default glyph is a white SystemColors box that reads as a
         bright blob on the dark theme; this retemplates it (dark box, accent fill + tick when
         checked). Implicit (no key) so every CheckBox picks it up; the keyed styles below chain
         off it via BasedOn. -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource ColorBackgroundControl}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorder}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="6,0,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="box" Grid.Column="0"
                                Width="15" Height="15"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Path x:Name="check"
                                      Data="M 2.5,7 L 6,10.5 L 12,3"
                                      Stroke="{DynamicResource ColorTextPrimary}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Stretch="None"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="Collapsed"/>
                                <Rectangle x:Name="dash"
                                      Width="7" Height="2"
                                      Fill="{DynamicResource ColorTextPrimary}"
                                      Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <ContentPresenter Grid.Column="1"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource ColorAccent}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource ColorAccentLight}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="dash" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource ColorAccentSoft}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource ColorBorderLight}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource ColorTextMuted}"/>
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource ColorBackgroundPanel}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource ColorDivider}"/>
                            <Setter TargetName="check" Property="Stroke" Value="{DynamicResource ColorTextMuted}"/>
                        </Trigger>

                        <!-- "Differs from the scanned original", the check box's answer to the amber
                             border every text field carries. DELIBERATELY LAST: the IsChecked and
                             IsMouseOver triggers above both set box.BorderBrush, and among triggers
                             that touch the same property the last one declared wins. Anywhere
                             earlier and the marking would disappear the moment the box is ticked -
                             which is the usual way a flag comes to differ in the first place.
                             Thickness 2 as well, because a one-pixel outline against the filled
                             accent background of a ticked box is easy to miss. -->
                        <Trigger Property="model:ChangedMarker.IsChanged" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource ColorWarning}"/>
                            <Setter TargetName="box" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ItemCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>


    <!-- ===================== -->
    <!--      COMBOBOX         -->
    <!-- ===================== -->

    <Style x:Key="ItemComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource ColorBackgroundControl}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorder}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,5,5"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="IsEditable" Value="True"/>

        <!-- WPF's ComboBox hosts its items in a plain StackPanel - measured, and a ComboBox with no
             style at all does the same, so this is not something the template above broke. With
             3.875 magic effects that means 3.875 containers, ~1 s and ~50 MB the first time the list
             opens, and the containers stay alive after it closes.

             That is what makes "Add effect" stutter: ClearMagicEffectPicker and PersistEffectsAsync
             each raise FilteredMagicEffects, the property builds a fresh List on every read, and the
             ComboBox rebuilds all 3.874 containers - with the popup CLOSED. Measured at 214 ms and
             +22 MB per press; 7 ms when the picker had never been opened, which is what pins the
             cause here rather than on the save.

             All three parts are needed together. The panel alone still realises everything, because
             an unbounded popup means an unbounded viewport - the height cap is what makes it
             deterministic. Measured afterwards: 3 ms, no containers. -->
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel IsItemsHost="True" VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <!-- The outer border now encloses the search field together with the magnifying glass -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="25"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left area: magnifying glass + text field in one shared box -->
                        <!-- BorderBrush flows from the control so callers can highlight it
                             (edited-state amber, dead-reference red, ...). Default is ColorBorder
                             via the style Setter. -->
                        <Border Grid.Column="0"
                        Background="{DynamicResource ColorBackgroundControl}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1,1,0,1">
                            <!-- Right edge left open, since that's where the button docks -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- The magnifying glass now sits cleanly within the inner border -->
                                <Path Grid.Column="0" 
                                      Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" 
                                      Fill="{DynamicResource ColorTextPrimary}" 
                                      Stretch="Uniform" 
                                      Width="12" Height="12" 
                                      VerticalAlignment="Center" 
                                      HorizontalAlignment="Center"/>

                                <!-- The actual text field no longer has its own border -->
                                <TextBox x:Name="PART_EditableTextBox"
                                     Grid.Column="1"
                                     Background="Transparent"
                                     Foreground="{DynamicResource ColorTextPrimary}"
                                     BorderThickness="0"
                                     Padding="2,4,4,4"
                                     FontSize="11"
                                     VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Left"
                                     Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"/>
                            </Grid>
                        </Border>

                        <!-- Right area: dropdown button -->
                        <ToggleButton x:Name="ToggleButton"
                              Content="▼"
                              Grid.Column="1"
                              Background="{DynamicResource ColorBackgroundControl}"
                              Foreground="{DynamicResource ColorTextPrimary}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="1"
                              Focusable="False"
                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>

                        <Popup x:Name="Popup"
                           Placement="Bottom"
                           IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                           AllowsTransparency="True">
                            <Border Background="{DynamicResource ColorBackgroundControl}"
                                BorderBrush="{DynamicResource ColorBorder}"
                                BorderThickness="1">
                                <!-- CanContentScroll: without it the ScrollViewer scrolls by pixel, which turns
                                     virtualisation off again. MaxHeight: the stock ComboBox template binds
                                     MaxDropDownHeight, this one had dropped it. -->
                                <ScrollViewer CanContentScroll="True"
                                              MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    
                    
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

    <!-- Lean dark ComboBox WITHOUT the magnifier — for short pickers (stage index, small enum
         lists) where ItemComboBoxStyle's search-field chrome is overkill. Works editable and
         non-editable. -->
    <Style x:Key="CompactComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource ColorBackgroundControl}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <!-- See ItemComboBoxStyle. This one is meant for short lists, but it is also what the
             condition templates use, and nothing stops a long one being bound to it. -->
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel IsItemsHost="True" VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.ColumnSpan="2"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"/>

                        <ContentPresenter x:Name="ContentSite" Grid.Column="0"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          IsHitTestVisible="False"/>

                        <TextBox x:Name="PART_EditableTextBox" Grid.Column="0"
                                 Margin="{TemplateBinding Padding}"
                                 Background="Transparent"
                                 Foreground="{TemplateBinding Foreground}"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Center"
                                 Visibility="Hidden"
                                 Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"/>

                        <ToggleButton Grid.Column="1"
                                      Focusable="False"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Foreground="{TemplateBinding Foreground}"
                                      Content="▼" FontSize="8"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>

                        <Popup x:Name="Popup" Placement="Bottom" AllowsTransparency="True"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Background="{DynamicResource ColorBackgroundControl}"
                                    BorderBrush="{DynamicResource ColorBorder}"
                                    BorderThickness="1"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="220">
                                <!-- Same reason as ItemComboBoxStyle above. The Border already caps
                                     the height at 220, so only the panel and CanContentScroll are
                                     missing here. -->
                                <ScrollViewer CanContentScroll="True">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== -->
    <!--      Expander         -->
    <!-- ===================== -->

    <!-- The "something in here changed" marker for a COLLAPSED section. An expander that is shut
         hides the amber field borders inside it, so the header has to say it instead. Same dot and
         same colour the tree uses for an edited record, so it reads as one thing in both places.
         Callers bind only Visibility. -->
    <Style x:Key="ChangedDotStyle" TargetType="TextBlock">
        <Setter Property="Text" Value="  ●"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorWarning}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DarkExpanderStyle" TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource ColorBackgroundPanel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,5,10"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border 
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3">

                        <StackPanel>
                            <!-- HEADER -->
                            <!-- A bare ToggleButton (no OverridesDefaultStyle/Template of its own)
                                 keeps WPF's built-in chrome, which paints its own light "hot tracking"
                                 hover overlay on top of whatever Background we set — that's what was
                                 washing out the white header text on hover. Templating it fully here
                                 makes our own Background trigger below the only thing controlling how
                                 it looks. -->
                            <ToggleButton x:Name="HeaderSite"
                                      Content="{TemplateBinding Header}"
                                      FontWeight="Bold"
                                      Background="{DynamicResource ColorBackgroundHighlight}"
                                      Foreground="{DynamicResource ColorTextPrimary}"
                                      BorderThickness="0"
                                      Padding="8"
                                      HorizontalContentAlignment="Left"
                                      OverridesDefaultStyle="True"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- CONTENT -->
                            <ContentPresenter x:Name="ExpandSite"
                                          Visibility="Collapsed"
                                          Margin="10,8,10,10"
                                          Content="{TemplateBinding Content}"/>
                        </StackPanel>
                    </Border>

                    <!-- TRIGGERS -->
                    <ControlTemplate.Triggers>

                        <!-- Expand -->
                        <Trigger SourceName="HeaderSite" Property="IsChecked" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                        </Trigger>

                        <!-- Hover Effekt -->
                        <Trigger SourceName="HeaderSite" Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderSite" Property="Background" 
                                Value="{DynamicResource ColorBackgroundControl}"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== -->
    <!--      GroupBox         -->
    <!-- ===================== -->

    <!-- WPF's default GroupBox chrome draws its header-notch border with hardcoded
         SystemColors highlight/shadow brushes (a light bevel), ignoring BorderBrush
         entirely for those bevel lines. On this dark theme that shows up as a bright
         white line across the header no matter what BorderBrush is set to - this
         fully custom template replaces that chrome so every color comes from our
         own palette. -->
    <Style x:Key="DarkGroupBoxStyle" TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource ColorBackgroundPanel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <DockPanel>
                        <ContentPresenter DockPanel.Dock="Top"
                                          ContentSource="Header"
                                          Margin="0,0,0,6"/>
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



    <!-- ===================== -->
    <!--      BUTTONS          -->
    <!-- ===================== -->

    <Style x:Key="InfoButtonStyle" TargetType="Button">
        <Setter Property="Content" Value="?"/>
        <Setter Property="Width" Value="25"/>
        <Setter Property="MinHeight" Value="25"/>
        <Setter Property="Margin" Value="0,0,5,5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource ColorBackgroundControl}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorder}"/>
    </Style>

    <Style x:Key="StandardButtonStyle" TargetType="Button">
        <Setter Property="Content" Value="?"/>
        <Setter Property="MinWidth" Value="25"/>
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinHeight" Value="25"/>
        <Setter Property="Margin" Value="0,0,5,5"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource ColorBackgroundControl}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>

        <!-- WPF's default Button chrome ignores Background/Foreground entirely once IsEnabled=False,
             painting its own hardcoded light/white disabled look regardless of theme (the same class
             of bug DarkGroupBoxStyle fixes for GroupBox) - retemplate so the dark theme actually
             applies in every state, including disabled. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                            <!-- See OnAccentTextStyle: without this the implicit TextBlock style
                                 repaints the label and the button's own Foreground is ignored. -->
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource OnAccentTextStyle}"/>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background"
                                Value="{DynamicResource ColorBackgroundHighlight}"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background"
                                Value="{DynamicResource ColorBackgroundPanel}"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background"
                                Value="{DynamicResource ColorBackgroundControl}"/>
                            <Setter TargetName="border" Property="BorderBrush"
                                Value="{DynamicResource ColorDivider}"/>
                            <Setter Property="Foreground"
                                Value="{DynamicResource ColorTextMuted}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RemoveButtonStyle" TargetType="Button">
        <Setter Property="Content" Value="X"/>
        <Setter Property="Width" Value="25"/>
        <Setter Property="MinHeight" Value="25"/>
        <Setter Property="Margin" Value="0,0,5,5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorDanger}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style x:Key="AddButtonStyle" TargetType="Button">
        <Setter Property="Content" Value="+"/>
        <Setter Property="Width" Value="25"/>
        <Setter Property="MinHeight" Value="25"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Margin" Value="0,0,5,5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorSuccess}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Base template shared by ActionButtonStyle/ActionButtonWarmStyle — only the 3 accent
         resource keys differ between them (set via the resource names baked into each style below). -->
    <Style x:Key="ActionButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Margin" Value="6,0,0,5"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextOnAccent}"/>
        <Setter Property="Background" Value="{DynamicResource ColorAccent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="MinHeight" Value="25"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                            <!-- See OnAccentTextStyle: without this the implicit TextBlock style
                                 repaints the label and the button's own Foreground is ignored. -->
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource OnAccentTextStyle}"/>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background"
                                Value="{DynamicResource ColorAccentLight}"/>
                        </Trigger>

                        <!-- Pressed -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background"
                                Value="{DynamicResource ColorAccentSoft}"/>
                        </Trigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background"
                                Value="{DynamicResource ColorBackgroundControl}"/>
                            <Setter Property="Foreground"
                                Value="{DynamicResource ColorTextMuted}"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Same shape/behavior as ActionButtonStyle, green — used for the Scan/Rescan action. -->
    <Style x:Key="ActionButtonGreenStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource ColorAccentGreen}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                            <!-- See OnAccentTextStyle: without this the implicit TextBlock style
                                 repaints the label and the button's own Foreground is ignored. -->
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource OnAccentTextStyle}"/>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background"
                                Value="{DynamicResource ColorAccentGreenLight}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background"
                                Value="{DynamicResource ColorAccentGreenSoft}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background"
                                Value="{DynamicResource ColorBackgroundControl}"/>
                            <Setter Property="Foreground"
                                Value="{DynamicResource ColorTextMuted}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Same shape/behavior as ActionButtonStyle, amber instead of blue — used for Import buttons so
         "this overwrites local edits" is visible before reading the label. -->
    <Style x:Key="ActionButtonWarmStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource ColorAccentWarm}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                            <!-- See OnAccentTextStyle: without this the implicit TextBlock style
                                 repaints the label and the button's own Foreground is ignored. -->
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource OnAccentTextStyle}"/>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background"
                                Value="{DynamicResource ColorAccentWarmLight}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background"
                                Value="{DynamicResource ColorAccentWarmSoft}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background"
                                Value="{DynamicResource ColorBackgroundControl}"/>
                            <Setter Property="Foreground"
                                Value="{DynamicResource ColorTextMuted}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Nav tab buttons (MainWindow) - one accent (ColorAccent) marks only the active tab, so
         navigation doesn't compete with the views' semantic action colors (green/blue/amber).
         Active status comes via Tag="{Binding IsXActive}" per button. -->
    <Style x:Key="NavTabButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="150"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Background" Value="{DynamicResource ColorBackgroundControl}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextSecondary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                            <!-- See OnAccentTextStyle: without this the implicit TextBlock style
                                 repaints the label and the button's own Foreground is ignored. -->
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource OnAccentTextStyle}"/>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background"
                                Value="{DynamicResource ColorBackgroundHighlight}"/>
                        </Trigger>

                        <!-- Active tab (after Hover, so it takes precedence). DataTrigger instead of
                             Trigger: "Tag" is of type object, a normal Trigger would parse "True" as
                             a string and never match against the bound bool. -->
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                            <Setter TargetName="border" Property="Background"
                                Value="{DynamicResource ColorAccent}"/>
                            <Setter Property="Foreground"
                                Value="{DynamicResource ColorTextOnAccent}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </DataTrigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bare ListBoxItem container without selection/hover chrome - for lists that only use ListBox
         for its built-in UI virtualization (VirtualizingStackPanel out of the box), but bring their
         own click/highlight logic via the DataTemplate (e.g. MultiSelectDetailView Keywords/Container). -->
    <Style x:Key="PlainListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Colors for the dark theme -->

    <!-- Style for hiding the inner track click areas -->
    <Style x:Key="ScrollBarTrackButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="true"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="false"/>
        <Setter Property="IsTabStop" Value="false"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Fill="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style for the arrow buttons -->
    <Style x:Key="ScrollBarLineButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="true"/>
        <Setter Property="Focusable" Value="false"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{DynamicResource ColorScrollbarTrack}">
                        <TextBlock Text="{TemplateBinding Content}" 
                               Foreground="{DynamicResource ColorScrollbarArrow}" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               FontSize="9"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style for the scroll handle (Thumb) -->
    <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="true"/>
        <Setter Property="IsTabStop" Value="false"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="border" Background="Transparent">
                        <Rectangle x:Name="rectangle" Fill="{DynamicResource ColorScrollbarThumb}" RadiusX="2" RadiusY="2"/>
                    </Border>
                    <!-- Trigger for hover effect -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="rectangle" Property="Fill" Value="{DynamicResource ColorScrollbarThumbHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The main style for all ScrollBars (switches layout based on orientation) -->
    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="true"/>
        <Setter Property="Background" Value="{DynamicResource ColorScrollbarTrack}"/>

        <!-- STANDARD: Vertikales Layout (Hochkant) -->
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition MaxHeight="18"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition MaxHeight="18"/>
                        </Grid.RowDefinitions>

                        <RepeatButton Grid.Row="0" Height="18" Style="{StaticResource ScrollBarLineButton}" Content="▲" Command="ScrollBar.LineUpCommand" />

                        <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="true">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarTrackButton}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <!-- Padding creates spacing left/right from the edge -->
                                <Thumb Style="{StaticResource ScrollBarThumbStyle}" Margin="3,0,3,0"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarTrackButton}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>

                        <RepeatButton Grid.Row="2" Height="18" Style="{StaticResource ScrollBarLineButton}" Content="▼" Command="ScrollBar.LineDownCommand" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <!-- TRIGGER: Wechselt zu Horizontalem Layout (Quer format) -->
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition MaxWidth="18"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition MaxWidth="18"/>
                                </Grid.ColumnDefinitions>

                                <!-- Linker Pfeil -->
                                <RepeatButton Grid.Column="0" Width="18" Style="{StaticResource ScrollBarLineButton}" Content="◀" Command="ScrollBar.LineLeftCommand" />

                                <Track x:Name="PART_Track" Grid.Column="1" IsDirectionReversed="false">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBarTrackButton}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <!-- Padding creates spacing top/bottom from the edge -->
                                        <Thumb Style="{StaticResource ScrollBarThumbStyle}" Margin="0,3,0,3"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBarTrackButton}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>

                                <!-- Rechter Pfeil -->
                                <RepeatButton Grid.Column="2" Width="18" Style="{StaticResource ScrollBarLineButton}" Content="▶" Command="ScrollBar.LineRightCommand" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== -->
    <!--      DATAGRID        -->
    <!-- ===================== -->

    <!-- WPF's stock DataGrid chrome is all SystemColors: light-grey column headers with a white
         bevel, a bright-blue cell/row selection, white gridlines. None of it honours the dark
         palette (same class of problem as DarkGroupBoxStyle). These four styles retemplate the
         pieces so the grid matches the rest of the app. DarkDataGridStyle wires the other three
         in via ColumnHeaderStyle/RowStyle/CellStyle, so a view only needs the one key. -->

    <!-- Transparent drag handle on each side of a column header - the DataGrid drives column
         resizing off Thumbs named exactly PART_LeftHeaderGripper / PART_RightHeaderGripper, so a
         retemplated header must keep them or resizing dies. -->
    <Style x:Key="DataGridColumnHeaderGripperStyle" TargetType="Thumb">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="SizeWE"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource ColorBackgroundHighlight}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorder}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <Thumb x:Name="PART_LeftHeaderGripper"
                               HorizontalAlignment="Left"
                               Style="{StaticResource DataGridColumnHeaderGripperStyle}"/>
                        <Thumb x:Name="PART_RightHeaderGripper"
                               HorizontalAlignment="Right"
                               Style="{StaticResource DataGridColumnHeaderGripperStyle}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkDataGridCellStyle" TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Selection colour lives on the cell (drawn above the row), so it wins over the
                 row's softer highlight and stays readable with SelectionUnit=FullRow. -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource ColorAccent}"/>
                <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DarkDataGridRowStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="{DynamicResource ColorBackgroundPanel}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ColorBackgroundControl}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource ColorSurfaceInfo}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DarkDataGridStyle" TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource ColorBackgroundPanel}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowBackground" Value="{DynamicResource ColorBackgroundPanel}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource ColorBackgroundBase}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ColorDivider}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource ColorDivider}"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="MinColumnWidth" Value="60"/>
        <Setter Property="RowHeight" Value="28"/>
        <Setter Property="ColumnHeaderHeight" Value="30"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource DarkDataGridColumnHeaderStyle}"/>
        <Setter Property="RowStyle" Value="{StaticResource DarkDataGridRowStyle}"/>
        <Setter Property="CellStyle" Value="{StaticResource DarkDataGridCellStyle}"/>
    </Style>

    <!-- Centre the tick in a DataGridCheckBoxColumn (default is a tiny left-aligned box). -->
    <Style x:Key="DataGridCheckBoxCellStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- This additional style colors the white corner in the bottom-right of the ScrollViewer dark -->
    <Style TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid x:Name="Grid" Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}" CanHorizontallyScroll="False" CanVerticallyScroll="False" ContentTemplate="{TemplateBinding ContentTemplate}" Content="{TemplateBinding Content}" Grid.Column="0" Margin="{TemplateBinding Padding}" Grid.Row="0"/>

                        <ScrollBar x:Name="PART_VerticalScrollBar" AutomationProperties.AutomationId="VerticalScrollBar" Cursor="Arrow" Grid.Column="1" Maximum="{TemplateBinding ScrollableHeight}" Minimum="0" Grid.Row="0" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ScrollBar x:Name="PART_HorizontalScrollBar" AutomationProperties.AutomationId="HorizontalScrollBar" Cursor="Arrow" Grid.Column="0" Maximum="{TemplateBinding ScrollableWidth}" Minimum="0" Grid.Row="1" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" Orientation="Horizontal"/>

                        <!-- HERE the white corner square gets recolored -->
                        <Rectangle Grid.Column="1" Grid.Row="1" Fill="{DynamicResource ColorScrollbarTrack}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


</ResourceDictionary>
