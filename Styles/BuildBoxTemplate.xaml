<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:SkyrimCraftingTool.ViewModel">

    <!-- The build box (BuildBoxVM): one template for the item, the multi-selection and the plugin
         view, so the three cannot drift apart. The slot row only exists on a single item. -->

    <DataTemplate x:Key="BuildPickRowTemplate" DataType="{x:Type local:PickRowVM}">
        <DockPanel Margin="0,0,0,3">
            <Button DockPanel.Dock="Right" Content="✕" Width="26" Margin="4,0,0,0"
                    Command="{Binding RemoveCommand}" Style="{StaticResource StandardButtonStyle}" ToolTip="Remove"/>
            <!-- Why the pre-fill picked it: "keyword" or "name: gold*". -->
            <TextBlock DockPanel.Dock="Right" Text="{Binding Hint, Mode=OneWay}" Margin="6,0,0,0"
                       Foreground="{DynamicResource ColorTextTertiary}" FontSize="11" VerticalAlignment="Center"
                       Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}"/>
            <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}"
                      Style="{StaticResource ItemComboBoxStyle}"/>
        </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:BuildBoxVM}">
        <GroupBox Style="{StaticResource DarkGroupBoxStyle}" Padding="10" Margin="0,0,0,12">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Build" Style="{StaticResource TitelStyle}"/>
                    <TextBlock Text="  type · material · slots · addons · extras"
                               Foreground="{DynamicResource ColorTextTertiary}" VerticalAlignment="Center"/>
                </StackPanel>
            </GroupBox.Header>

            <StackPanel>
                <!-- No building blocks yet: say where they come from, nothing else. -->
                <TextBlock Text="{Binding CatalogProblem, Mode=OneWay}" Foreground="{DynamicResource ColorWarning}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasCatalogProblem, Converter={StaticResource BoolToVis}}"/>

                <StackPanel Visibility="{Binding HasCatalog, Converter={StaticResource BoolToVis}}">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Type:" Style="{StaticResource ItemLabelStyle}" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding TypeChoices}" SelectedItem="{Binding SelectedType}"
                                  Style="{StaticResource ItemComboBoxStyle}"/>
                        <TextBlock Grid.Column="3" Text="Material:" Style="{StaticResource ItemLabelStyle}" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="4" ItemsSource="{Binding MaterialChoices}" SelectedItem="{Binding SelectedMaterial}"
                                  Style="{StaticResource ItemComboBoxStyle}"/>
                    </Grid>

                    <!-- Slots: single item only. -->
                    <StackPanel Visibility="{Binding IsSingle, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                        <DockPanel>
                            <TextBlock Text="Slots:" Style="{StaticResource ItemLabelStyle}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding SlotSummary, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                        <Expander Style="{StaticResource DarkExpanderStyle}" Header="Change slot definitions" IsExpanded="False" Margin="0,4,0,0">
                            <ItemsControl ItemsSource="{Binding SlotChoices}" Margin="0,6,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:NameChoiceVM}">
                                        <CheckBox Content="{Binding Name, Mode=OneWay}" IsChecked="{Binding IsChecked}"
                                                  Foreground="{DynamicResource ColorTextPrimary}" Margin="0,2,14,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </StackPanel>
                    <TextBlock Text="Slots come from each item - they cannot be set for several items at once."
                               Foreground="{DynamicResource ColorTextTertiary}" FontSize="11" Margin="0,0,0,8"
                               Visibility="{Binding IsMulti, Converter={StaticResource BoolToVis}}"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Content="+ Addon" Command="{Binding AddAddonCommand}"
                                        IsEnabled="{Binding CanAddAddon}" Style="{StaticResource StandardButtonStyle}"/>
                                <TextBlock Text="Addons" Style="{StaticResource ItemLabelStyle}"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Addons}" ItemTemplate="{StaticResource BuildPickRowTemplate}"/>
                            <TextBlock Text="On several items: added to each item's detected addons."
                                       Foreground="{DynamicResource ColorTextTertiary}" FontSize="11"
                                       Visibility="{Binding IsMulti, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <DockPanel Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Content="+ Extra" Command="{Binding AddExtraCommand}"
                                        IsEnabled="{Binding CanAddExtra}" Style="{StaticResource StandardButtonStyle}"/>
                                <TextBlock Text="Extras (enchantment, leveled lists)" Style="{StaticResource ItemLabelStyle}"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Extras}" ItemTemplate="{StaticResource BuildPickRowTemplate}"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource ColorBackgroundControl}" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                        <TextBlock Text="{Binding Preview, Mode=OneWay}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ColorTextSecondary}"/>
                    </Border>

                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Apply" Width="100"
                                Command="{Binding ApplyCommand}" Style="{StaticResource ActionButtonGreenStyle}"/>
                        <TextBlock Text="{Binding Status, Mode=OneWay}" Foreground="{DynamicResource ColorTextSecondary}"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                </StackPanel>
            </StackPanel>
        </GroupBox>
    </DataTemplate>
</ResourceDictionary>
