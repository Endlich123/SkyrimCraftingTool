<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:model="clr-namespace:SkyrimCraftingTool.Model">

    <!-- Value converters, moved out of App.xaml so that dictionaries merged after this one can use
         them. A merged dictionary is parsed where it is merged, and App.xaml's own entries come
         after its MergedDictionaries block - so a StaticResource reference from inside another
         dictionary could never see a converter declared there. Styles/ConditionTemplates.xaml needs
         BoolToDeadRefBorderConverter, which is what forced the split. -->

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <model:SlotMaskToTextConverter x:Key="SlotMaskConverter"/>
    <model:BoolToSelectTextConverter x:Key="BoolToSelectTextConverter"/>
    <model:BoolToExpertTextConverter x:Key="BoolToExpertTextConverter"/>

    <!-- These three hand a Brush to a binding, which a palette swap cannot reach. They take their
         brushes from ThemeService.LiveBrush in their own defaults - deliberately not configured
         here, so there is exactly one place that decides which token a chip or a border uses. -->
    <model:BoolToBrushConverter x:Key="BoolToBrushConverter"/>
    <model:BoolToChangedBorderConverter x:Key="BoolToChangedBorderConverter"/>
    <model:BoolToDeadRefBorderConverter x:Key="BoolToDeadRefBorderConverter"/>

</ResourceDictionary>
