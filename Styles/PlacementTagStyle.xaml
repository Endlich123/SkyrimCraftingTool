<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- "This row is not in the game yet - your patch puts it there."
         Two words, two colours, two tooltips, and all six were written twice: once in the
         leveled-list window's contents and once in the Container/LeveledList tab's. Which is how a
         vocabulary drifts - the two are read minutes apart, by someone deciding whether a row is
         theirs or the load order's.

         "+ readded" is deliberately not "+ new": the entry WAS in the list until an override took it
         out, and calling that new would be a small lie to read back months later. Amber for
         something you added, the History's yellow for something you put back, so a row and the loss
         it came from read as one thing.

         Applies to anything that answers IsPlanned and IsRestored - LeveledListEntryInfo in the
         window, OwnedOccurrenceVM in the tab. That is the whole contract; the Visibility is part of
         it because a tag with no text is still a gap in a row. -->
    <Style x:Key="PlacementTagStyle" TargetType="TextBlock">
        <Setter Property="Text" Value="+ new"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorWarning}"/>
        <Setter Property="ToolTip" Value="Planned by you - the patch will add this entry."/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Visibility" Value="{Binding IsPlanned, Converter={StaticResource BoolToVis}}"/>

        <Style.Triggers>
            <DataTrigger Binding="{Binding IsRestored}" Value="True">
                <Setter Property="Text" Value="+ readded"/>
                <Setter Property="Foreground" Value="#D8B84A"/>
                <Setter Property="ToolTip" Value="Put back by you after an override dropped it - the patch will add it again."/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
